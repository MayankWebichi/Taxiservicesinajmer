---
import { business } from "@/data/business";
import { createWhatsAppBookingUrl } from "@/utils/whatsapp";

const whatsappUrl = createWhatsAppBookingUrl();
---

<section class="why-us-section" id="why-us" aria-label="Why Choose Taxi Services in Ajmer">
  <div class="container">
    <div class="why-grid">
      <div class="why-content">
        <span class="section-subtitle">Since 2008 in Ajmer</span>
        <h2 class="section-title">Why Travelers Trust Our Taxi Service Over Aggregators</h2>
        <p class="section-desc">
          When you book an outstation trip or local pilgrimage cab in Ajmer, you need a dependable local operator who guarantees a clean vehicle and an experienced chauffeur—not an anonymous algorithm that cancels at the last minute.
        </p>

        <div class="features-list">
          <div class="feature-item">
            <div class="feature-icon-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div class="feature-text">
              <h3>Guaranteed On-Time Pickups</h3>
              <p>We arrive 15 minutes ahead of schedule for railway station and airport departures. No driver cancellations.</p>
            </div>
          </div>

          <div class="feature-item">
            <div class="feature-icon-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <div class="feature-text">
              <h3>Direct Operator Pricing</h3>
              <p>No 25% middleman commission. Transparent per-km rates from ₹10/km and verified fixed route fares with zero hidden surcharges.</p>
            </div>
          </div>

          <div class="feature-item">
            <div class="feature-icon-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div class="feature-text">
              <h3>Polite, Route-Savvy Chauffeurs</h3>
              <p>Our drivers are verified Rajasthan locals who know the fastest highway shortcuts, bypasses, and authentic dhaba stops.</p>
            </div>
          </div>

          <div class="feature-item">
            <div class="feature-icon-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div class="feature-text">
              <h3>Zero Advance Booking</h3>
              <p>Book your taxi seamlessly via WhatsApp without paying advance token money. Pay after completing your journey.</p>
            </div>
          </div>
        </div>

        <div class="why-cta-row">
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn--gold btn--lg">
            Chat on WhatsApp
          </a>
          <a href={`tel:${business.phone}`} class="btn btn--outline-primary btn--lg">
            Call: {business.phoneFormatted}
          </a>
        </div>
      </div>

      <div class="why-card-wrapper">
        <div class="heritage-showcase-card">
          <div class="showcase-header">
            <img src="/images/logo-seal.png" alt="Taxi Services in Ajmer Crest" width="120" height="120" class="seal-crest" />
            <div class="crest-meta">
              <span class="crest-est">ESTABLISHED 2008</span>
              <h3 class="crest-name">Taxi Services in Ajmer</h3>
              <span class="crest-city">Ajmer &amp; Pushkar, Rajasthan</span>
            </div>
          </div>

          <div class="heritage-pillars">
            <div class="pillar">
              <span class="pillar-num">18+</span>
              <span class="pillar-txt">Years of Uninterrupted Service in Ajmer &amp; Pushkar</span>
            </div>
            <div class="pillar">
              <span class="pillar-num">7+</span>
              <span class="pillar-txt">Fleet Options: Glanza, Dzire, Etios, Ertiga, Innova, Crysta, Tempo</span>
            </div>
            <div class="pillar">
              <span class="pillar-num">100%</span>
              <span class="pillar-txt">Commercial Yellow Plate Taxis with All-India Permits</span>
            </div>
          </div>

          <div class="heritage-contact-box">
            <div class="h-contact-line">
              <span class="h-icon">📍</span>
              <div>
                <strong>Service Coverage:</strong>
                <span>24/7 Doorstep Pickup Across Ajmer, Pushkar &amp; Rajasthan</span>
              </div>
            </div>
            <div class="h-contact-line">
              <span class="h-icon">📞</span>
              <div>
                <strong>Direct Phone:</strong>
                <a href={`tel:${business.phone}`}>{business.phoneFormatted}</a>
              </div>
            </div>
            <div class="h-contact-line">
              <span class="h-icon">✉</span>
              <div>
                <strong>Email:</strong>
                <a href={`mailto:${business.email}`}>{business.email}</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .why-us-section {
    padding: var(--space-4xl) 0;
    background: var(--color-surface);
  }

  .why-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-3xl);
    align-items: center;
  }

  .features-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin: var(--space-2xl) 0;
  }

  .feature-item {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .feature-icon-box {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--color-cream);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .feature-icon-box svg {
    width: 22px;
    height: 22px;
  }

  .feature-text h3 {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    color: var(--color-primary);
    margin-bottom: 4px;
  }

  .feature-text p {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .why-cta-row {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .heritage-showcase-card {
    background: linear-gradient(145deg, #FFFFFF 0%, var(--color-cream) 100%);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 24px 20px;
    box-shadow: 0 12px 32px rgba(34, 24, 28, 0.08);
  }

  .showcase-header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-bottom: var(--space-md);
    border-bottom: 2px solid var(--color-border);
    margin-bottom: var(--space-md);
  }

  .seal-crest {
    width: 110px;
    height: 110px;
    object-fit: contain;
    flex-shrink: 0;
    filter: drop-shadow(0 4px 12px rgba(90, 12, 26, 0.15));
  }

  .crest-est {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    display: block;
  }

  .crest-name {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    color: var(--color-primary);
    margin: 2px 0;
  }

  .crest-city {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .heritage-pillars {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: var(--space-md);
  }

  .pillar {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    background: #FFFFFF;
    padding: 10px 14px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .pillar-num {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-primary);
    min-width: 50px;
  }

  .pillar-txt {
    font-size: 0.84375rem;
    color: var(--color-text);
    font-weight: 500;
  }

  .heritage-contact-box {
    background: linear-gradient(135deg, #4A0815 0%, #2D050D 100%);
    color: #FFFFFF;
    padding: 16px 18px;
    border-radius: var(--radius-md);
    border: 1.5px solid rgba(197, 155, 39, 0.4);
    box-shadow: 0 6px 18px rgba(45, 5, 13, 0.25);
    font-size: 0.8125rem;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .h-contact-line {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    line-height: 1.45;
  }

  .h-icon {
    font-size: 1rem;
    flex-shrink: 0;
    line-height: 1.3;
  }

  .h-contact-line strong {
    color: #FAD66D;
    font-weight: 700;
    display: inline;
    margin-right: 4px;
  }

  .h-contact-line a {
    color: #FFFFFF;
    text-decoration: underline;
    font-weight: 600;
  }

  .h-contact-line a:hover {
    color: #FAD66D;
  }

  @media (max-width: 600px) {
    .heritage-showcase-card {
      padding: 18px 14px;
    }
    .seal-crest {
      width: 92px;
      height: 92px;
    }
  }

  @media (max-width: 992px) {
    .why-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
