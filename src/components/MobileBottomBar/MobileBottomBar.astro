---
import { business } from "@/data/business";
import { createWhatsAppBookingUrl } from "@/utils/whatsapp";

const whatsappUrl = createWhatsAppBookingUrl();
---

<nav class="mobile-action-bar" id="mobile-action-bar" aria-label="Quick mobile booking actions">
  <div class="mobile-bar-inner">
    <a
      href={`tel:${business.phone}`}
      class="mobile-bar-btn mobile-bar-btn--call"
      id="mobile-bottom-call-btn"
      aria-label="Call Taxi Services in Ajmer"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
      </svg>
      <span>Call Directly</span>
    </a>

    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mobile-bar-btn mobile-bar-btn--wa"
      id="mobile-bottom-wa-btn"
      aria-label="Book on WhatsApp"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.288.043.088.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.2.662.589 1.221.77 1.394.856.173.086.275.073.376-.044.101-.116.433-.506.549-.68.116-.174.231-.145.39-.087s1.011.477 1.184.564.289.13.332.203c.043.072.043.419-.101.824z"/>
      </svg>
      <span>WhatsApp Booking</span>
    </a>
  </div>
</nav>

<style>
  /* Hidden on Desktop & Tablet (> 768px) */
  .mobile-action-bar {
    display: none;
  }

  @media (max-width: 768px) {
    .mobile-action-bar {
      display: block;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 950;
      background: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-top: 1px solid rgba(197, 155, 39, 0.35);
      padding: 8px 12px calc(8px + env(safe-area-inset-bottom, 0px));
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.1);
    }

    .mobile-bar-inner {
      display: flex;
      gap: 10px;
      max-width: 480px;
      margin: 0 auto;
    }

    .mobile-bar-btn {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      height: 46px;
      border-radius: var(--radius-md, 12px);
      font-size: 0.9rem;
      font-weight: 700;
      text-decoration: none;
      transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.18s ease;
      touch-action: manipulation;
    }

    .mobile-bar-btn:active {
      transform: scale(0.97);
    }

    .mobile-bar-btn--call {
      background: #FFFFFF;
      color: var(--color-primary, #5A0C1A);
      border: 1.5px solid var(--color-primary, #5A0C1A);
    }

    .mobile-bar-btn--wa {
      background: #25D366;
      color: #FFFFFF;
      border: 1.5px solid #25D366;
      box-shadow: 0 4px 12px rgba(37, 211, 102, 0.35);
    }
  }
</style>
