---
import type { Vehicle } from "@/data/vehicles";
import { createWhatsAppBookingUrl } from "@/utils/whatsapp";
import { business } from "@/data/business";

export interface Props {
  vehicle: Vehicle;
}

const { vehicle } = Astro.props;
const whatsappUrl = createWhatsAppBookingUrl({ vehicle: vehicle.name });
---

<article class="vehicle-card" id={`vehicle-${vehicle.id}`}>
  <div class="card-media">
    <span class="category-tag">{vehicle.categoryLabel}</span>
    {vehicle.popular && <span class="popular-badge">★ Most Popular</span>}
    <img 
      src={vehicle.image} 
      alt={vehicle.altText} 
      class="vehicle-img" 
      loading="lazy" 
      width="300" 
      height="180" 
    />
  </div>

  <div class="card-body">
    <div class="title-pricing-row">
      <h3 class="vehicle-title">{vehicle.name}</h3>
      <div class="rate-badge">
        <span class="rate-from">From</span>
        <span class="rate-val">₹{vehicle.ratePerKm}</span>
        <span class="rate-unit">/km</span>
      </div>
    </div>

    <p class="vehicle-best-for">{vehicle.bestFor}</p>

    <!-- Specifications Bar -->
    <div class="specs-grid" role="list">
      <div class="spec-chip" title="Passenger Seating Capacity" role="listitem">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <span>{vehicle.seats} Seats</span>
      </div>
      <div class="spec-chip" title="Luggage Space" role="listitem">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
        <span>{vehicle.luggage} Bags</span>
      </div>
      <div class="spec-chip" title="Air Conditioning" role="listitem">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        <span>{vehicle.hasAC ? "AC Cab" : "Non-AC"}</span>
      </div>
      <div class="spec-chip" title="Cancellation Policy" role="listitem">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <span>Free Cancel</span>
      </div>
    </div>

    <!-- Fixed Route / Feature Highlight Boxes -->
    {vehicle.fixedFares?.ajmerToPushkar && (
      <div class="fixed-route-banner">
        <span class="route-point">Ajmer ➔ Pushkar:</span>
        <strong class="route-price">₹{vehicle.fixedFares.ajmerToPushkar.toLocaleString("en-IN")}</strong>
        <span class="route-toll">(One-Way drop)</span>
      </div>
    )}
    {vehicle.fixedFares?.ajmerToJaipur && (
      <div class="fixed-route-banner">
        <span class="route-point">Ajmer ➔ Jaipur:</span>
        <strong class="route-price">₹{vehicle.fixedFares.ajmerToJaipur.toLocaleString("en-IN")}</strong>
        <span class="route-toll">(One-Way fixed)</span>
      </div>
    )}
    {vehicle.featureBoxes && vehicle.featureBoxes.map((box) => (
      <div class:list={["fixed-route-banner", { "luxury-banner": box.isLuxury }]}>
        <span class="route-point">{box.point}</span>
        <strong class="route-price">{box.price}</strong>
        {box.toll && <span class="route-toll">{box.toll}</span>}
      </div>
    ))}

    <!-- Actions -->
    <div class="card-actions">
      <a 
        href={whatsappUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn btn--primary btn--sm btn-pressable action-btn"
        aria-label={`Book ${vehicle.name} on WhatsApp`}
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.288.043.088.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.2.662.589 1.221.77 1.394.856.173.086.275.073.376-.044.101-.116.433-.506.549-.68.116-.174.231-.145.39-.087s1.011.477 1.184.564.289.13.332.203c.043.072.043.419-.101.824z"/></svg>
        Book on WhatsApp
      </a>
      <a 
        href={`tel:${business.phone}`} 
        class="btn btn--outline-primary btn--sm btn-pressable action-call"
        aria-label={`Call to book ${vehicle.name}`}
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
        Call
      </a>
    </div>
  </div>
</article>

<style>
  .vehicle-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 16px rgba(34, 24, 28, 0.06);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .vehicle-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 28px rgba(34, 24, 28, 0.12);
    border-color: var(--color-accent);
  }

  .card-media {
    position: relative;
    background: var(--color-cream);
    padding: var(--space-md);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 190px;
    border-bottom: 1px solid var(--color-border);
  }

  .vehicle-img {
    width: 100%;
    max-width: 260px;
    height: auto;
    object-fit: contain;
    transition: transform var(--transition-base);
  }

  .vehicle-card:hover .vehicle-img {
    transform: scale(1.03);
  }

  .category-tag {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .popular-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: var(--color-accent);
    color: #FFFFFF;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
  }

  .card-body {
    padding: var(--space-md) var(--space-lg) var(--space-lg);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .title-pricing-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 6px;
  }

  .vehicle-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--color-primary);
    font-weight: 700;
  }

  .rate-badge {
    display: flex;
    align-items: baseline;
    gap: 2px;
  }

  .rate-from {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .rate-val {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-primary);
    font-family: var(--font-heading);
  }

  .rate-unit {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .vehicle-best-for {
    font-size: 0.84375rem;
    color: var(--color-text-muted);
    line-height: 1.45;
    margin-bottom: var(--space-md);
    min-height: 2.9em;
  }

  .specs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
    margin-bottom: var(--space-md);
    padding: 8px;
    background: var(--color-cream);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .spec-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78125rem;
    color: var(--color-text);
    font-weight: 500;
  }

  .spec-chip svg {
    width: 14px;
    height: 14px;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .fixed-route-banner {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(197, 155, 39, 0.12);
    border: 1px solid rgba(197, 155, 39, 0.35);
    border-radius: var(--radius-sm);
    padding: 6px 10px;
    font-size: 0.8125rem;
    color: var(--color-primary);
    margin-bottom: 6px;
    min-height: 32px;
  }

  .fixed-route-banner:last-of-type {
    margin-bottom: var(--space-md);
  }

  .fixed-route-banner.luxury-banner {
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.18) 0%, rgba(139, 21, 56, 0.05) 100%);
    border: 1px solid rgba(212, 175, 55, 0.5);
    box-shadow: 0 1px 4px rgba(212, 175, 55, 0.08);
  }

  .luxury-banner .route-point {
    color: var(--color-accent);
    font-weight: 700;
  }

  .luxury-banner .route-price {
    color: var(--color-primary);
    font-weight: 700;
  }

  .route-price {
    font-weight: 700;
  }

  .route-toll {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-left: auto;
    white-space: nowrap;
  }

  .card-actions {
    display: flex;
    gap: 8px;
    margin-top: auto;
  }

  .action-btn {
    flex: 1;
    justify-content: center;
  }

  .action-call {
    padding: 8px 12px;
  }
</style>
