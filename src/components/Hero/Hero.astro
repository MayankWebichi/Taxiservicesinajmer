      fareErtiga = cityB.fixedErtiga;
    } else if (cityB.name === "Ajmer" && cityA.fixedErtiga) {
      fareErtiga = cityA.fixedErtiga;
    } else {
      fareErtiga = Math.max(1800, distance * 13);
    }
    if (isRound && !isLocal) fareErtiga = Math.round(fareErtiga * 1.8);

    // Vehicle 3: Crysta
    let fareCrysta = 1500;
    if (isLocal) {
      fareCrysta = 3800;
    } else if (cityA.name === "Ajmer" && cityB.fixedCrysta) {
      fareCrysta = cityB.fixedCrysta;
    } else if (cityB.name === "Ajmer" && cityA.fixedCrysta) {
      fareCrysta = cityA.fixedCrysta;
    } else {
      fareCrysta = Math.max(2400, distance * 18);
    }
    if (isRound && !isLocal) fareCrysta = Math.round(fareCrysta * 1.8);

    // Vehicle 4: 13 Seater Maharaja Urbania
    let fareUrbania = 3500;
    if (isLocal) {
      fareUrbania = 5500;
    } else {
      fareUrbania = Math.max(3500, distance * 35);
    }
    if (isRound && !isLocal) fareUrbania = Math.round(fareUrbania * 1.8);

    const typeLabel = isLocal ? "8Hr Package" : (isRound ? "Round Trip" : "Fixed Drop");

    // Populate DOM
    if (priceSedan) priceSedan.textContent = fareSedan.toLocaleString("en-IN");
    if (mrpSedan) mrpSedan.textContent = `₹${Math.round(fareSedan * 1.35).toLocaleString("en-IN")}`;
    if (typeSedan) typeSedan.textContent = typeLabel;

    if (priceErtiga) priceErtiga.textContent = fareErtiga.toLocaleString("en-IN");
    if (mrpErtiga) mrpErtiga.textContent = `₹${Math.round(fareErtiga * 1.35).toLocaleString("en-IN")}`;
    if (typeErtiga) typeErtiga.textContent = typeLabel;

    if (priceCrysta) priceCrysta.textContent = fareCrysta.toLocaleString("en-IN");
    if (mrpCrysta) mrpCrysta.textContent = `₹${Math.round(fareCrysta * 1.35).toLocaleString("en-IN")}`;
    if (typeCrysta) typeCrysta.textContent = typeLabel;

    if (priceUrbania) priceUrbania.textContent = fareUrbania.toLocaleString("en-IN");
    if (mrpUrbania) mrpUrbania.textContent = `₹${Math.round(fareUrbania * 1.35).toLocaleString("en-IN")}`;
    if (typeUrbania) typeUrbania.textContent = isLocal ? "8Hr Package" : (isRound ? "Round Trip" : "Direct Rate");

    // Update WhatsApp links
    const cleanPhone = (businessPhone || "917737314538").replace(/[^0-9]/g, "");
    const dateText = travelDate?.value || "Today";
    const timeText = travelTime?.value || "Morning (09:00 AM)";
    const tripName = isLocal ? "Local 8Hr/80Km Tour" : (isRound ? "Round Trip Outstation" : "One-Way Drop");

    function buildWaLink(vehName, quotedFare) {
      const msg = 
`*New Cab Booking Request — Taxi Services in Ajmer*
--------------------------------
• *Trip Mode:* ${tripName}
• *Pickup:* ${originVal}
• *Destination:* ${isLocal ? "Ajmer & Pushkar Local Darshan" : destVal}
• *Estimated Distance:* ${distance} KM
• *Travel Date:* ${dateText} (${timeText})
• *Selected Vehicle:* ${vehName}
• *Estimated Direct Rate:* ₹${quotedFare.toLocaleString("en-IN")}
--------------------------------
Hello! I would like to book this taxi transfer. Please confirm vehicle availability.`;
      return `https://wa.me/${cleanPhone}?text=${encodeURIComponent(msg)}`;
    }

    if (bookSedan) bookSedan.href = buildWaLink("Maruti Swift Dzire / Etios (Sedan)", fareSedan);
    if (bookErtiga) bookErtiga.href = buildWaLink("Maruti Suzuki Ertiga (SUV)", fareErtiga);
    if (bookCrysta) bookCrysta.href = buildWaLink("Toyota Innova Crysta (Luxury SUV)", fareCrysta);
    if (bookUrbania) bookUrbania.href = buildWaLink("13 Seater Maharaja Urbania (Recliner Luxury Van)", fareUrbania);
  }

  // Autocomplete suggestions helper
  function setupAutocomplete(inputEl, suggestionsEl) {
    if (!inputEl || !suggestionsEl) return;

    function renderList(filterText = "") {
      const q = filterText.toLowerCase().trim();
      suggestionsEl.innerHTML = "";
      const matches = Object.values(CITY_CACHE).filter(c => !q || c.name.toLowerCase().includes(q));

      if (matches.length === 0) {
        suggestionsEl.style.display = "none";
        return;
      }

      matches.slice(0, 8).forEach(c => {
        const li = document.createElement("li");
        li.innerHTML = `<span>${c.name}</span><span style="font-size:0.75rem; color:#9CA3AF;">${c.distFromAjmer !== undefined ? c.distFromAjmer + " km" : ""}</span>`;
        li.addEventListener("mousedown", (e) => {
          e.preventDefault();
          inputEl.value = c.name;
          suggestionsEl.style.display = "none";
          calculateFares();
        });
        suggestionsEl.appendChild(li);
      });
      suggestionsEl.style.display = "block";
    }

    inputEl.addEventListener("focus", () => renderList(inputEl.value));
    inputEl.addEventListener("input", () => renderList(inputEl.value));
    inputEl.addEventListener("blur", () => {
      setTimeout(() => { suggestionsEl.style.display = "none"; }, 200);
    });
  }

  setupAutocomplete(inputOrigin, originSuggestions);
  setupAutocomplete(inputDest, destSuggestions);

  // Clear buttons
  btnClearOrigin?.addEventListener("click", () => {
    if (inputOrigin) inputOrigin.value = "";
    inputOrigin?.focus();
  });
  btnClearDest?.addEventListener("click", () => {
    if (inputDest) inputDest.value = "";
    inputDest?.focus();
  });

  // GPS button
  btnGps?.addEventListener("click", () => {
    if (navigator.geolocation) {
      btnGps.style.opacity = "0.5";
      navigator.geolocation.getCurrentPosition(
        () => {
          if (inputOrigin) inputOrigin.value = "Ajmer City";
          btnGps.style.opacity = "1";
          calculateFares();
        },
        () => {
          if (inputOrigin) inputOrigin.value = "Ajmer City";
          btnGps.style.opacity = "1";
          calculateFares();
        },
        { timeout: 4000 }
      );
    }
  });

  // Swap button
  btnSwap?.addEventListener("click", () => {
    if (inputOrigin && inputDest) {
      const temp = inputOrigin.value;
      inputOrigin.value = inputDest.value;
      inputDest.value = temp;
      calculateFares();
    }
  });

  // Mode Tabs
  modeTabs.forEach(tab => {
    tab.addEventListener("click", () => {
      modeTabs.forEach(t => t.classList.remove("active"));
      tab.classList.add("active");
      currentTrip = tab.getAttribute("data-trip") || "one-way";
      calculateFares();
    });
  });

  // Quick Pills
  quickPills.forEach(pill => {
    pill.addEventListener("click", () => {
      quickPills.forEach(p => p.classList.remove("active"));
      pill.classList.add("active");
      const from = pill.getAttribute("data-from") || "Ajmer";
      const to = pill.getAttribute("data-to") || "Pushkar";
      if (inputOrigin) inputOrigin.value = from;
      if (inputDest) inputDest.value = to;
      calculateFares();
    });
  });

  // Search Action Button
  btnSearchAction?.addEventListener("click", () => {
    calculateFares();
    const cabsRow = document.getElementById("hero-cabs-row");
    if (cabsRow) {
      cabsRow.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }
  });

  travelDate?.addEventListener("change", calculateFares);
  travelTime?.addEventListener("change", calculateFares);
  inputOrigin?.addEventListener("change", calculateFares);
  inputDest?.addEventListener("change", calculateFares);

  // Initial calculation on page load
  calculateFares();

  // Mobile Scroll Animation: Car exits to the left while content is pinned
  function initMobileCarScroll() {
    const slider = document.getElementById("mobile-car-slider");
    const carCol = document.getElementById("hero-car-col");
    if (!slider) return;

    if (carCol) {
      carCol.style.maxHeight = "";
      carCol.style.opacity = "";
      carCol.style.visibility = "";
      carCol.style.pointerEvents = "";
    }

    const scrollThreshold = 220;
    let ticking = false;

    function onScroll() {
      if (window.innerWidth > 900) {
        slider.style.transform = "";
        slider.style.opacity = "";
        slider.style.visibility = "";
        ticking = false;
        return;
      }

      const scrollY = window.scrollY || window.pageYOffset || 0;
      const progress = Math.min(1, Math.max(0, scrollY / scrollThreshold));
      slider.style.transform = `translateX(${-progress * 130}vw)`;

      if (progress >= 1) {
        slider.style.visibility = "hidden";
      } else {
        slider.style.visibility = "visible";
      }

      ticking = false;
    }

    function requestTick() {
      if (!ticking) {
        requestAnimationFrame(onScroll);
        ticking = true;
      }
    }

    window.addEventListener("scroll", requestTick, { passive: true });
    window.addEventListener("resize", requestTick, { passive: true });
    onScroll();
  }

  initMobileCarScroll();
</script>
