---
import { business } from "@/data/business";
import { routes } from "@/data/routes";
import { vehicles } from "@/data/vehicles";
import { createWhatsAppBookingUrl } from "@/utils/whatsapp";

const whatsappUrl = createWhatsAppBookingUrl();
---

<section class="hero-section" id="hero-section" aria-label="Hero Taxi Transfers" style="background-color: #F8F9FB; color: #111827;">
  <div class="hero-mobile-track" id="hero-mobile-track">
    <div class="hero-sticky-wrap" id="hero-sticky-wrap">
      <div class="hero-container container--wide">
        <!-- Top Hero Area: Text Left + Top-Down Car Right -->
        <div class="hero-top-grid">
          <!-- Left Column: Typography & Trip Type -->
          <div class="hero-text-col">
            <div class="hero-badge-row">
              <span class="live-beacon"><span class="live-beacon__dot"></span> 24/7 Direct Dispatch</span>
              <span class="heritage-pill">Serving Ajmer Since 2008</span>
            </div>
            <h1 class="hero-title">
              Taxi Service in <span class="highlight-yellow">Ajmer</span> &amp; Pushkar<br />
              <span class="highlight-yellow">Private Cabs</span> &amp; Outstation Rentals
            </h1>

            <p class="hero-description">
              Book verified AC cabs, outstation car rentals, and Kishangarh airport transfers in Ajmer &amp; Pushkar. We provide clean yellow-plate commercial taxis, polite local chauffeurs, ₹0 advance payment, and 24/7 direct dispatch.
            </p>

            <!-- Key Feature Badges -->
            <div class="hero-highlights-list" role="list">
              <span class="hl-item" role="listitem">✓ Direct Fleet Rates</span>
              <span class="hl-item" role="listitem">✓ ₹0 Advance • Pay at Drop</span>
              <span class="hl-item" role="listitem">✓ 24/7 Doorstep Pickup</span>
            </div>
          </div>

          <!-- Right Column: Top-Down White Luxury Car Image -->
          <div class="hero-car-col" id="hero-car-col">
            <div class="mobile-car-slider" id="mobile-car-slider">
              <div class="car-image-frame" id="car-image-frame">
                <img
                  src="/images/hero-top-car.jpg"
                  alt="Private Luxury White Cab - Taxi Services in Ajmer"
                  class="hero-car-image"
                  id="hero-car-image"
                  width="800"
                  height="500"
                  loading="eager"
                  fetchpriority="high"
                />
              </div>
            </div>
          </div>
        </div>

    <!-- Hero Live Taxi Fare Calculator & Route Search Engine -->
    <div class="hero-search-wrapper" id="booking-search-bar">
      <div class="hero-calc-card">
        
        <!-- Trip Mode Navigation Tabs -->
        <div class="hero-calc-top-bar">
          <div class="hero-tab-group" role="tablist">
            <button type="button" class="hero-mode-tab active" data-trip="one-way" id="hero-tab-oneway">
              <span class="tab-icon">➔</span> One-Way Drop
            </button>
            <button type="button" class="hero-mode-tab" data-trip="round-trip" id="hero-tab-roundtrip">
              <span class="tab-icon">⇄</span> Round Trip
            </button>
            <button type="button" class="hero-mode-tab" data-trip="local" id="hero-tab-local">
              <span class="tab-icon">⏱</span> Local 8Hr/80Km
            </button>
          </div>
          <div class="hero-badge-pill">
            <span class="live-dot"></span> LIVE CAB FARES &bull; ZERO COMMISSION
          </div>
        </div>

        <!-- Search Fields Input Bar -->
        <div class="hero-calc-fields">
          
          <!-- Origin / Pickup Input -->
          <div class="hero-field-block origin-block">
            <div class="hero-field-lbl">
              <span class="dot-indicator green"></span>
              <label for="hero-origin-input">PICKUP (CITY / LOCATION)</label>
            </div>
            <div class="hero-input-inner">
              <input 
                type="text" 
                id="hero-origin-input" 
                class="hero-text-field" 
                placeholder="Pickup City or Station..." 
                value="Ajmer" 
                autocomplete="off" 
              />
              <button type="button" class="btn-hero-gps" id="btn-hero-gps" title="Use Current GPS">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/><line x1="12" y1="2" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="22"/><line x1="2" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="22" y2="12"/></svg>
              </button>
              <button type="button" class="btn-hero-clear" id="btn-hero-clear-origin">✕</button>
            </div>
            <ul class="hero-suggestions" id="hero-origin-suggestions" style="display:none;"></ul>
          </div>

          <!-- Swap Locations Button -->
          <div class="hero-swap-wrap">
            <button type="button" class="btn-hero-swap" id="btn-hero-swap" title="Swap Pickup & Destination">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 16V4m0 0L3 8m4-4l4 4m6 4v12m0 0l4-4m-4 4l-4-4"/></svg>
            </button>
          </div>

          <!-- Destination / Drop Input -->
          <div class="hero-field-block dest-block">
            <div class="hero-field-lbl">
              <span class="dot-indicator red"></span>
              <label for="hero-dest-input">DESTINATION (CITY / AIRPORT)</label>
            </div>
            <div class="hero-input-inner">
              <input 
                type="text" 
                id="hero-dest-input" 
                class="hero-text-field" 
                placeholder="Destination or Outstation..." 
                value="Pushkar" 
                autocomplete="off" 
              />
              <button type="button" class="btn-hero-clear" id="btn-hero-clear-dest">✕</button>
            </div>
            <ul class="hero-suggestions" id="hero-dest-suggestions" style="display:none;"></ul>
          </div>

          <!-- Travel Date & Time -->
          <div class="hero-field-block date-block">
            <div class="hero-field-lbl">
              <span class="dot-indicator gold"></span>
              <label for="hero-travel-date">TRAVEL DATE &amp; TIME</label>
            </div>
            <div class="hero-datetime-inner">
              <input type="date" id="hero-travel-date" class="hero-text-field hero-date-field" />
              <select id="hero-travel-time" class="hero-text-field hero-time-field">
                <option value="Morning (06:00 AM)">Morning (06:00 AM)</option>
                <option value="Morning (09:00 AM)" selected>Morning (09:00 AM)</option>
                <option value="Afternoon (12:00 PM)">Noon (12:00 PM)</option>
                <option value="Evening (04:00 PM)">Evening (04:00 PM)</option>
                <option value="Night (09:00 PM)">Night (09:00 PM)</option>
              </select>
            </div>
          </div>

          <!-- Search / Recalculate CTA Button -->
          <button type="button" class="btn-hero-search-action" id="btn-hero-search-action">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <span>Search Cabs</span>
          </button>

        </div>

        <!-- Quick Popular Routes Row -->
        <div class="hero-quick-routes">
          <span class="hqr-label">⚡ Popular Routes:</span>
          <div class="hqr-pills" id="hero-quick-pills">
            <button type="button" class="hqr-pill active" data-from="Ajmer" data-to="Pushkar">Pushkar (14 km)</button>
            <button type="button" class="hqr-pill" data-from="Ajmer" data-to="Sarwar Sharif">Sarwar Sharif (64 km)</button>
            <button type="button" class="hqr-pill" data-from="Ajmer" data-to="Jaipur">Jaipur (135 km)</button>
            <button type="button" class="hqr-pill" data-from="Ajmer" data-to="Kishangarh Airport">Kishangarh Airport (28 km)</button>
            <button type="button" class="hqr-pill" data-from="Ajmer" data-to="Khatu Shyam Ji">Khatu Shyam Ji (180 km)</button>
            <button type="button" class="hqr-pill" data-from="Ajmer" data-to="Salasar Balaji">Salasar Balaji (175 km)</button>
            <button type="button" class="hqr-pill" data-from="Ajmer" data-to="Udaipur">Udaipur (265 km)</button>
            <button type="button" class="hqr-pill" data-from="Ajmer" data-to="Delhi">Delhi IGI (395 km)</button>
            <button type="button" class="hqr-pill" data-from="Ajmer" data-to="Jodhpur">Jodhpur (200 km)</button>
          </div>
        </div>

        <!-- Real-Time Distance & Route Highway Info Strip -->
        <div class="hero-distance-strip" id="hero-distance-strip">
          <div class="strip-left">
            <span class="route-info-chip" id="hero-chip-dist">14 KM Highway Drive</span>
            <span class="route-info-chip" id="hero-chip-time">30-40 Mins</span>
            <span class="route-info-chip hwy" id="hero-chip-hwy">Pushkar Ghati / Nagpahari Pass</span>
          </div>
          <div class="strip-right">
            <span class="fare-guarantee-text">✓ Direct Fleet Operator Pricing &bull; Pay at Drop</span>
          </div>
        </div>

        <!-- Real-Time Vehicle Price Cards Grid -->
        <div class="hero-cabs-row" id="hero-cabs-row">
          
          <!-- Sedan: Dzire / Etios -->
          <div class="hero-cab-item" data-veh="sedan">
            <div class="item-top">
              <span class="veh-icon">🚗</span>
              <div class="veh-meta">
                <span class="veh-title">Maruti Dzire / Etios</span>
                <span class="veh-specs">4 Seats &bull; 2 Bags &bull; AC</span>
              </div>
              <span class="veh-badge green">Economical</span>
            </div>
            <div class="item-pricing">
              <div class="veh-mrp" id="hero-mrp-sedan">₹1,100</div>
              <div class="veh-price-box">
                <span class="veh-currency">₹</span><strong class="veh-amount" id="hero-price-sedan">700</strong>
                <span class="veh-type" id="hero-type-sedan">Fixed Drop</span>
              </div>
            </div>
            <a href="#" class="btn-hero-cab-book" id="hero-book-sedan" target="_blank" rel="noopener noreferrer">
              Book on WhatsApp
            </a>
          </div>

          <!-- SUV: Ertiga -->
          <div class="hero-cab-item" data-veh="ertiga">
            <div class="item-top">
              <span class="veh-icon">🚙</span>
              <div class="veh-meta">
                <span class="veh-title">Maruti Suzuki Ertiga</span>
                <span class="veh-specs">6 Seats &bull; 4 Bags &bull; AC</span>
              </div>
              <span class="veh-badge blue">Family SUV</span>
            </div>
            <div class="item-pricing">
              <div class="veh-mrp" id="hero-mrp-ertiga">₹1,800</div>
              <div class="veh-price-box">
                <span class="veh-currency">₹</span><strong class="veh-amount" id="hero-price-ertiga">1,200</strong>
                <span class="veh-type" id="hero-type-ertiga">Fixed Drop</span>
              </div>
            </div>
            <a href="#" class="btn-hero-cab-book" id="hero-book-ertiga" target="_blank" rel="noopener noreferrer">
              Book on WhatsApp
            </a>
          </div>

          <!-- Premium SUV: Innova Crysta -->
          <div class="hero-cab-item" data-veh="crysta">
            <div class="item-top">
              <span class="veh-icon">✨</span>
              <div class="veh-meta">
                <span class="veh-title">Toyota Innova Crysta</span>
                <span class="veh-specs">7 Seats &bull; 5 Bags &bull; AC</span>
              </div>
              <span class="veh-badge purple">VIP Ride</span>
            </div>
            <div class="item-pricing">
              <div class="veh-mrp" id="hero-mrp-crysta">₹2,400</div>
              <div class="veh-price-box">
                <span class="veh-currency">₹</span><strong class="veh-amount" id="hero-price-crysta">1,500</strong>
                <span class="veh-type" id="hero-type-crysta">Fixed Drop</span>
              </div>
            </div>
            <a href="#" class="btn-hero-cab-book" id="hero-book-crysta" target="_blank" rel="noopener noreferrer">
              Book on WhatsApp
            </a>
          </div>

          <!-- Luxury Van: 13 Seater Maharaja Urbania -->
          <div class="hero-cab-item luxury-item" data-veh="urbania">
            <div class="item-top">
              <span class="veh-icon">👑</span>
              <div class="veh-meta">
                <span class="veh-title">13 Seater Maharaja Urbania</span>
                <span class="veh-specs">13 Seats &bull; Recliners &bull; AC</span>
              </div>
              <span class="veh-badge gold">Maharaja Recliner</span>
            </div>
            <div class="item-pricing">
              <div class="veh-mrp" id="hero-mrp-urbania">₹4,800</div>
              <div class="veh-price-box">
                <span class="veh-currency">₹</span><strong class="veh-amount" id="hero-price-urbania">3,500</strong>
                <span class="veh-type" id="hero-type-urbania">Direct Rate</span>
              </div>
            </div>
            <a href="#" class="btn-hero-cab-book" id="hero-book-urbania" target="_blank" rel="noopener noreferrer">
              Book on WhatsApp
            </a>
          </div>

        </div>

        <!-- Footer Link to Full Calculator -->
        <div class="hero-calc-bottom-link">
          <a href="/fare-calculator/">
            🔍 Looking for multi-city tour packages, tempo travellers, or detailed kilometer breakdown? Open Full Taxi Fare Calculator &rarr;
          </a>
        </div>

      </div>
    </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    background-color: #F8F9FB !important;
    background-image: radial-gradient(circle at 85% 30%, rgba(240, 243, 248, 0.8) 0%, rgba(248, 249, 251, 1) 70%) !important;
    color: #111827 !important;
    padding-top: calc(var(--header-height, 72px) + 36px) !important;
    padding-bottom: 48px !important;
    overflow: hidden;
    border-bottom: 1px solid #E5E7EB !important;
  }

  .hero-container {
    max-width: 1240px;
    margin-inline: auto;
    padding-inline: 20px;
  }

  /* 2-Column Hero Top Grid */
  .hero-top-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 32px;
    min-height: 420px;
  }

  /* Left Column */
  .hero-text-col {
    z-index: 2;
    padding-top: 12px;
  }

  .hero-badge-row {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }

  .heritage-pill {
    display: inline-block;
    background: rgba(197, 155, 39, 0.15);
    border: 1px solid var(--color-accent);
    color: var(--color-accent-dark);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 4px 12px;
    border-radius: var(--radius-full);
  }

  .hero-eyebrow {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-accent-dark) !important;
    margin-bottom: 14px;
    letter-spacing: -0.01em;
  }

  .hero-title {
    font-family: var(--font-heading) !important;
    font-size: clamp(2.4rem, 4.2vw, 3.6rem) !important;
    line-height: 1.18 !important;
    font-weight: 800 !important;
    color: var(--color-primary-dark) !important;
    margin-bottom: 18px !important;
    letter-spacing: -0.01em !important;
  }

  .highlight-yellow {
    color: var(--color-accent-dark) !important;
    -webkit-text-fill-color: var(--color-accent-dark) !important;
    display: inline-block;
  }

  .hero-description {
    font-size: 1.05rem !important;
    line-height: 1.65 !important;
    color: #4B5563 !important;
    max-width: 540px;
    margin-bottom: 24px !important;
  }

  /* Trip Type Radio Selector */
  .hero-trip-selector {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-bottom: 24px;
  }

  .trip-radio-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 600;
    color: #374151;
    user-select: none;
  }

  .trip-radio-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .trip-radio-custom {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 2px solid #D1D5DB;
    background: #FFFFFF;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .trip-radio-input:checked + .trip-radio-custom {
    border-color: var(--color-accent-dark);
  }

  .trip-radio-input:checked + .trip-radio-custom::after {
    content: "";
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-accent-dark);
  }

  /* Right Column: Car Image */
  .hero-car-col {
    position: relative;
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  .mobile-car-slider {
    width: 100%;
    display: flex;
    justify-content: flex-end;
  }

  .car-image-frame {
    width: 100%;
    max-width: 560px;
    position: relative;
    display: flex;
    justify-content: flex-end;
  }

  .hero-car-image {
    width: 100%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 20px 30px rgba(0, 0, 0, 0.08));
    transform: rotate(0deg) scale(1.06);
    transform-origin: center right;
  }

  /* ─── Hero Live Fare & Route Search Engine Card ─── */
  .hero-search-wrapper {
    position: relative;
    margin-top: 24px;
    z-index: 5;
  }

  .hero-calc-card {
    background: #FFFFFF;
    border: 1.5px solid rgba(197, 155, 39, 0.4);
    border-radius: 16px;
    box-shadow: 0 16px 40px rgba(34, 24, 28, 0.1), 0 0 0 1px rgba(197, 155, 39, 0.15);
    padding: 18px 20px;
    position: relative;
  }

  .hero-calc-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 14px;
  }

  .hero-tab-group {
    display: flex;
    gap: 6px;
    background: #F3F4F6;
    padding: 4px;
    border-radius: 10px;
  }

  .hero-mode-tab {
    padding: 7px 14px;
    border: none;
    border-radius: 7px;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #4B5563;
    background: transparent;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .hero-mode-tab.active {
    background: var(--color-primary, #6B1124);
    color: #FFFFFF;
    box-shadow: 0 2px 8px rgba(107, 17, 36, 0.25);
  }

  .hero-badge-pill {
    font-size: 0.75rem;
    font-weight: 700;
    color: #047857;
    background: #ECFDF5;
    border: 1px solid #A7F3D0;
    padding: 4px 10px;
    border-radius: 20px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .live-dot {
    width: 7px;
    height: 7px;
    background: #10B981;
    border-radius: 50%;
    animation: livePulse 1.8s infinite;
  }

  @keyframes livePulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .hero-calc-fields {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    margin-bottom: 12px;
  }

  .hero-field-block {
    flex: 1;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .hero-field-lbl {
    font-size: 0.6875rem;
    font-weight: 800;
    color: #6B7280;
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .dot-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    display: inline-block;
  }
  .dot-indicator.green { background: #10B981; }
  .dot-indicator.red { background: #EF4444; }
  .dot-indicator.gold { background: #F59E0B; }

  .hero-input-inner {
    display: flex;
    align-items: center;
    background: #F9FAFB;
    border: 1.5px solid #E5E7EB;
    border-radius: 10px;
    padding: 0 8px;
    height: 48px;
    transition: all 0.2s ease;
  }

  .hero-input-inner:focus-within {
    border-color: var(--color-accent, #C59B27);
    background: #FFFFFF;
    box-shadow: 0 0 0 3px rgba(197, 155, 39, 0.2);
  }

  .hero-text-field {
    border: none;
    background: transparent;
    outline: none;
    font-size: 0.9375rem;
    font-weight: 700;
    color: #111827;
    width: 100%;
    padding: 0 4px;
  }

  .btn-hero-gps,
  .btn-hero-clear {
    border: none;
    background: transparent;
    color: #9CA3AF;
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    transition: color 0.15s;
  }
  .btn-hero-gps:hover { color: #10B981; }
  .btn-hero-clear:hover { color: #EF4444; }

  .hero-swap-wrap {
    flex: 0 0 auto;
    padding-bottom: 4px;
  }

  .btn-hero-swap {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #FFFBEB;
    border: 1.5px solid #FCD34D;
    color: #B45309;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.25s ease, background 0.15s;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
  }

  .btn-hero-swap:hover {
    transform: rotate(180deg) scale(1.05);
    background: #FEF3C7;
  }

  .hero-datetime-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    height: 48px;
  }

  .hero-date-field,
  .hero-time-field {
    border: 1.5px solid #E5E7EB;
    background: #F9FAFB;
    border-radius: 10px;
    padding: 0 8px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #111827;
    height: 100%;
    outline: none;
  }

  .hero-date-field:focus,
  .hero-time-field:focus {
    border-color: var(--color-accent, #C59B27);
    background: #FFFFFF;
  }

  .btn-hero-search-action {
    background: linear-gradient(135deg, #FDE68A 0%, #F59E0B 50%, #D97706 100%);
    color: #24040B;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 10px;
    font-weight: 800;
    font-size: 0.9375rem;
    height: 48px;
    padding: 0 20px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
