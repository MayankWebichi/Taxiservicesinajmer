---
export interface Props {
  showJourneyTracker?: boolean;
  routeTitle?: string;
  distanceKm?: string;
}

const {
  showJourneyTracker = false,
  routeTitle = "Ajmer Taxi Highway",
  distanceKm = ""
} = Astro.props;
---

<!-- Global Cinematic Top Scroll Progress Bar -->
<div id="scroll-progress-container" class="scroll-progress-container" aria-hidden="true">
  <div id="scroll-progress-bar" class="scroll-progress-bar"></div>
</div>

{showJourneyTracker && (
  <!-- lets-scroll Interactive Route Scrub Tracker -->
  <aside class="route-scrub-tracker" id="route-scrub-tracker" aria-label="Route scroll progress">
    <div class="scrub-track-inner">
      <div class="scrub-meta">
        <span class="scrub-origin">📍 Ajmer</span>
        <span class="scrub-destination">{routeTitle}</span>
      </div>
      <div class="scrub-road">
        <div class="scrub-road-line"></div>
        <div class="scrub-car" id="scrub-car-icon">
          <svg viewBox="0 0 24 24" fill="currentColor" class="scrub-car-svg">
            <path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/>
          </svg>
        </div>
      </div>
    </div>
  </aside>
)}

<script>
  import { ScrubEngine } from "./scrub-engine.js";

  const initEngine = () => {
    const bar = document.getElementById("scroll-progress-bar");
    const car = document.getElementById("scrub-car-icon");
    const tracker = document.getElementById("route-scrub-tracker");

    if (bar) {
      const engine = new ScrubEngine({
        progressBar: bar,
        carScrubber: car,
        lerpFactor: 0.1
      });

      if (tracker) {
        engine.onProgress((progress) => {
          if (progress > 0.05 && progress < 0.95) {
            tracker.classList.add("is-visible");
          } else {
            tracker.classList.remove("is-visible");
          }
        });
      }
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initEngine);
  } else {
    initEngine();
  }
  document.addEventListener("astro:after-swap", initEngine);
</script>

<style>
  /* Top Scroll Indicator */
  .scroll-progress-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3.5px;
    background: transparent;
    z-index: 99999;
    pointer-events: none;
  }

  .scroll-progress-bar {
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, #C59B27 0%, #FAD66D 50%, #D4AF37 100%);
    box-shadow: 0 0 10px rgba(250, 214, 109, 0.7);
    transform-origin: 0 50%;
    transform: scaleX(0);
    will-change: transform;
  }

  /* Route Scrub Tracker (Floating Highway Mini-HUD) */
  .route-scrub-tracker {
    position: fixed;
    bottom: 24px;
    left: 24px;
    z-index: 900;
    background: rgba(30, 2, 8, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(212, 175, 55, 0.4);
    border-radius: var(--radius-lg, 16px);
    padding: 10px 16px;
    color: #FFFFFF;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.35s ease, transform 0.35s ease;
    pointer-events: none;
    max-width: 260px;
  }

  .route-scrub-tracker.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .scrub-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    font-weight: 600;
    color: #FAD66D;
    margin-bottom: 6px;
    gap: 8px;
  }

  .scrub-road {
    position: relative;
    width: 100%;
    height: 16px;
    display: flex;
    align-items: center;
  }

  .scrub-road-line {
    position: absolute;
    width: 100%;
    height: 2px;
    background: rgba(255, 255, 255, 0.25);
    border-radius: 2px;
  }

  .scrub-car {
    position: absolute;
    left: 0;
    color: #FAD66D;
    filter: drop-shadow(0 0 4px rgba(250, 214, 109, 0.8));
    will-change: transform;
  }

  .scrub-car-svg {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 768px) {
    .route-scrub-tracker {
      display: none; /* Keep mobile viewport clean & focused */
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-progress-container,
    .route-scrub-tracker {
      display: none !important;
    }
  }
</style>
