---
import { faqs, type FAQItem } from "@/data/faqs";

export interface Props {
  items?: FAQItem[];
  title?: string;
  subtitle?: string;
}

const { 
  items = faqs, 
  title = "Frequently Asked Questions",
  subtitle = "Clear Answers Before You Travel"
} = Astro.props;
---

<section class="faq-section" id="faq" aria-label="Frequently Asked Questions">
  <div class="container container--narrow">
    <div class="section-header text-center">
      <span class="section-subtitle">{subtitle}</span>
      <h2 class="section-title">{title}</h2>
      <p class="section-desc">
        Everything you need to know about our taxi rental services, verified fixed fares, vehicle categories, and cancellation policies in Ajmer.
      </p>
    </div>

    <div class="faq-accordion">
      {items.map((faq, index) => (
        <details class="faq-item" open={index === 0}>
          <summary class="faq-question">
            <span class="q-text">{faq.question}</span>
            <span class="q-icon" aria-hidden="true">+</span>
          </summary>
          <div class="faq-answer">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <div class="faq-footer-card">
      <div class="footer-prompt">
        <h4>Have a specific custom route or query?</h4>
        <p>Our Ajmer dispatch team is available 24/7 to assist with rates and custom tour plans.</p>
      </div>
      <a href="tel:+917737314538" class="btn btn--primary btn--sm">
        Call +91 77373 14538
      </a>
    </div>
  </div>
</section>

<style>
  .faq-section {
    padding: var(--space-4xl) 0;
    background: #FFFFFF;
  }

  .container--narrow {
    max-width: 800px;
  }

  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-bottom: var(--space-3xl);
  }

  .faq-item {
    background: var(--color-cream);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .faq-item[open] {
    border-color: var(--color-accent);
    box-shadow: 0 4px 16px rgba(34, 24, 28, 0.06);
    background: #FFFFFF;
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-md) var(--space-lg);
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-primary);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .q-icon {
    font-size: 1.5rem;
    color: var(--color-accent-dark);
    line-height: 1;
    transition: transform var(--transition-base);
  }

  .faq-item[open] .q-icon {
    transform: rotate(45deg);
  }

  .faq-answer {
    padding: 0 var(--space-lg) var(--space-md);
    border-top: 1px dashed var(--color-border);
    margin-top: 4px;
    padding-top: var(--space-sm);
  }

  .faq-answer p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0;
  }

  .faq-footer-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-lg);
    padding: var(--space-lg) var(--space-xl);
    gap: var(--space-md);
  }

  .footer-prompt h4 {
    font-family: var(--font-heading);
    color: var(--color-primary);
    margin-bottom: 2px;
  }

  .footer-prompt p {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  @media (max-width: 650px) {
    .faq-footer-card {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
