---
import { business } from "@/data/business";
import { createWhatsAppBookingUrl } from "@/utils/whatsapp";

const currentPath = Astro.url.pathname;

// Services for the rich desktop dropdown
const servicesList = [
  {
    title: "Outstation Cabs",
    desc: "Jaipur, Delhi, Udaipur, Jodhpur & beyond",
    href: "/outstation/",
    tag: "From ₹10/km",
    icon: "M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9C2.1 11.1 2 11.5 2 12v4c0 .6.4 1 1 1h2"
  },
  {
    title: "Airport Transfer",
    desc: "Kishangarh (VIKG) & Jaipur (JAI) 24/7",
    href: "/airport-transfer/",
    tag: "Fixed Fares",
    icon: "M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"
  },
  {
    title: "Ajmer Sightseeing",
    desc: "Full day (₹2,500) & half day (₹1,500) tours",
    href: "/ajmer-sightseeing-taxi/",
    tag: "₹2,500 / ₹1,500",
    icon: "M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
  },
  {
    title: "Wedding Logistics",
    desc: "Baraat cars, guest shuttles, Urbania & Tempo fleet",
    href: "/wedding-logistics/",
    tag: "Event Fleet",
    icon: "M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
  },
  {
    title: "Pushkar Day Tour",
    desc: "Brahma Temple, Sacred Lake Ghats & Desert",
    href: "/pushkar-tour-from-ajmer/",
    tag: "Top Rated",
    icon: "M12 3L2 12h3v8h6v-6h2v6h6v-8h3L12 3z"
  },
  {
    title: "One-Way Drops",
    desc: "Pay only one side, zero return charges",
    href: "/one-way-taxi-ajmer/",
    tag: "Save 40%",
    icon: "M5 12h14M12 5l7 7-7 7"
  },
  {
    title: "Dargah Sharif Cab",
    desc: "Railway station to Dargah VIP drops & darshan",
    href: "/dargah-taxi-ajmer/",
    tag: "Station Pickup",
    icon: "M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
  },
  {
    title: "Sarwar Sharif Cab",
    desc: "Hazrat Khwaja Fakhruddin Chishti Dargah Ziyarat",
    href: "/ajmer-to-sarwar-sharif-taxi/",
    tag: "Fixed ₹2,000",
    icon: "M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"
  }
];

const isServiceActive = servicesList.some(s => currentPath === s.href || currentPath.startsWith(s.href));

// Primary Desktop Nav Links
const desktopNav = [
  { label: "Home", href: "/", isActive: currentPath === "/" },
  { label: "Services", href: "#services-dropdown", isDropdown: true, isActive: isServiceActive },
  { label: "Tour Packages", href: "/tours/", isActive: currentPath.startsWith("/tours") },
  { label: "Fare Calculator", href: "/fare-calculator/", isActive: currentPath.startsWith("/fare-calculator") },
  { label: "About", href: "/about/", isActive: currentPath.startsWith("/about") },
  { label: "Blog", href: "/blog/", isActive: currentPath.startsWith("/blog") },
  { label: "Contact", href: "/contact/", isActive: currentPath.startsWith("/contact") },
];

// All links for Mobile Drawer
const mobileLinks = [
  { label: "Home", href: "/" },
  { label: "Tour Packages (Rajasthan)", href: "/tours/" },
  { label: "Wedding Logistics", href: "/wedding-logistics/" },
  { label: "Sarwar Sharif Cab (₹2,000)", href: "/ajmer-to-sarwar-sharif-taxi/" },
  { label: "Outstation Cabs", href: "/outstation/" },
  { label: "Airport Transfer", href: "/airport-transfer/" },
  { label: "Ajmer Sightseeing", href: "/ajmer-sightseeing-taxi/" },
  { label: "Pushkar Day Tour", href: "/pushkar-tour-from-ajmer/" },
  { label: "One-Way Taxi", href: "/one-way-taxi-ajmer/" },
  { label: "Dargah Sharif Cab", href: "/dargah-taxi-ajmer/" },
  { label: "Fare Calculator Tool", href: "/fare-calculator/" },
  { label: "About Us", href: "/about/" },
  { label: "Travel Blog", href: "/blog/" },
  { label: "Contact Us", href: "/contact/" },
];

const whatsappUrl = createWhatsAppBookingUrl();
---

<header class="site-header" id="site-header">
  <div class="header-inner container--wide">
    
    <!-- Brand Name (Single text element with official logo seal) -->
    <a href="/" class="header-brand-text" aria-label="Taxi Services in Ajmer - Home">
      <img src="/images/logo-seal.png" alt="Taxi Services in Ajmer Logo" class="brand-logo-img" width="40" height="40" loading="eager" />
      <span class="brand-title">Taxi Services in Ajmer</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="header-nav" aria-label="Main navigation">
      <ul class="nav-list">
        {desktopNav.map((link) => (
          <li class={`nav-item ${link.isDropdown ? "nav-item--dropdown" : ""} ${link.isActive ? "is-active" : ""}`} id={link.isDropdown ? "services-nav-container" : undefined}>
            {link.isDropdown ? (
              <button 
                type="button" 
                class="nav-link nav-dropdown-trigger" 
                id="services-dropdown-btn"
                aria-expanded="false" 
                aria-haspopup="true"
                aria-controls="services-dropdown-menu"
              >
                <span>Services</span>
                <svg class="dropdown-arrow" width="13" height="13" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                </svg>
              </button>
              
              <!-- Mega Dropdown Menu -->
              <div class="services-dropdown-menu" id="services-dropdown-menu" role="menu" aria-label="Taxi Services Menu">
                <div class="dropdown-header">
                  <span class="dropdown-badge">Ajmer Chauffeur Services</span>
                  <span class="dropdown-tagline">Clean AC Cabs &bull; Verified Drivers &bull; Since 2008</span>
                </div>
                <div class="dropdown-grid">
                  {servicesList.map((s) => (
                    <a href={s.href} class="dropdown-item" role="menuitem">
                      <div class="item-icon-box">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                          <path d={s.icon}></path>
                        </svg>
                      </div>
                      <div class="item-body">
                        <div class="item-top">
                          <strong class="item-title">{s.title}</strong>
                          <span class="item-tag">{s.tag}</span>
                        </div>
                        <p class="item-desc">{s.desc}</p>
                      </div>
                    </a>
                  ))}
                </div>
                <div class="dropdown-footer">
                  <span class="footer-note">Looking for custom round-trip or wedding packages?</span>
                  <a href={`tel:${business.phone}`} class="footer-call">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
                    Call {business.phoneFormatted}
                  </a>
                </div>
              </div>
            ) : (
              <a href={link.href} class="nav-link">
                <span>{link.label}</span>
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <!-- Desktop Actions -->
    <div class="header-actions">
      <!-- 24/7 Live Call Pill -->
      <a
        href={`tel:${business.phone}`}
        class="header-call-pill"
        aria-label={`Call 24/7 Helpline ${business.phoneFormatted}`}
      >
        <span class="live-dot-wrap" aria-hidden="true">
          <span class="live-dot"></span>
          <span class="live-ring"></span>
        </span>
        <div class="call-pill-text">
          <span class="call-pill-sub">24/7 Helpline</span>
          <span class="call-pill-num">{business.phoneFormatted}</span>
        </div>
      </a>

      <!-- Book Cab CTA Button -->
      <a
        href="/#booking-search-bar"
        class="header-book-btn"
        aria-label="Book Cab Online"
      >
        <span>Book Cab</span>
        <svg class="btn-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <!-- Mobile Actions (Dedicated live Call + Hamburger Menu) -->
    <div class="header-mobile-actions">
      <a
        href={`tel:${business.phone}`}
        class="mobile-action-btn mobile-call-btn"
        aria-label="Call Now"
      >
        <span class="live-call-badge" aria-hidden="true"></span>
        <svg class="mobile-call-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"></path></svg>
      </a>
      <button
        class="mobile-menu-toggle"
        id="mobile-menu-toggle"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="hamburger">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </span>
      </button>
    </div>

  </div>
</header>

<!-- Mobile Menu Overlay -->
<div class="mobile-menu-overlay" id="mobile-menu-overlay"></div>

<!-- Mobile Menu Drawer -->
<nav class="mobile-menu" id="mobile-menu" aria-label="Mobile navigation" inert>
  <div class="mobile-menu-header">
    <div class="mobile-menu-brand">
      <img src="/images/logo-seal.png" alt="Taxi Services in Ajmer Logo" class="brand-logo-img brand-logo-img--sm" width="34" height="34" loading="eager" />
      <span class="brand-title">Taxi Services in Ajmer</span>
    </div>
    <button class="mobile-menu-close" id="mobile-menu-close" aria-label="Close navigation menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>

  <ul class="mobile-nav-list">
    {mobileLinks.map((link) => (
      <li>
        <a href={link.href} class="mobile-nav-link">{link.label}</a>
      </li>
    ))}
  </ul>

  <div class="mobile-menu-ctas">
    <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--lg mobile-menu-cta-btn">
      Get a Quick Quote
    </a>
    <a href={`tel:${business.phone}`} class="btn btn--secondary btn--lg mobile-menu-cta-btn">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
      Call {business.phoneFormatted}
    </a>
  </div>

  <div class="mobile-menu-footer">
    <p class="mobile-menu-heritage">{business.heritageText}</p>
  </div>
</nav>

<style>
  /* ─── Site Header Shell ─── */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(229, 231, 235, 0.85);
    transition: height 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
    height: 74px;
  }

  /* Golden hairline accent */
  .site-header::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent 0%, rgba(197, 155, 39, 0.3) 15%, #C59B27 50%, rgba(197, 155, 39, 0.3) 85%, transparent 100%);
    pointer-events: none;
  }

  .site-header.is-scrolled {
    height: 64px;
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 4px 20px rgba(34, 24, 28, 0.08);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    max-width: 1380px;
    margin-inline: auto;
    padding-inline: clamp(16px, 2.5vw, 36px);
    gap: 16px;
  }

  /* ─── Brand Title ─── */
  .header-brand-text,
  .mobile-menu-brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-logo-img {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    object-fit: contain;
    border: 1.5px solid rgba(197, 155, 39, 0.45);
    box-shadow: 0 2px 8px rgba(90, 12, 26, 0.18);
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .brand-logo-img--sm {
    width: 32px;
    height: 32px;
  }

  .header-brand-text:hover .brand-logo-img {
    transform: scale(1.06);
  }

  .brand-title {
    font-family: var(--font-heading, 'Marcellus', serif);
    font-size: clamp(1.15rem, 1.6vw, 1.45rem);
    font-weight: 800;
    color: #5A0C1A;
    letter-spacing: -0.015em;
    white-space: nowrap;
    line-height: 1;
  }

  /* ─── Desktop Navigation ─── */
  .header-nav {
    display: none;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: clamp(2px, 0.6vw, 8px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 8px 13px;
    font-size: 0.9125rem;
    font-weight: 600;
    color: #374151;
    border-radius: 8px;
    text-decoration: none;
    background: transparent;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    position: relative;
    transition: color 0.18s ease, background 0.18s ease;
  }

  .nav-link:hover,
  .nav-item--dropdown:hover .nav-dropdown-trigger,
  .nav-item.is-active .nav-link {
    color: #5A0C1A;
    background: rgba(90, 12, 26, 0.05);
  }

  /* Active page underline pill */
  .nav-item.is-active .nav-link::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 13px;
    right: 13px;
    height: 2.5px;
    background: #C59B27;
    border-radius: 2px;
  }

  .dropdown-arrow {
    transition: transform 0.2s ease;
    opacity: 0.7;
  }

  .nav-item--dropdown:hover .dropdown-arrow,
  .nav-item--dropdown.is-open .dropdown-arrow {
    transform: rotate(180deg);
    opacity: 1;
    color: #C59B27;
  }

  /* ─── Mega Dropdown Menu ─── */
  .services-dropdown-menu {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    width: 580px;
    background: #FFFFFF;
    border-radius: 16px;
    border: 1px solid rgba(197, 155, 39, 0.25);
    box-shadow: 0 20px 48px rgba(34, 24, 28, 0.16), 0 4px 12px rgba(0, 0, 0, 0.04);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1), transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.22s;
    overflow: hidden;
    z-index: 10000;
  }

  /* Invisible hover bridge */
  .services-dropdown-menu::before {
    content: '';
    position: absolute;
    top: -14px;
    left: 0;
    right: 0;
    height: 14px;
  }

  .nav-item--dropdown:hover .services-dropdown-menu,
  .nav-item--dropdown:focus-within .services-dropdown-menu,
  .nav-item--dropdown.is-open .services-dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .dropdown-header {
    background: linear-gradient(135deg, #2E050D 0%, #5A0C1A 100%);
    padding: 12px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 2px solid #C59B27;
  }

  .dropdown-badge {
    color: #F5D278;
    font-family: var(--font-heading, serif);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .dropdown-tagline {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.72rem;
  }

  .dropdown-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
    padding: 14px;
    background: #FFFFFF;
  }

  .dropdown-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 10px;
    text-decoration: none;
    border: 1px solid transparent;
    transition: background 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
  }

  .dropdown-item:hover {
    background: #FAF6ED;
    border-color: rgba(197, 155, 39, 0.3);
    transform: translateY(-1px);
  }

  .item-icon-box {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: rgba(90, 12, 26, 0.07);
    color: #5A0C1A;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .dropdown-item:hover .item-icon-box {
    background: #5A0C1A;
    color: #F5D278;
  }

  .item-body {
    flex: 1;
    min-width: 0;
  }

  .item-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    margin-bottom: 2px;
  }

  .item-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: #1F2937;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .item-tag {
    font-size: 0.68rem;
    font-weight: 800;
    color: #5A0C1A;
    background: rgba(197, 155, 39, 0.2);
    border: 1px solid rgba(197, 155, 39, 0.4);
    padding: 1px 6px;
    border-radius: 4px;
    white-space: nowrap;
  }

  .item-desc {
    font-size: 0.75rem;
    color: #6B7280;
    line-height: 1.35;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dropdown-footer {
    background: #F9FAFB;
    border-top: 1px solid #E5E7EB;
    padding: 10px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.78rem;
    color: #4B5563;
  }

  .footer-call {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #5A0C1A;
    font-weight: 700;
    text-decoration: none;
  }

  .footer-call:hover {
    color: #C59B27;
    text-decoration: underline;
  }

  /* ─── Desktop Action Buttons ─── */
  .header-actions {
    display: none;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  /* 24/7 Helpline Pill */
  .header-call-pill {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #FAF6ED;
    border: 1px solid rgba(197, 155, 39, 0.38);
    padding: 6px 14px;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .header-call-pill:hover {
    background: #F3EBD6;
    border-color: #C59B27;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(197, 155, 39, 0.2);
  }

  .live-dot-wrap {
    position: relative;
    width: 9px;
    height: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .live-dot {
    width: 7px;
    height: 7px;
    background-color: #10B981;
    border-radius: 50%;
  }

  .live-ring {
    position: absolute;
    inset: -3px;
    border: 2px solid #10B981;
    border-radius: 50%;
    animation: livePulse 2s cubic-bezier(0.24, 0, 0.38, 1) infinite;
  }

  @keyframes livePulse {
    0% { transform: scale(0.6); opacity: 1; }
