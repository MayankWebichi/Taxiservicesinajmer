---
const reviews = [
  {
    name: "Rahul Sharma",
    initials: "RS",
    color: "#C59B27",
    textColor: "#22181C",
    rating: 5,
    service: "Ajmer to Jaipur",
    text: "Outstanding service! Driver was on time, the Dzire was spotlessly clean and the AC was powerful. Fixed fare, zero hidden charges. Highly recommend this taxi service for Jaipur trips.",
    timeAgo: "2 weeks ago",
    verified: true,
  },
  {
    name: "Sunita Meena",
    initials: "SM",
    color: "#5A0C1A",
    textColor: "#FFFFFF",
    rating: 5,
    service: "Dargah Taxi",
    text: "We came from Delhi for Ajmer Sharif Dargah and booked from the station. Driver was waiting at exit gate with our name. Very respectful and helpful — exactly what we needed for a pilgrimage.",
    timeAgo: "1 month ago",
    verified: true,
  },
  {
    name: "Amit Gupta",
    initials: "AG",
    color: "#2C5016",
    textColor: "#FFFFFF",
    rating: 5,
    service: "Ajmer to Pushkar",
    text: "Booked for Pushkar Camel Fair. Driver knew every parking spot and the best temple routes. Round trip in comfort for ₹700 — couldn't have asked for better value.",
    timeAgo: "3 weeks ago",
    verified: true,
  },
  {
    name: "Priya Verma",
    initials: "PV",
    color: "#1F3560",
    textColor: "#FFFFFF",
    rating: 5,
    service: "Kishangarh Airport",
    text: "Flight landed 45 minutes early and the driver was already there! He tracked my flight. Innova was immaculate and the driver was very professional. Perfect for corporate travel.",
    timeAgo: "1 week ago",
    verified: true,
  },
  {
    name: "Deepak Agarwal",
    initials: "DA",
    color: "#5A0C1A",
    textColor: "#FFFFFF",
    rating: 5,
    service: "Ajmer Sightseeing",
    text: "Full day Ajmer tour — covered Dargah, Ana Sagar Lake, Taragarh Fort and Nareli Jain Temple. Driver was like a local guide, shared history of every place. Absolutely brilliant experience!",
    timeAgo: "5 days ago",
    verified: true,
  },
  {
    name: "Kavita Singh",
    initials: "KS",
    color: "#4A1259",
    textColor: "#FFFFFF",
    rating: 5,
    service: "Wedding Cab",
    text: "Booked 3 Innova Crystas for my daughter's wedding. All three arrived on time, fully decorated as requested. The coordination from the team was flawless. 100% will recommend!",
    timeAgo: "2 months ago",
    verified: true,
  },
];
---

<section class="reviews-section" aria-label="Customer Reviews">
  <div class="container">
    <div class="reviews-header text-center">
      <span class="reviews-pill">⭐ Verified Google Reviews</span>
      <h2 class="reviews-title">Trusted by Thousands of Ajmer Travellers</h2>
      <p class="reviews-sub">Real reviews from real passengers — verified on Google Maps. Over 200+ five-star ratings since 2008.</p>
      <div class="overall-rating">
        <span class="rating-num">4.9</span>
        <div class="stars-row" aria-label="4.9 out of 5 stars">
          {"★★★★★".split("").map(() => <span class="star-filled">★</span>)}
        </div>
        <span class="rating-count">200+ Google Reviews</span>
      </div>
    </div>

    <!-- Fan Carousel -->
    <div class="reviews-track-wrap" aria-label="Customer review carousel">
      <div class="reviews-track" id="reviews-track">
        {reviews.map((r, i) => (
          <article
            class={`review-card ${i === 2 ? "review-card--center" : ""}`}
            data-index={i}
            aria-label={`Review by ${r.name}`}
          >
            <div class="review-stars" aria-hidden="true">
              {"★★★★★".split("").map((_, si) => (
                <span class={si < r.rating ? "star-on" : "star-off"}>★</span>
              ))}
            </div>
            <span class="review-service-badge">{r.service}</span>
            <blockquote class="review-text">"{r.text}"</blockquote>
            <footer class="review-footer">
              <div class="reviewer-avatar" style={`background:${r.color}; color:${r.textColor}`}>
                {r.initials}
              </div>
              <div class="reviewer-info">
                <strong class="reviewer-name">{r.name}</strong>
                <div class="reviewer-meta">
                  {r.verified && <span class="verified-badge">✓ Verified Google Review</span>}
                  <span class="review-time"> • {r.timeAgo}</span>
                </div>
              </div>
            </footer>
          </article>
        ))}
      </div>
    </div>

    <!-- Controls -->
    <div class="reviews-controls" aria-label="Review navigation">
      <button class="rev-nav rev-prev" id="rev-prev" aria-label="Previous review">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <div class="rev-dots" id="rev-dots" role="tablist">
        {reviews.map((_, i) => (
          <button class={`rev-dot ${i === 2 ? "active" : ""}`} data-dot={i} role="tab" aria-label={`Go to review ${i + 1}`} aria-selected={i === 2 ? "true" : "false"}></button>
        ))}
      </div>
      <button class="rev-nav rev-next" id="rev-next" aria-label="Next review">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>

    <div class="reviews-cta text-center">
      <a
        href="https://www.google.com/maps/search/Taxi+Services+in+Ajmer"
        target="_blank"
        rel="noopener noreferrer"
        class="view-google-btn"
        aria-label="View all reviews on Google"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
        View All 200+ Google Reviews →
      </a>
    </div>
  </div>
</section>

<script>
  function initReviews() {
    const track = document.getElementById("reviews-track");
    const dots = document.querySelectorAll<HTMLButtonElement>(".rev-dot");
    const prevBtn = document.getElementById("rev-prev");
    const nextBtn = document.getElementById("rev-next");
    const cards = document.querySelectorAll<HTMLElement>(".review-card");

    if (!track || cards.length === 0) return;

    let current = 2; // start center
    const total = cards.length;

    function update(idx: number) {
      current = ((idx % total) + total) % total;
      cards.forEach((card, i) => {
        card.classList.remove("review-card--center", "review-card--left1", "review-card--left2", "review-card--right1", "review-card--right2", "review-card--hidden");
        const offset = ((i - current + total) % total);
        if (offset === 0) card.classList.add("review-card--center");
        else if (offset === 1) card.classList.add("review-card--right1");
        else if (offset === 2) card.classList.add("review-card--right2");
        else if (offset === total - 1) card.classList.add("review-card--left1");
        else if (offset === total - 2) card.classList.add("review-card--left2");
        else card.classList.add("review-card--hidden");
      });
      dots.forEach((d, i) => {
        d.classList.toggle("active", i === current);
        d.setAttribute("aria-selected", i === current ? "true" : "false");
      });
    }

    prevBtn?.addEventListener("click", () => update(current - 1));
    nextBtn?.addEventListener("click", () => update(current + 1));
    dots.forEach((dot, i) => dot.addEventListener("click", () => update(i)));

    // Touch/swipe
    let startX = 0;
    track.addEventListener("touchstart", (e) => { startX = e.touches[0].clientX; }, { passive: true });
    track.addEventListener("touchend", (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) dx > 0 ? update(current - 1) : update(current + 1);
    });

    // Auto advance
    let timer = setInterval(() => update(current + 1), 5500);
    track.addEventListener("mouseenter", () => clearInterval(timer));
    track.addEventListener("mouseleave", () => { timer = setInterval(() => update(current + 1), 5500); });

    update(current);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initReviews);
  } else {
    initReviews();
  }
  document.addEventListener("astro:page-load", initReviews);
</script>

<style>
  .reviews-section {
    padding: 60px 0;
    background: var(--color-cream);
    overflow: hidden;
  }

  .reviews-header {
    margin-bottom: 40px;
  }

  .reviews-pill {
    display: inline-block;
    background: var(--color-primary);
    color: var(--color-accent-light);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 4px 16px;
    border-radius: var(--radius-full);
    margin-bottom: 12px;
  }

  .reviews-title {
    font-family: var(--font-heading);
    font-size: clamp(1.625rem, 3vw, 2.25rem);
    color: var(--color-primary);
    margin-bottom: 8px;
  }

  .reviews-sub {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    max-width: 520px;
    margin: 0 auto 16px;
  }

  .overall-rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .rating-num {
    font-family: var(--font-heading);
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1;
  }

  .stars-row { display: flex; gap: 2px; }
  .star-filled { color: #F59E0B; font-size: 1.25rem; }

  .rating-count {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  /* ── Fan Carousel ── */
  .reviews-track-wrap {
    position: relative;
    height: 340px;
    margin: 0 auto 24px;
    max-width: 1100px;
  }

  .reviews-track {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .review-card {
    position: absolute;
    width: 340px;
    background: #FFFFFF;
    border-radius: 18px;
    padding: 24px;
    box-shadow: 0 8px 32px rgba(34, 24, 28, 0.1);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 10px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.7) translateX(0px);
    opacity: 0;
    pointer-events: none;
    transition: all 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: transform, opacity;
  }

  .review-card--center {
    transform: translate(-50%, -50%) scale(1) translateX(0px);
    opacity: 1;
    z-index: 10;
    pointer-events: auto;
    box-shadow: 0 16px 48px rgba(90, 12, 26, 0.18);
    border-color: var(--color-accent);
  }

  .review-card--left1 {
    transform: translate(-50%, -50%) scale(0.85) translateX(-320px) rotate(-6deg);
    opacity: 0.75;
    z-index: 5;
    pointer-events: auto;
  }

  .review-card--left2 {
    transform: translate(-50%, -50%) scale(0.72) translateX(-560px) rotate(-12deg);
    opacity: 0.4;
    z-index: 2;
    pointer-events: none;
  }

  .review-card--right1 {
    transform: translate(-50%, -50%) scale(0.85) translateX(320px) rotate(6deg);
    opacity: 0.75;
    z-index: 5;
    pointer-events: auto;
  }

  .review-card--right2 {
    transform: translate(-50%, -50%) scale(0.72) translateX(560px) rotate(12deg);
    opacity: 0.4;
    z-index: 2;
    pointer-events: none;
  }

  .review-card--hidden {
    opacity: 0;
    pointer-events: none;
    z-index: 0;
  }

  .review-stars { display: flex; gap: 3px; }
  .star-on { color: #F59E0B; font-size: 1.125rem; }
  .star-off { color: #E5E7EB; font-size: 1.125rem; }

  .review-service-badge {
    display: inline-block;
    background: rgba(90, 12, 26, 0.08);
    color: var(--color-primary);
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    padding: 2px 10px;
    border-radius: var(--radius-full);
    width: fit-content;
  }

  .review-text {
    font-size: 0.875rem;
    color: var(--color-text);
    line-height: 1.65;
    font-style: italic;
    margin: 0;
    flex: 1;
  }

  .review-footer {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--color-border);
  }

  .reviewer-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 0.8125rem;
    flex-shrink: 0;
  }

  .reviewer-name {
    display: block;
    font-size: 0.875rem;
    color: var(--color-text);
    font-weight: 700;
  }

  .reviewer-meta {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 2px;
    flex-wrap: wrap;
  }

  .verified-badge {
    color: #059669;
    font-weight: 700;
  }

  /* Controls */
  .reviews-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 28px;
  }

  .rev-nav {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 2px solid var(--color-border);
    background: #FFF;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .rev-nav svg { width: 18px; height: 18px; }

  .rev-nav:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #FFF;
    transform: scale(1.08);
  }

  .rev-dots { display: flex; gap: 8px; align-items: center; }

  .rev-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-border);
    border: none;
    cursor: pointer;
    transition: all 0.2s;
    padding: 0;
  }

  .rev-dot.active {
    background: var(--color-primary);
    width: 24px;
    border-radius: var(--radius-full);
  }

  /* Google CTA */
  .reviews-cta { margin-top: 4px; }

  .view-google-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #FFF;
    border: 1.5px solid var(--color-border);
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 700;
    padding: 10px 22px;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all 0.2s;
    box-shadow: 0 2px 8px rgba(34, 24, 28, 0.06);
  }

  .view-google-btn:hover {
    border-color: var(--color-accent);
    box-shadow: 0 4px 16px rgba(34, 24, 28, 0.12);
    transform: translateY(-2px);
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .reviews-section { padding: 40px 0; }
    .reviews-track-wrap { height: 380px; }

    .review-card {
      width: min(300px, 85vw);
      padding: 18px;
    }

    .review-card--left1 {
      transform: translate(-50%, -50%) scale(0.82) translateX(-200px) rotate(-5deg);
      opacity: 0.55;
    }

    .review-card--left2 {
      transform: translate(-50%, -50%) scale(0.65) translateX(-340px) rotate(-10deg);
      opacity: 0.2;
    }

    .review-card--right1 {
      transform: translate(-50%, -50%) scale(0.82) translateX(200px) rotate(5deg);
      opacity: 0.55;
    }

    .review-card--right2 {
      transform: translate(-50%, -50%) scale(0.65) translateX(340px) rotate(10deg);
      opacity: 0.2;
    }
  }
</style>
