---
import type { RouteItem } from "@/data/routes";
import { createWhatsAppBookingUrl } from "@/utils/whatsapp";

export interface Props {
  route: RouteItem;
}

const { route } = Astro.props;

const whatsappUrl = createWhatsAppBookingUrl({
  pickup: route.from,
  destination: route.to,
  vehicle: "Sedan"
});
---

<article class="route-card" id={`route-${route.id}`}>
  <div class="route-header">
    <div class="route-cities">
      <span class="city-name">{route.from}</span>
      <span class="route-arrow">➔</span>
      <span class="city-name">{route.to}</span>
    </div>
    {route.popular && <span class="badge-hot">Popular Route</span>}
  </div>

  <div class="route-meta">
    <div class="meta-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <span>{route.estimatedTime}</span>
    </div>
    <div class="meta-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
      <span>{route.distanceKm} km</span>
    </div>
  </div>

  <p class="route-desc">{route.description}</p>

  <!-- Route Highlights -->
  {route.highlights && route.highlights.length > 0 && (
    <ul class="route-highlights" role="list">
      {route.highlights.slice(0, 3).map((h) => (
        <li role="listitem">✓ {h}</li>
      ))}
    </ul>
  )}

  <div class="route-pricing-row">
    <div class="pricing-info">
      <span class="price-prefix">Starting at</span>
      <div class="price-val-wrap">
        <span class="price-val">₹{route.pricing.startingPrice ? route.pricing.startingPrice.toLocaleString("en-IN") : "Ask"}</span>
        <span class="price-type">/ one-way</span>
      </div>
    </div>

    <div class="route-actions">
      {route.hasDedicatedPage && (
        <a href={`/${route.slug}/`} class="btn btn--outline-primary btn--sm" aria-label={`View details for ${route.title}`}>
          Route Info
        </a>
      )}
      <a 
        href={whatsappUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn btn--primary btn--sm"
        aria-label={`Book ${route.title} on WhatsApp`}
      >
        Book Cab
      </a>
    </div>
  </div>
</article>

<style>
  .route-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 20px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 16px rgba(34, 24, 28, 0.05);
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
  }

  .route-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(34, 24, 28, 0.12);
    border-color: var(--color-accent);
  }

  .route-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-bottom: var(--space-xs);
    flex-wrap: wrap;
  }

  .route-cities {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .route-arrow {
    color: var(--color-accent);
    font-size: 1rem;
  }

  .badge-hot {
    background: rgba(197, 155, 39, 0.15);
    color: var(--color-primary);
    border: 1px solid var(--color-accent);
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .route-meta {
    display: flex;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
    padding-bottom: var(--space-xs);
    border-bottom: 1px dashed var(--color-border);
    flex-wrap: wrap;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .meta-item svg {
    width: 14px;
    height: 14px;
    color: var(--color-accent);
  }

  .route-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: var(--space-sm);
    flex: 1;
  }

  .route-highlights {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-md) 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.78125rem;
    color: var(--color-text);
  }

  .route-pricing-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: auto;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
    gap: 12px;
  }

  .price-prefix {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    display: block;
  }

  .price-val-wrap {
    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  .price-val {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-primary);
  }

  .price-type {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .route-actions {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  @media (max-width: 540px) {
    .route-card {
      padding: 16px 14px;
    }
    .route-cities {
      font-size: 1.125rem;
    }
    .route-pricing-row {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }
    .pricing-info {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .route-actions {
      width: 100%;
      display: grid;
      grid-template-columns: 1fr 1.2fr;
      gap: 8px;
    }
    .route-actions .btn {
      width: 100%;
      text-align: center;
      justify-content: center;
      padding: 9px 8px;
      font-size: 0.8125rem;
    }
  }
</style>
