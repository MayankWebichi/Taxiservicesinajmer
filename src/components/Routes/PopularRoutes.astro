---
import { routes } from "@/data/routes";
import RouteCard from "./RouteCard.astro";

export interface Props {
  limit?: number;
  showAllLink?: boolean;
}

const { limit = 6, showAllLink = true } = Astro.props;
const displayRoutes = routes.slice(0, limit);
---

<section class="popular-routes-section" id="routes-section" aria-label="Popular Outstation Taxi Routes from Ajmer">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-subtitle">Verified Outstation Connectivity</span>
      <h2 class="section-title">Popular Taxi Routes from Ajmer</h2>
      <p class="section-desc">
        Direct one-way and round-trip highway taxi services with verified fixed rates and no hidden surprises. Doorstep pickup anywhere in Ajmer and Pushkar.
      </p>
    </div>

    <div class="routes-grid">
      {displayRoutes.map((r) => (
        <RouteCard route={r} />
      ))}
    </div>

    {showAllLink && (
      <div class="routes-footer-cta text-center">
        <p>Planning a custom multi-destination Rajasthan tour or long-distance journey?</p>
        <a href="/outstation/" class="routes-cta-btn">
          <span>Explore All Outstation Destinations &amp; Per-KM Rates</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .popular-routes-section {
    padding: clamp(36px, 5vw, 56px) 0;
    background-color: #FFFFFF;
  }

  .routes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .routes-footer-cta {
    background: linear-gradient(135deg, #FCF8F0 0%, #FFFFFF 100%);
    border: 1.5px solid var(--color-border);
    padding: 28px 32px;
    border-radius: var(--radius-xl);
    max-width: 680px;
    margin: 0 auto;
    box-shadow: 0 4px 18px rgba(90, 12, 26, 0.05);
    text-align: center;
  }

  .routes-footer-cta p {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin-bottom: 16px;
    font-weight: 600;
  }

  .routes-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: #FFFFFF !important;
    font-weight: 700;
    font-size: 0.9375rem;
    padding: 13px 26px;
    border-radius: var(--radius-full);
    border: 1.5px solid var(--color-accent);
    box-shadow: 0 4px 14px rgba(90, 12, 26, 0.2);
    transition: all 0.25s ease;
    text-decoration: none;
    line-height: 1.2;
  }

  .routes-cta-btn svg {
    color: var(--color-accent-light);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .routes-cta-btn:hover {
    background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-primary) 100%);
    box-shadow: 0 6px 20px rgba(90, 12, 26, 0.3);
    transform: translateY(-2px);
    border-color: #FAD66D;
  }

  .routes-cta-btn:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 1024px) {
    .routes-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 650px) {
    .popular-routes-section {
      padding: 32px 0 8px;
    }
    .routes-grid {
      grid-template-columns: 1fr;
      gap: 14px;
      margin-bottom: 24px;
    }
    .routes-footer-cta {
      padding: 20px 16px;
    }
    .routes-cta-btn {
      width: 100%;
      padding: 12px 16px;
      font-size: 0.875rem;
    }
  }
</style>
