---
export interface Props {
  animation?: "fadeUp" | "slideUp" | "fadeIn" | "scaleIn" | "magnetic";
  delay?: number;
  class?: string;
  id?: string;
  tag?: string;
}

const {
  animation = "fadeUp",
  delay = 0,
  class: className = "",
  id,
  tag = "div"
} = Astro.props;

const Tag = tag as any;
---

<Tag
  class:list={["smooth-motion", `motion-${animation}`, className]}
  id={id}
  style={delay ? `--motion-delay: ${delay}ms;` : undefined}
  data-smooth-motion={animation}
>
  <slot />
</Tag>

<script>
  // SmoothMotion runtime observer
  const initSmoothMotion = () => {
    // Check user preference for motion
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.querySelectorAll(".smooth-motion").forEach((el) => {
        el.classList.add("motion-in-view");
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            // Apply delay if specified
            const delay = el.style.getPropertyValue("--motion-delay");
            if (delay) {
              setTimeout(() => {
                el.classList.add("motion-in-view");
              }, parseInt(delay, 10));
            } else {
              el.classList.add("motion-in-view");
            }
            observer.unobserve(el);
          }
        });
      },
      {
        threshold: 0.12,
        rootMargin: "0px 0px -40px 0px"
      }
    );

    document.querySelectorAll(".smooth-motion:not(.motion-in-view)").forEach((el) => {
      observer.observe(el);
    });

    // Subtle magnetic micro-tilt for elements requesting magnetic hover
    document.querySelectorAll('[data-smooth-motion="magnetic"]').forEach((card) => {
      const el = card as HTMLElement;
      el.addEventListener("mousemove", (e: MouseEvent) => {
        const rect = el.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        el.style.transform = `perspective(1000px) rotateX(${-y * 0.04}deg) rotateY(${x * 0.04}deg) translateY(-4px)`;
      });
      el.addEventListener("mouseleave", () => {
        el.style.transform = "";
      });
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSmoothMotion);
  } else {
    initSmoothMotion();
  }
  document.addEventListener("astro:after-swap", initSmoothMotion);
</script>

<style>
  .smooth-motion {
    will-change: transform, opacity;
    transition-property: transform, opacity, box-shadow;
    transition-duration: 550ms;
    transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Fade Up Animation */
  .motion-fadeUp {
    opacity: 0;
    transform: translateY(28px);
  }

  .motion-fadeUp.motion-in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* Slide Up Animation */
  .motion-slideUp {
    opacity: 0;
    transform: translateY(40px);
  }

  .motion-slideUp.motion-in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* Fade In Animation */
  .motion-fadeIn {
    opacity: 0;
  }

  .motion-fadeIn.motion-in-view {
    opacity: 1;
  }

  /* Scale In Animation */
  .motion-scaleIn {
    opacity: 0;
    transform: scale(0.94);
  }

  .motion-scaleIn.motion-in-view {
    opacity: 1;
    transform: scale(1);
  }

  /* Magnetic / Interactive Card Hover */
  .motion-magnetic {
    opacity: 0;
    transform: translateY(20px);
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1), opacity 500ms ease, box-shadow 300ms ease;
  }

  .motion-magnetic.motion-in-view {
    opacity: 1;
    transform: translateY(0);
  }

  .motion-magnetic.motion-in-view:hover {
    box-shadow: 0 16px 36px rgba(34, 24, 28, 0.14);
  }

  @media (prefers-reduced-motion: reduce) {
    .smooth-motion {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
