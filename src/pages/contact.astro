---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header/Header.astro";
import Footer from "@/components/Footer/Footer.astro";
import WhatsAppBubble from "@/components/WhatsApp/WhatsAppBubble.astro";
import MobileBottomBar from "@/components/MobileBottomBar/MobileBottomBar.astro";
import { business } from "@/data/business";
import { createWhatsAppBookingUrl } from "@/utils/whatsapp";

const pageTitle = "Contact Us | Taxi Services in Ajmer — 24/7 Cab Booking";
const pageDescription = "Contact our 24/7 taxi booking helpline in Ajmer. Call +91 77373 14538 or WhatsApp for instant cab bookings, airport transfers, and outstation inquiries.";
const waUrl = createWhatsAppBookingUrl();
---

<Layout title={pageTitle} description={pageDescription} canonicalPath="/contact/">
  <Header />

  <main id="main-content">
    <section class="page-banner">
      <div class="container text-center">
        <span class="heritage-pill">24/7 Dispatch Support</span>
        <h1 class="page-title">Contact Taxi Services in Ajmer</h1>
        <p class="page-subtitle">Serving Ajmer Since 2008 • Prompt Support &amp; Instant WhatsApp Bookings</p>
      </div>
    </section>

    <section class="contact-section">
      <div class="container">

        <!-- Mobile Direct Contact Bar -->
        <div class="contact-quick-actions">
          <a href={`tel:${business.phone}`} class="c-quick-btn c-quick-btn--call">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
            <span>Call 24/7 Hotline</span>
          </a>
          <a href={waUrl} target="_blank" rel="noopener noreferrer" class="c-quick-btn c-quick-btn--wa">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.288.043.088.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.2.662.589 1.221.77 1.394.856.173.086.275.073.376-.044.101-.116.433-.506.549-.68.116-.174.231-.145.39-.087s1.011.477 1.184.564.289.13.332.203c.043.072.043.419-.101.824z"/></svg>
            <span>WhatsApp Dispatch</span>
          </a>
        </div>

        <div class="contact-grid">
          <!-- Office Info Column -->
          <div class="contact-info-col">
            <span class="section-subtitle">Get in Touch</span>
            <h2 class="contact-heading">Call or WhatsApp Our 24/7 Dispatch Team Anytime</h2>
            <p class="contact-lead">
              Whether you need an immediate cab at the Ajmer Railway Station or want to schedule an airport transfer for next week, our team is available round the clock.
            </p>

            <div class="contact-cards-list">
              <div class="c-card">
                <div class="c-icon">📍</div>
                <div class="c-details">
                  <h4>Service Coverage</h4>
                  <address>
                    24/7 Doorstep Pickup Across Ajmer &amp; Pushkar,<br />
                    Rajasthan, India - 305001
                  </address>
                  <span class="c-subtext">Direct pickup at railway station, hotels &amp; all localities</span>
                </div>
              </div>

              <div class="c-card">
                <div class="c-icon">📞</div>
                <div class="c-details">
                  <h4>Phone &amp; Hotline (24/7)</h4>
                  <p>
                    <a href={`tel:${business.phone}`} class="highlight-link">{business.phoneFormatted}</a>
                  </p>
                  <span class="c-subtext">Instant dispatch &amp; immediate response</span>
                </div>
              </div>

              <div class="c-card">
                <div class="c-icon">💬</div>
                <div class="c-details">
                  <h4>WhatsApp Business</h4>
                  <p>
                    <a href={waUrl} target="_blank" rel="noopener noreferrer" class="highlight-link">+91 77373 14538</a>
                  </p>
                  <span class="c-subtext">Fast quotes, vehicle pictures &amp; booking receipts</span>
                </div>
              </div>

              <div class="c-card">
                <div class="c-icon">✉</div>
                <div class="c-details">
                  <h4>Email Support</h4>
                  <p>
                    <a href={`mailto:${business.email}`} class="highlight-link">{business.email}</a>
                  </p>
                  <span class="c-subtext">For corporate billing and tour partnerships</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Quick WhatsApp Inquiry Box -->
          <div class="contact-form-col">
            <div class="inquiry-form-card">
              <div class="form-header-badge">
                <span class="pulse-dot"></span>
                <span>Direct Fleet Dispatch</span>
              </div>
              <h3 class="form-title">Send a Quick Cab Inquiry</h3>
              <p class="form-sub">Fill this quick form to connect with our dispatch team on WhatsApp.</p>

              <form id="contact-inquiry-form" class="inquiry-form" onsubmit="return false;">
                <div class="form-field">
                  <label for="c-name">Your Full Name</label>
                  <input type="text" id="c-name" class="form-control" placeholder="e.g. Rajesh Kumar" required />
                </div>

                <div class="form-field">
                  <label for="c-phone">Your Mobile Number</label>
                  <input type="tel" id="c-phone" class="form-control" placeholder="e.g. 9876543210" required />
                </div>

                <div class="form-field">
                  <label for="c-service">Service Needed</label>
                  <select id="c-service" class="form-control">
                    <option value="Outstation One-Way">Outstation One-Way Taxi</option>
                    <option value="Round Trip Tour">Round Trip Tour</option>
                    <option value="Airport Transfer">Airport Transfer (Jaipur / Delhi)</option>
                    <option value="Ajmer Sightseeing">Ajmer Sharif &amp; Local Sightseeing</option>
                    <option value="Pushkar Darshan">Pushkar Lake &amp; Brahma Temple</option>
                  </select>
                </div>

                <div class="form-field">
                  <label for="c-details-text">Pickup &amp; Destination Details</label>
                  <textarea id="c-details-text" class="form-control" rows="3" placeholder="e.g. Pickup from Ajmer Station at 10 AM, drop to Jaipur"></textarea>
                </div>

                <button type="button" id="btn-contact-wa" class="btn-contact-wa-submit">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.288.043.088.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.2.662.589 1.221.77 1.394.856.173.086.275.073.376-.044.101-.116.433-.506.549-.68.116-.174.231-.145.39-.087s1.011.477 1.184.564.289.13.332.203c.043.072.043.419-.101.824z"/></svg>
                  <span>Inquire on WhatsApp</span>
                  <span class="btn-arr">&rarr;</span>
                </button>
              </form>
            </div>
          </div>
        </div>

        <!-- Google Map Section -->
        <div class="map-container">
          <div class="map-header">
            <div>
              <h3 class="map-title">Our Service Area — Ajmer &amp; Pushkar</h3>
              <p class="map-sub">Doorstep pickup available across all railway stations, hotels, dargah zones, and residential sectors.</p>
            </div>
            <a href="https://maps.google.com/?q=Ajmer,Rajasthan" target="_blank" rel="noopener noreferrer" class="map-external-link">
              Open in Google Maps &rarr;
            </a>
          </div>
          <div class="map-responsive">
            <iframe 
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d57134.99042296497!2d74.597645!3d26.449895!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x396be6d8fcb7cd01%3A0xc3b8606416f5cffc!2sAjmer%2C%20Rajasthan!5e0!3m2!1sen!2sin!4v1700000000000!5m2!1sen!2sin" 
              width="100%" 
              height="380" 
              style="border:0;" 
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade"
              title="Taxi Services in Ajmer Service Area on Google Maps"
            ></iframe>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppBubble />
  <MobileBottomBar />
</Layout>

<script>
  import { business } from "@/data/business";

  const contactBtn = document.getElementById("btn-contact-wa");
  if (contactBtn) {
    contactBtn.addEventListener("click", () => {
      const name = (document.getElementById("c-name") as HTMLInputElement)?.value.trim() || "Customer";
      const userPhone = (document.getElementById("c-phone") as HTMLInputElement)?.value.trim() || "Not provided";
      const service = (document.getElementById("c-service") as HTMLSelectElement)?.value || "General Inquiry";
      const details = (document.getElementById("c-details-text") as HTMLTextAreaElement)?.value.trim() || "None";

      const message = 
`*New Website Contact Inquiry — Taxi Services in Ajmer*
--------------------------------
• *Name:* ${name}
• *Phone:* ${userPhone}
• *Service:* ${service}
• *Requirements:* ${details}
--------------------------------
Please reply with availability and quote.`;

      const cleanPhone = business.phone.replace(/[^0-9]/g, "");
      const waUrl = `https://wa.me/${cleanPhone}?text=${encodeURIComponent(message)}`;
      window.open(waUrl, "_blank");
    });
  }
</script>

<style>
  .page-banner {
    background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
    color: #FFFFFF;
    padding: calc(var(--header-height, 74px) + 24px) 0 28px;
    border-bottom: 3px solid var(--color-accent);
  }

  .heritage-pill {
    display: inline-block;
    background: rgba(197, 155, 39, 0.2);
    border: 1px solid var(--color-accent);
    color: var(--color-accent-light);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 3px 12px;
    border-radius: var(--radius-full);
    margin-bottom: 10px;
  }

  .page-title {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: #FFFFFF;
    margin-bottom: 6px;
    line-height: 1.2;
  }

  .page-subtitle {
    font-size: clamp(0.9375rem, 2vw, 1.0625rem);
    color: rgba(255, 255, 255, 0.9);
    max-width: 650px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .contact-section {
    padding: var(--space-xl) 0 var(--space-3xl);
    background: #FFFFFF;
  }

  /* Quick Mobile Action Bar */
  .contact-quick-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 24px;
  }

  .c-quick-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    font-weight: 700;
    font-size: 0.875rem;
    text-decoration: none;
    min-height: 48px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .c-quick-btn:active {
    transform: scale(0.98);
  }

  .c-quick-btn--call {
    background: var(--color-primary);
    color: #FFFFFF;
  }

  .c-quick-btn--call:hover {
    background: var(--color-primary-dark);
    color: #FFFFFF;
  }

  .c-quick-btn--wa {
    background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
    color: #FFFFFF;
  }

  .c-quick-btn--wa:hover {
    filter: brightness(1.05);
    color: #FFFFFF;
  }

  @media (min-width: 769px) {
    .contact-quick-actions {
      display: none;
    }
  }

  /* Contact Main Layout */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    margin-bottom: var(--space-2xl);
  }

  @media (min-width: 992px) {
    .contact-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--space-3xl);
      margin-bottom: var(--space-3xl);
    }
  }

  .contact-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 2.8vw, 1.85rem);
    color: var(--color-primary);
    margin-bottom: var(--space-xs);
    line-height: 1.25;
  }

  .contact-lead {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
    margin-bottom: var(--space-lg);
  }

  .contact-cards-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .c-card {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: var(--color-cream);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 14px 16px;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .c-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 4px 12px rgba(90, 12, 26, 0.06);
  }

  .c-icon {
    font-size: 1.25rem;
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    width: 42px;
    height: 42px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .c-details {
    min-width: 0; /* Prevents overflow in flex children */
    flex: 1;
  }

  .c-details h4 {
    font-family: var(--font-heading);
    font-size: 1rem;
    color: var(--color-primary);
    margin-bottom: 2px;
    font-weight: 700;
  }

  .c-details address {
    font-style: normal;
    color: var(--color-text);
    font-size: 0.875rem;
    line-height: 1.45;
    word-break: break-word;
  }

  .c-details p {
    margin: 0;
  }

  .c-subtext {
    font-size: 0.775rem;
    color: var(--color-text-muted);
    display: block;
    margin-top: 3px;
    line-height: 1.35;
  }

  .highlight-link {
    color: var(--color-primary);
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: underline;
    word-break: break-word;
    overflow-wrap: anywhere;
    transition: color var(--transition-fast);
  }

  .highlight-link:hover {
    color: var(--color-accent-dark);
  }

  /* Form Card */
  .inquiry-form-card {
    background: #FFFFFF;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 18px 16px;
    box-shadow: 0 6px 20px rgba(34, 24, 28, 0.06);
  }

  @media (min-width: 640px) {
    .inquiry-form-card {
      padding: var(--space-xl);
    }
  }

  @media (min-width: 992px) {
    .inquiry-form-card {
      padding: var(--space-2xl);
    }
  }

  .form-header-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(90, 12, 26, 0.08);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    margin-bottom: 12px;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 rgba(34, 197, 94, 0.4);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    }
    70% {
      box-shadow: 0 0 0 8px rgba(34, 197, 94, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
    }
  }

  .form-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--color-primary);
    margin-bottom: 4px;
    line-height: 1.3;
  }

  .form-sub {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
    line-height: 1.45;
  }

  .inquiry-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .form-field label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .form-control {
    font-size: 16px; /* Prevents auto-zoom on iOS Safari */
    min-height: 44px;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 8px 12px;
    color: var(--color-text);
    background: var(--color-cream);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    font-family: inherit;
    width: 100%;
    box-sizing: border-box;
  }

  .form-control:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(90, 12, 26, 0.12);
    background: #FFFFFF;
  }

  textarea.form-control {
    min-height: 80px;
    resize: vertical;
  }

  .btn-contact-wa-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    min-height: 48px;
    background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
    color: #FFFFFF;
    font-weight: 700;
    font-size: 0.9375rem;
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.35);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
    margin-top: 6px;
    padding: 10px 16px;
  }

  .btn-contact-wa-submit:hover {
    filter: brightness(1.05);
    box-shadow: 0 6px 18px rgba(37, 211, 102, 0.45);
  }

  .btn-contact-wa-submit:active {
    transform: scale(0.98);
  }

  .btn-arr {
    font-size: 1.1rem;
    transition: transform var(--transition-fast);
  }

  .btn-contact-wa-submit:hover .btn-arr {
    transform: translateX(4px);
  }

  /* Map Container */
  .map-container {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 16px;
    border-radius: var(--radius-xl);
  }

  @media (min-width: 640px) {
    .map-container {
      padding: var(--space-xl);
    }
  }

  .map-header {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: var(--space-md);
  }

  @media (min-width: 640px) {
    .map-header {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .map-title {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    color: var(--color-primary);
    margin-bottom: 4px;
  }

  .map-sub {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.4;
    margin: 0;
  }

  .map-external-link {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: underline;
    white-space: nowrap;
    display: inline-block;
  }

  .map-responsive {
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    height: 260px;
  }

  @media (min-width: 640px) {
    .map-responsive {
      height: 320px;
    }
  }

  @media (min-width: 992px) {
    .map-responsive {
      height: 380px;
    }
  }

  .map-responsive iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
</style>
