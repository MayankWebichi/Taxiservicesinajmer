---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header/Header.astro";
import Footer from "@/components/Footer/Footer.astro";
import FAQ from "@/components/FAQ/FAQ.astro";
import WhatsAppBubble from "@/components/WhatsApp/WhatsAppBubble.astro";
import MobileBottomBar from "@/components/MobileBottomBar/MobileBottomBar.astro";
import { business } from "@/data/business";
import { createWhatsAppBookingUrl } from "@/utils/whatsapp";
import { generateServiceSchema, generateFAQSchema } from "@/utils/seo";

const pageTitle = "Ajmer to Sarwar Sharif Taxi | Cab Fare ₹2,000 (Dzire, Ertiga & Crysta)";
const pageDescription = "Book Ajmer to Sarwar Sharif taxi from ₹2,000. AC Sedan (₹2,000), Ertiga (₹2,500), Innova Crysta (₹3,500). Ziyarat of Hazrat Khwaja Fakhruddin Chishti Dargah with wait-time included.";

const waSedan = createWhatsAppBookingUrl({
  pickup: "Ajmer",
  destination: "Sarwar Sharif Dargah",
  vehicle: "Maruti Dzire / Toyota Etios (₹2,000)",
  tripType: "Sarwar Sharif Ziyarat",
  customMessage: "Hello! I want to book an AC Sedan (Dzire/Etios) from Ajmer to Sarwar Sharif Ziyarat @ ₹2,000. Please confirm availability."
});

const waErtiga = createWhatsAppBookingUrl({
  pickup: "Ajmer",
  destination: "Sarwar Sharif Dargah",
  vehicle: "Maruti Ertiga (₹2,500)",
  tripType: "Sarwar Sharif Ziyarat",
  customMessage: "Hello! I want to book a 6-Seater Maruti Ertiga from Ajmer to Sarwar Sharif Ziyarat @ ₹2,500. Please confirm availability."
});

const waCrysta = createWhatsAppBookingUrl({
  pickup: "Ajmer",
  destination: "Sarwar Sharif Dargah",
  vehicle: "Toyota Innova Crysta (₹3,500)",
  tripType: "Sarwar Sharif Ziyarat",
  customMessage: "Hello! I want to book a Toyota Innova Crysta for VIP family travel from Ajmer to Sarwar Sharif Ziyarat @ ₹3,500. Please confirm availability."
});

const waUrbania = createWhatsAppBookingUrl({
  pickup: "Ajmer",
  destination: "Sarwar Sharif Dargah",
  vehicle: "Force Urbania / Tempo Traveller",
  tripType: "Group Pilgrimage",
  customMessage: "Hello! We have a group of pilgrims looking for Force Urbania / Tempo Traveller from Ajmer to Sarwar Sharif Dargah. Please share best package rates."
});

const serviceSchema = generateServiceSchema({
  name: "Ajmer to Sarwar Sharif Taxi Service",
  description: "Dedicated spiritual pilgrimage taxi service from Ajmer to Hazrat Khwaja Fakhruddin Chishti Dargah at Sarwar Sharif (Sarwad). Fixed transparent fares with wait time included for Ziyarat.",
  url: `${business.website}/ajmer-to-sarwar-sharif-taxi/`,
  providerName: business.name,
  providerUrl: business.website,
  price: "2000",
  priceCurrency: "INR"
});

const sarwarFaqs = [
  {
    question: "What is the taxi fare from Ajmer to Sarwar Sharif?",
    answer: "Our fixed fares for Ajmer to Sarwar Sharif Dargah (including Ziyarat wait-time and return) are: Maruti Swift Dzire / Toyota Etios Sedan at ₹2,000; Maruti Ertiga (6-Seater) at ₹2,500; and Toyota Innova Crysta at ₹3,500. No hidden charges.",
    category: "Pricing" as const
  },
  {
    question: "Is driver waiting time included for Dargah Ziyarat?",
    answer: "Yes, our packages include sufficient waiting time (typically 2 to 3 hours) at Sarwar Sharif Dargah so you and your family can comfortably offer prayers, present Chadar Mubarak, perform Dua, and partake in Langar without any rush.",
    category: "General" as const
  },
  {
    question: "How far is Sarwar Sharif from Ajmer and how long does the drive take?",
    answer: "Sarwar Sharif (also called Sarwad) is approximately 62 km southeast of Ajmer city via the Nasirabad - Kekri highway corridor. The drive takes around 1 hour 15 minutes to 1.5 hours in a comfortable AC cab.",
    category: "Routes" as const
  },
  {
    question: "Can I get picked up directly from Ajmer Railway Station or Dargah hotel?",
    answer: "Yes, we provide 24/7 doorstep pickup anywhere in Ajmer — including Ajmer Junction Railway Station, Dargah Bazaar hotels, Pushkar Road, and residential colonies. You can step directly into your private AC cab upon arrival.",
    category: "Booking" as const
  },
  {
    question: "What is the spiritual significance of Sarwar Sharif?",
    answer: "Sarwar Sharif is the sacred resting place of Hazrat Khwaja Syed Fakhruddin Chishti (R.A.), the eldest son of Hazrat Khwaja Moinuddin Hasan Chishti (Gharib Nawaz R.A.). Devotees visiting Ajmer Sharif consider their spiritual journey complete with a Ziyarat at Sarwar Sharif.",
    category: "General" as const
  },
  {
    question: "Do you have Tempo Travellers or Force Urbania for large pilgrim groups?",
    answer: "Yes! For large family groups, Urs delegations, or pilgrim groups, we provide 13-seater, 17-seater, and 26-seater Tempo Travellers as well as luxury Maharaja Force Urbania vans at competitive group rates.",
    category: "Booking" as const
  }
];

const faqSchema = generateFAQSchema(sarwarFaqs);
---

<Layout 
  title={pageTitle} 
  description={pageDescription} 
  canonicalPath="/ajmer-to-sarwar-sharif-taxi/"
  schemaMarkup={serviceSchema}
>
  <Header />

  <main id="main-content">
    <!-- Hero Banner -->
    <section class="route-hero sarwar-hero">
      <div class="container text-center">
        <span class="heritage-pill">Sacred Sufi Pilgrimage Route • 62 KM</span>
        <h1 class="route-title">Ajmer to Sarwar Sharif Taxi Service</h1>
        <p class="route-subtitle">
          Direct AC Cab to Hazrat Khwaja Syed Fakhruddin Chishti Dargah • Ziyarat Wait-Time Included • 24/7 Doorstep Pickup
        </p>

        <div class="hero-fare-pills">
          <div class="h-pill">Dzire / Etios: <strong>₹2,000</strong></div>
          <div class="h-pill gold">Ertiga 6-Seater: <strong>₹2,500</strong></div>
          <div class="h-pill">Innova Crysta: <strong>₹3,500</strong></div>
        </div>

        <div class="hero-cta-btns">
          <a href={waSedan} target="_blank" rel="noopener noreferrer" class="btn btn--gold btn--lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.087-.178.181-.077.355.101.174.449.741.964 1.2.662.591 1.221.774 1.394.861.173.087.275.072.376-.044.101-.116.433-.506.549-.68.116-.174.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.044.073.044.42-.1 1.016z"/></svg>
            Book Sarwar Cab on WhatsApp
          </a>
          <a href={`tel:${business.phone}`} class="btn btn--outline-light btn--lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
            Call Helpline: {business.phoneFormatted}
          </a>
        </div>
      </div>
    </section>

    <!-- Main Content & Pricing Grid -->
    <section class="route-content-section">
      <div class="container">
        <div class="route-grid">
          <div class="route-main">
            <!-- Spiritual Introduction -->
            <div class="content-block">
              <span class="section-subtitle">Complete Your Ajmer Sharif Pilgrimage</span>
              <h2 class="section-title">Peaceful &amp; Reverent Cab Service to Sarwar Sharif</h2>
              <p>
                A visit to <strong>Ajmer Sharif Dargah</strong> is widely believed by Sufi devotees and pilgrims to find spiritual completeness with a Ziyarat at the holy shrine of <strong>Hazrat Khwaja Syed Fakhruddin Chishti (R.A.)</strong> at <strong>Sarwar Sharif</strong> (also known as Sarwad).
              </p>
              <p>
                Hazrat Khwaja Fakhruddin Chishti was the venerable eldest son of Hazrat Khwaja Moinuddin Hasan Chishti (Khwaja Gharib Nawaz R.A.). Situated roughly 62 km southeast of Ajmer, the Sarwar Sharif Dargah is an oasis of profound peace, spiritual solace, and answered prayers.
              </p>
              <p>
                Since 2008, <strong>Taxi Services in Ajmer</strong> has served thousands of families, elder pilgrims, and devotee groups traveling between Ajmer and Sarwar Sharif. We offer clean AC cabs, respectful chauffeurs familiar with Ziyarat customs, flexible parking access, and guaranteed round-trip wait-time.
              </p>
            </div>

            <!-- Fixed Pricing Cards -->
            <div class="content-block">
              <h3 class="tier-heading">Verified Transparent Fares (Ajmer ➔ Sarwar Sharif)</h3>
              <p class="tier-subtext">Fixed pricing with doorstep pickup in Ajmer, highway toll assistance, Dargah waiting time, and return journey included.</p>

              <div class="pricing-cards-row">
                <!-- Sedan Card -->
                <div class="p-card">
                  <div class="p-card-top">
                    <span class="p-type">Comfort Sedan</span>
                    <h4 class="p-car">Maruti Dzire / Toyota Etios</h4>
                  </div>
                  <div class="p-image-wrap">
                    <img 
                      src="/images/vehicles/Maruti%20Swift%20Dzire.png" 
                      alt="Maruti Swift Dzire Cab for Sarwar Sharif"
                      width="240"
                      height="140"
                      loading="lazy"
                    />
                  </div>
                  <div class="p-fare">
                    <span class="currency">₹</span>2,000
                    <span class="fare-tag">Fixed Rate</span>
                  </div>
                  <ul class="p-features">
                    <li>✓ 4 Passenger Seats with AC</li>
                    <li>✓ Doorstep Pickup &amp; Drop</li>
                    <li>✓ 2–3 Hours Ziyarat Wait-Time</li>
                    <li>✓ Sanitized Interior &amp; Clean Seats</li>
                    <li>✓ Courteous, Experienced Chauffeur</li>
                  </ul>
                  <a href={waSedan} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--block p-btn">
                    Book Sedan @ ₹2,000
                  </a>
                </div>

                <!-- Ertiga Card (Featured) -->
                <div class="p-card featured-p-card">
                  <div class="card-badge">Most Popular for Families</div>
                  <div class="p-card-top">
                    <span class="p-type gold">Spacious 6-Seater MPV</span>
                    <h4 class="p-car">Maruti Suzuki Ertiga</h4>
                  </div>
                  <div class="p-image-wrap">
                    <img 
                      src="/images/vehicles/Maruti%20Suzuki%20Ertiga.png" 
                      alt="Maruti Suzuki Ertiga for Sarwar Sharif"
                      width="240"
                      height="140"
                      loading="lazy"
                    />
                  </div>
                  <div class="p-fare gold-fare">
                    <span class="currency">₹</span>2,500
                    <span class="fare-tag gold-tag">Best Value</span>
                  </div>
                  <ul class="p-features">
                    <li>✓ 6 Comfortable Passenger Seats</li>
                    <li>✓ Dual Chilled Air Conditioning</li>
                    <li>✓ Ideal for Family &amp; Elder Relatives</li>
                    <li>✓ Ample Space for Chadar &amp; Offerings</li>
                    <li>✓ Complete Round-Trip &amp; Wait-Time</li>
                  </ul>
                  <a href={waErtiga} target="_blank" rel="noopener noreferrer" class="btn btn--gold btn--block p-btn">
                    Book Ertiga @ ₹2,500
                  </a>
                </div>

                <!-- Innova Crysta Card -->
                <div class="p-card">
                  <div class="p-card-top">
                    <span class="p-type">VIP Luxury SUV</span>
                    <h4 class="p-car">Toyota Innova Crysta</h4>
                  </div>
                  <div class="p-image-wrap">
                    <img 
                      src="/images/vehicles/inova%20cresta.png" 
                      alt="Toyota Innova Crysta for Sarwar Sharif"
                      width="240"
                      height="140"
                      loading="lazy"
                    />
                  </div>
                  <div class="p-fare">
                    <span class="currency">₹</span>3,500
                    <span class="fare-tag">VIP Comfort</span>
                  </div>
                  <ul class="p-features">
                    <li>✓ 6/7 Captain Recliner Seats</li>
                    <li>✓ Supreme Highway Ride Quality</li>
                    <li>✓ Maximum Legroom &amp; Rear AC</li>
                    <li>✓ Dedicated Senior Chauffeur</li>
                    <li>✓ Premium Pilgrim Experience</li>
                  </ul>
                  <a href={waCrysta} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--block p-btn">
                    Book Crysta @ ₹3,500
                  </a>
                </div>
              </div>
            </div>

            <!-- Group Travel Options -->
            <div class="group-travel-banner">
              <div class="gt-content">
                <span class="gt-tag">Group Pilgrimage &amp; Urs Jathas</span>
                <h3>Traveling with a Group or Extended Family?</h3>
                <p>
                  We also operate 13-seater, 17-seater, and 26-seater luxury <strong>Tempo Travellers</strong> and <strong>Maharaja Force Urbania</strong> vans with pushback seats, individual AC vents, and large luggage capacity for Sarwar Sharif and multi-day Sufi pilgrimage circuits.
                </p>
              </div>
              <div class="gt-action">
                <a href={waUrbania} target="_blank" rel="noopener noreferrer" class="btn btn--gold">
                  Inquire Tempo / Urbania Rates
                </a>
              </div>
            </div>

            <!-- Pilgrimage Information & Route Highlights -->
            <div class="content-block itinerary-block">
              <h3 class="tier-heading">Everything You Need to Know for Sarwar Sharif Ziyarat</h3>
              <div class="info-grid">
                <div class="info-card">
                  <div class="info-icon">🕌</div>
                  <h4>About the Dargah</h4>
                  <p>
                    Hazrat Khwaja Syed Fakhruddin Chishti (R.A.) was a revered mystic whose shrine is known for spiritual barakah and peace. The serene atmosphere allows pilgrims to sit quietly, make supplications (Dua), and recite Fatiha.
                  </p>
                </div>
                <div class="info-card">
                  <div class="info-icon">⏱️</div>
                  <h4>Timings &amp; Ziyarat Duration</h4>
                  <p>
                    The Dargah remains open throughout the day from early morning after Fajr until late evening after Isha. A typical Ziyarat visit takes between 1.5 to 2.5 hours, including offering Chadar and personal prayer.
                  </p>
                </div>
                <div class="info-card">
                  <div class="info-icon">🛣️</div>
                  <h4>Route &amp; Drive Details</h4>
                  <p>
                    The journey from Ajmer is roughly 62 km via NH48 / Nasirabad bypass and SH26 (Ajmer-Nasirabad-Sarwar road). The highway is well-maintained and smooth, taking approximately 75 to 90 minutes each way.
                  </p>
                </div>
                <div class="info-card">
                  <div class="info-icon">🤝</div>
                  <h4>Same-Day Combo Option</h4>
                  <p>
                    Combine your morning visit to Ajmer Sharif Dargah, proceed after lunch to Sarwar Sharif, and return comfortably in the evening. We can customize the timing to match your prayer schedule.
                  </p>
                </div>
              </div>
            </div>

            <!-- Why Choose Us -->
            <div class="content-block why-choose-block">
              <h3 class="tier-heading">Why Book Your Sarwar Cab with Us?</h3>
              <ul class="reasons-list">
                <li>
                  <strong>✓ Over 18 Years of Experience (Since 2008):</strong> We are locally rooted in Ajmer and have chauffeured thousands of pilgrims with deep respect and care.
                </li>
                <li>
                  <strong>✓ Punctual Doorstep Pickup:</strong> Direct pickup from Ajmer Junction, hotel gates, or guest houses. No walking with heavy bags in crowded areas.
                </li>
                <li>
                  <strong>✓ Zero Price Haggling:</strong> Guaranteed fixed rates confirmed upfront (Dzire ₹2,000 | Ertiga ₹2,500 | Crysta ₹3,500). No sudden price increases upon arrival.
                </li>
                <li>
                  <strong>✓ Safe for Elderly &amp; Women Travelers:</strong> Our drivers are polite, background-checked, non-smoking, and accustomed to assisting elderly family members.
                </li>
              </ul>
            </div>
          </div>

          <!-- Sticky Sidebar -->
          <aside class="route-sidebar">
            <div class="sidebar-box booking-quick-box">
              <h3 class="side-title">Quick Booking Summary</h3>
              <div class="route-quick-specs">
                <div class="spec-row">
                  <span class="label">From:</span>
                  <span class="val">Ajmer City / Railway Station</span>
                </div>
                <div class="spec-row">
                  <span class="label">To:</span>
                  <span class="val">Sarwar Sharif Dargah</span>
                </div>
                <div class="spec-row">
                  <span class="label">Distance:</span>
                  <span class="val">~62 km (One-Way)</span>
                </div>
                <div class="spec-row">
                  <span class="label">Drive Time:</span>
                  <span class="val">~1 Hour 20 Mins</span>
                </div>
                <div class="spec-row">
                  <span class="label">Trip Type:</span>
                  <span class="val">Round Trip with Wait-Time</span>
                </div>
              </div>

              <div class="side-fare-summary">
                <div class="fare-row">
                  <span>Dzire / Etios Sedan</span>
                  <strong>₹2,000</strong>
                </div>
                <div class="fare-row highlight">
                  <span>Maruti Ertiga (6-Seater)</span>
                  <strong>₹2,500</strong>
                </div>
                <div class="fare-row">
                  <span>Toyota Innova Crysta</span>
                  <strong>₹3,500</strong>
                </div>
              </div>

              <div class="side-cta-stack">
                <a href={waSedan} target="_blank" rel="noopener noreferrer" class="btn btn--gold btn--block">
                  Book on WhatsApp
                </a>
                <a href={`tel:${business.phone}`} class="btn btn--outline-dark btn--block">
                  Call: {business.phoneFormatted}
                </a>
              </div>
            </div>

            <!-- Pilgrimage Tips Widget -->
            <div class="sidebar-box tips-box">
              <h4 class="tips-title">Pilgrim Ziyarat Tips</h4>
              <ul class="tips-list">
                <li>• Chadar, flowers, and sweets can be arranged at the local market near the Dargah entrance.</li>
                <li>• Modest dress code and head covering is required for entering the shrine.</li>
                <li>• Weekends and Urs festival dates see higher pilgrim footfalls; advance taxi reservation is recommended.</li>
              </ul>
            </div>

            <!-- Interlinked Popular Routes -->
            <div class="sidebar-box routes-box">
              <h4 class="tips-title">Other Popular Pilgrim Routes</h4>
              <ul class="sidebar-links">
                <li><a href="/dargah-taxi-ajmer/">→ Ajmer Sharif Local Dargah Taxi</a></li>
                <li><a href="/ajmer-to-pushkar-taxi/">→ Ajmer to Pushkar Brahma Temple (₹700)</a></li>
                <li><a href="/tours/">→ Complete Rajasthan Tour Packages</a></li>
                <li><a href="/wedding-logistics/">→ Wedding Transportation &amp; Fleet</a></li>
              </ul>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="sarwar-faq-section">
      <div class="container">
        <div class="section-header text-center">
          <span class="section-subtitle">Got Questions?</span>
          <h2 class="section-title">Ajmer to Sarwar Sharif Cab FAQs</h2>
          <p class="section-desc">Clear answers to help you plan your pilgrimage journey smoothly.</p>
        </div>

        <div class="faq-accordion-list">
          {sarwarFaqs.map((faq, idx) => (
            <details class="faq-item" id={`faq-${idx}`}>
              <summary class="faq-question">
                <span>{faq.question}</span>
                <svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <div class="faq-answer">
                <p>{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Bottom Pre-Footer CTA -->
    <section class="bottom-cta-banner">
      <div class="container text-center">
        <h2>Planning Your Sacred Ziyarat to Sarwar Sharif?</h2>
        <p>Book your verified AC cab with doorstep pickup anywhere in Ajmer. Clean cars, polite chauffeurs, and transparent fixed fares.</p>
        <div class="bottom-cta-row">
          <a href={waSedan} target="_blank" rel="noopener noreferrer" class="btn btn--gold btn--lg">
            Book Dzire @ ₹2,000 on WhatsApp
          </a>
          <a href={`tel:${business.phone}`} class="btn btn--outline-light btn--lg">
            Call Operator: {business.phoneFormatted}
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppBubble />
  <MobileBottomBar />
</Layout>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  .sarwar-hero {
    background: linear-gradient(135deg, #1A1215 0%, #2D1D24 50%, #442430 100%);
    color: #FFFFFF;
    padding: calc(var(--header-height, 74px) + 40px) 0 44px;
    border-bottom: 3px solid var(--color-accent);
  }

  .heritage-pill {
    display: inline-block;
    background: rgba(197, 155, 39, 0.2);
    border: 1px solid var(--color-accent);
    color: var(--color-accent-light);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 6px 16px;
    border-radius: var(--radius-full);
    margin-bottom: 14px;
  }

  .route-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4.5vw, 3rem);
    color: #FFFFFF;
    margin-bottom: 12px;
    line-height: 1.2;
  }

  .route-subtitle {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.9);
    max-width: 780px;
    margin: 0 auto 24px;
    line-height: 1.6;
  }

  .hero-fare-pills {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  .h-pill {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #FFFFFF;
    padding: 8px 18px;
    border-radius: var(--radius-full);
    font-size: 0.9375rem;
  }

  .h-pill strong {
    color: var(--color-accent-light);
    margin-left: 4px;
  }

  .h-pill.gold {
    background: rgba(197, 155, 39, 0.25);
    border-color: var(--color-accent);
  }

  .hero-cta-btns {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .route-content-section {
    padding: var(--space-4xl) 0;
    background: var(--color-surface);
  }

  .route-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: var(--space-3xl);
    align-items: start;
  }

  .content-block {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-2xl);
    margin-bottom: var(--space-2xl);
    box-shadow: 0 4px 16px rgba(34, 24, 28, 0.04);
  }

  .content-block p {
