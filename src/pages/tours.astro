---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header/Header.astro";
import Footer from "@/components/Footer/Footer.astro";
import Destinations from "@/components/Destinations/Destinations.astro";
import FAQ from "@/components/FAQ/FAQ.astro";
import WhatsAppBubble from "@/components/WhatsApp/WhatsAppBubble.astro";
import MobileBottomBar from "@/components/MobileBottomBar/MobileBottomBar.astro";
import { createWhatsAppBookingUrl } from "@/utils/whatsapp";

const pageTitle = "Ajmer & Pushkar Tour Packages | Sightseeing Cabs (Since 2008)";
const pageDescription = "Explore Ajmer Sharif Dargah, Pushkar Lake, Brahma Temple & Rajasthan circuits with our guided chauffeur tour packages. Flexible itineraries, clean AC cabs & transparent rates.";

const waAjmerTour = createWhatsAppBookingUrl({ tripType: "1 Day Ajmer Dargah Darshan", pickup: "Ajmer" });
const waPushkarTour = createWhatsAppBookingUrl({ tripType: "1 Day Pushkar Pilgrimage Tour", pickup: "Ajmer" });
const waCombinedTour = createWhatsAppBookingUrl({ tripType: "2 Days Ajmer + Pushkar Combo Tour", pickup: "Ajmer" });
const waUrsTour = createWhatsAppBookingUrl({ tripType: "3 Days Ajmer Urs Special Package", pickup: "Ajmer" });
const waGoldenTriangle = createWhatsAppBookingUrl({ tripType: "5 Days Golden Triangle + Pushkar Tour", pickup: "Ajmer" });
const waRajasthanTour = createWhatsAppBookingUrl({ tripType: "7 Days Rajasthan Heritage Tour", pickup: "Ajmer" });
---

<Layout title={pageTitle} description={pageDescription} canonicalPath="/tours/">
  <Header />

  <main id="main-content">
    <section class="page-banner">
      <div class="container text-center">
        <span class="heritage-pill">Guided Pilgrimage &amp; Sightseeing</span>
        <h1 class="page-title">Ajmer &amp; Pushkar Tour Packages</h1>
        <p class="page-subtitle">Curated Day Tours, Spiritual Pilgrimages, and Multi-Day Rajasthan Road Trips</p>
      </div>
    </section>

    <!-- Popular Tour Packages -->
    <section class="tours-section">
      <div class="container">
        <div class="section-header text-center">
          <span class="section-subtitle">Handcrafted Itineraries</span>
          <h2 class="section-title">Featured Sightseeing &amp; Tour Packages</h2>
          <p class="section-desc">Doorstep hotel and railway station pickup in Ajmer with experienced local chauffeurs.</p>
        </div>

        <div class="tours-grid">
          <!-- Tour 1: 1 Day Ajmer Dargah Darshan -->
          <div class="tour-card">
            <div class="tour-badge">Full Day / 8 Hours</div>
            <h3 class="tour-title">1 Day Ajmer Dargah Darshan &amp; City Heritage</h3>
            <p class="tour-desc">A spiritual and historical immersion covering the ancient Chauhan capital and the revered Sufi sanctuary.</p>
            <ul class="tour-stops">
              <li>📍 Hazrat Khwaja Moinuddin Chishti Dargah</li>
              <li>📍 Adhai Din Ka Jhopra 12th-century monument</li>
              <li>📍 Ana Sagar Lake &amp; Daulat Bagh marble pavilions</li>
              <li>📍 Taragarh Hill Fort panoramic viewpoint</li>
              <li>📍 Nareli Jain Temple &amp; local bazaars</li>
            </ul>
            <div class="tour-footer">
              <span class="tour-price">Starts at ₹1,500</span>
              <a href={waAjmerTour} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--sm">
                Book Tour
              </a>
            </div>
          </div>

          <!-- Tour 2: 1 Day Pushkar Pilgrimage -->
          <div class="tour-card">
            <div class="tour-badge">Full Day Tour</div>
            <h3 class="tour-title">1 Day Pushkar Pilgrimage &amp; Ghats Tour</h3>
            <p class="tour-desc">Journey through the scenic Nagpahari pass to one of the world's holiest pilgrimage towns nestled beside the sacred lake.</p>
            <ul class="tour-stops">
              <li>📍 14th-Century Jagatpita Brahma Temple</li>
              <li>📍 52 Sacred Bathing Ghats of Pushkar Lake</li>
              <li>📍 Savitri Devi Temple hill ropeway</li>
              <li>📍 Varaha Temple &amp; Old Rangji Temple</li>
              <li>📍 Pushkar Camel grounds &amp; Sunset aarti</li>
            </ul>
            <div class="tour-footer">
              <span class="tour-price">Starts at ₹1,800</span>
              <a href={waPushkarTour} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--sm">
                Book Tour
              </a>
            </div>
          </div>

          <!-- Tour 3: 2 Days Ajmer + Pushkar Combo -->
          <div class="tour-card featured-tour">
            <div class="tour-badge gold-badge">Most Popular • 2 Days</div>
            <h3 class="tour-title">2 Days Ajmer + Pushkar Combo Tour</h3>
            <p class="tour-desc">Both sacred cities in one comprehensive package for pilgrims, families, and weekend travelers.</p>
            <ul class="tour-stops">
              <li>📍 Day 1: Ajmer Sharif Dargah Ziyarat, Ana Sagar, Taragarh</li>
              <li>📍 Day 2: Pushkar Brahma Temple, 52 Ghats, Desert Sunset</li>
              <li>📍 Station/hotel pickup &amp; drops included</li>
              <li>📍 Dedicated AC cab for entire itinerary</li>
              <li>📍 Chauffeur with deep local route expertise</li>
            </ul>
            <div class="tour-footer">
              <span class="tour-price">Starts at ₹3,500</span>
              <a href={waCombinedTour} target="_blank" rel="noopener noreferrer" class="btn btn--gold btn--sm">
                Book Combo Tour
              </a>
            </div>
          </div>

          <!-- Tour 4: 3 Days Ajmer Urs Special -->
          <div class="tour-card">
            <div class="tour-badge">3 Days / Festival Special</div>
            <h3 class="tour-title">3 Days Ajmer Urs &amp; Sufi Pilgrimage</h3>
            <p class="tour-desc">Special spiritual Urs festival package with dedicated cab and driver on standby for prayer schedules.</p>
            <ul class="tour-stops">
              <li>📍 Multiple visits to Dargah Sharif during festival timings</li>
              <li>📍 Ziyarat support and verified local parking assistance</li>
              <li>📍 Pushkar Brahma Temple excursion included</li>
              <li>📍 Full 3 days dedicated chauffeur &amp; AC vehicle</li>
              <li>📍 24/7 on-call dispatch support</li>
            </ul>
            <div class="tour-footer">
              <span class="tour-price">Starts at ₹5,999</span>
              <a href={waUrsTour} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--sm">
                Book Urs Package
              </a>
            </div>
          </div>

          <!-- Tour 5: 5 Days Golden Triangle + Pushkar -->
          <div class="tour-card">
            <div class="tour-badge">5 Days Circuit</div>
            <h3 class="tour-title">5 Days Golden Triangle + Pushkar Tour</h3>
            <p class="tour-desc">Delhi – Agra – Jaipur – Ajmer – Pushkar world-famous heritage circuit in a private luxury cab.</p>
            <ul class="tour-stops">
              <li>📍 Taj Mahal &amp; Agra Fort in Agra</li>
              <li>📍 Amer Fort, Hawa Mahal &amp; City Palace in Jaipur</li>
              <li>📍 Ajmer Sharif Dargah &amp; Pushkar Holy Lake</li>
              <li>📍 Intercity toll, state permits &amp; fuel included</li>
              <li>📍 Airport or railway station pickup / drop</li>
            </ul>
            <div class="tour-footer">
              <span class="tour-price">Starts at ₹12,999</span>
              <a href={waGoldenTriangle} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--sm">
                Book 5-Day Circuit
              </a>
            </div>
          </div>

          <!-- Tour 6: 7 Days Rajasthan Heritage Tour -->
          <div class="tour-card">
            <div class="tour-badge">7 Days Grand Tour</div>
            <h3 class="tour-title">7 Days Complete Rajasthan Heritage Tour</h3>
            <p class="tour-desc">Comprehensive road trip covering Jaipur, Ajmer, Pushkar, Jodhpur, and Udaipur with verified private chauffeur.</p>
            <ul class="tour-stops">
              <li>📍 Pink City Jaipur (Amer, Nahargarh, City Palace)</li>
              <li>📍 Ajmer Sharif &amp; Sacred Pushkar Ghats</li>
              <li>📍 Blue City Jodhpur (Mehrangarh &amp; Umaid Bhawan)</li>
              <li>📍 City of Lakes Udaipur (Lake Pichola &amp; City Palace)</li>
              <li>📍 Dedicated AC car with seasoned highway chauffeur</li>
            </ul>
            <div class="tour-footer">
              <span class="tour-price">Starts at ₹19,999</span>
              <a href={waRajasthanTour} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--sm">
                Book Grand Tour
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Destinations Visual Grid -->
    <Destinations limit={6} />

    <!-- FAQ -->
    <FAQ 
      title="Sightseeing &amp; Tour FAQs" 
      subtitle="Planning Your Ajmer Trip" 
    />
  </main>

  <Footer />
  <WhatsAppBubble />
  <MobileBottomBar />
</Layout>

<style>
  .page-banner {
    background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
    color: #FFFFFF;
    padding: calc(var(--header-height, 74px) + 38px) 0 36px;
    border-bottom: 3px solid var(--color-accent);
  }

  .heritage-pill {
    display: inline-block;
    background: rgba(197, 155, 39, 0.2);
    border: 1px solid var(--color-accent);
    color: var(--color-accent-light);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 4px 14px;
    border-radius: var(--radius-full);
    margin-bottom: 12px;
  }

  .page-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 2.75rem);
    color: #FFFFFF;
    margin-bottom: 6px;
  }

  .page-subtitle {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.9);
    max-width: 650px;
    margin: 0 auto;
  }

  .tours-section {
    padding: var(--space-4xl) 0;
    background: var(--color-surface);
  }

  .tours-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }

  .tour-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 16px rgba(34, 24, 28, 0.05);
    position: relative;
  }

  .featured-tour {
    border: 2px solid var(--color-accent);
    box-shadow: 0 8px 24px rgba(197, 155, 39, 0.15);
  }

  .tour-badge {
    position: absolute;
    top: 14px;
    right: 14px;
    background: var(--color-cream);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }

  .gold-badge {
    background: var(--color-accent);
    color: #FFFFFF;
    border: none;
  }

  .tour-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--color-primary);
    margin-top: var(--space-md);
    margin-bottom: var(--space-xs);
  }

  .tour-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: var(--space-md);
  }

  .tour-stops {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-xl) 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.8125rem;
    color: var(--color-text);
    flex: 1;
  }

  .tour-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .tour-price {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  @media (max-width: 992px) {
    .tours-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
