---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header/Header.astro";
import Footer from "@/components/Footer/Footer.astro";
import Destinations from "@/components/Destinations/Destinations.astro";
import FAQ from "@/components/FAQ/FAQ.astro";
import WhatsAppBubble from "@/components/WhatsApp/WhatsAppBubble.astro";
import MobileBottomBar from "@/components/MobileBottomBar/MobileBottomBar.astro";
import { business } from "@/data/business";
import { createWhatsAppBookingUrl } from "@/utils/whatsapp";
import { generateServiceSchema, generateFAQSchema } from "@/utils/seo";

const pageTitle = "Rajasthan Tour Packages & Ajmer Sightseeing Cabs | Best Rates (2026)";
const pageDescription = "Handcrafted Rajasthan tour packages & Ajmer sightseeing cabs since 2008. Ajmer Sharif, Pushkar, Jaipur, Udaipur, Jodhpur, Jaisalmer & Golden Triangle circuits. AC Sedans, Ertiga, Innova Crysta & Urbania.";

// WhatsApp Pre-filled links
const waCustomTour = createWhatsAppBookingUrl({ 
  tripType: "Custom Rajasthan Tour Package", 
  pickup: "Ajmer / Pushkar / Jaipur",
  customMessage: "Hello! I am planning a Rajasthan tour package and would like a customized itinerary and taxi quotation. My travel dates and group details are:"
});

const waAjmerTour = createWhatsAppBookingUrl({ 
  tripType: "1 Day Ajmer Dargah & Heritage Tour", 
  pickup: "Ajmer",
  customMessage: "Hello! I want to book 1 Day Ajmer Dargah & City Sightseeing Cab (₹2,500 Full Day / ₹1,500 Half Day). Please share availability."
});

const waPushkarTour = createWhatsAppBookingUrl({ 
  tripType: "1 Day Pushkar Pilgrimage & Desert Tour", 
  pickup: "Ajmer / Pushkar",
  customMessage: "Hello! I want to book 1 Day Pushkar Pilgrimage & Desert Sightseeing Cab. Please share fare and booking details."
});

const waSarwarCombo = createWhatsAppBookingUrl({ 
  tripType: "Ajmer + Sarwar Sharif Sufi Ziyarat Combo", 
  pickup: "Ajmer",
  customMessage: "Hello! I want to book the Same-Day Ajmer Sharif + Sarwar Sharif Sufi Ziyarat Combo Cab (from ₹2,800). Please share vehicle availability."
});

const waCombinedTour = createWhatsAppBookingUrl({ 
  tripType: "2 Days Ajmer + Pushkar Combo Tour", 
  pickup: "Ajmer",
  customMessage: "Hello! I want to book the 2 Days Ajmer + Pushkar Combo Tour (starts at ₹3,500). Please share itinerary details."
});

const waUrsTour = createWhatsAppBookingUrl({ 
  tripType: "3 Days Ajmer Urs & Sufi Pilgrimage", 
  pickup: "Ajmer",
  customMessage: "Hello! I am inquiring about the 3 Days Ajmer Urs Festival & Sufi Pilgrimage taxi package. Please share details."
});

const waKhatuSalasar = createWhatsAppBookingUrl({ 
  tripType: "Khatu Shyam Ji & Salasar Balaji Tour", 
  pickup: "Ajmer",
  customMessage: "Hello! I want to book a taxi from Ajmer for Khatu Shyam Ji & Salasar Balaji Darshan. Please share rates."
});

const waMewarTour = createWhatsAppBookingUrl({ 
  tripType: "3 Days Mewar Heritage Tour (Nathdwara - Chittor - Udaipur)", 
  pickup: "Ajmer",
  customMessage: "Hello! I want to book 3 Days Mewar Heritage Tour (Ajmer - Nathdwara - Chittorgarh - Udaipur) starting at ₹9,500. Please share quotes for Sedan / Ertiga / Crysta."
});

const waRoyalClassic = createWhatsAppBookingUrl({ 
  tripType: "4 Days Royal Rajasthan Classic (Jaipur - Ajmer - Pushkar - Jodhpur)", 
  pickup: "Ajmer / Jaipur",
  customMessage: "Hello! I want to book 4 Days Royal Rajasthan Classic Tour (Jaipur - Ajmer - Pushkar - Jodhpur). Please share car options and rates."
});

const waGoldenTriangle = createWhatsAppBookingUrl({ 
  tripType: "5 Days Golden Triangle + Pushkar Circuit", 
  pickup: "Delhi / Jaipur / Ajmer",
  customMessage: "Hello! I want to book 5 Days Golden Triangle + Pushkar Tour (Delhi - Agra - Jaipur - Ajmer - Pushkar). Please send full quotation."
});

const waDesertOdyssey = createWhatsAppBookingUrl({ 
  tripType: "6 Days Desert Corridor Tour (Pushkar - Bikaner - Jaisalmer)", 
  pickup: "Ajmer",
  customMessage: "Hello! I am interested in the 6 Days Desert Corridor Tour covering Ajmer, Pushkar, Bikaner & Jaisalmer Sam Sand Dunes. Please share taxi package details."
});

const waGrandRajasthan = createWhatsAppBookingUrl({ 
  tripType: "7 Days Grand Rajasthan Heritage Odyssey", 
  pickup: "Jaipur / Ajmer",
  customMessage: "Hello! I want to book 7 Days Complete Rajasthan Heritage Tour (Jaipur, Ajmer, Pushkar, Jodhpur, Udaipur). Please share detailed itinerary and vehicle pricing."
});

const waMaharajaCircuit = createWhatsAppBookingUrl({ 
  tripType: "9 Days Royal Rajasthan Maharaja Grand Expedition", 
  pickup: "Jaipur / Delhi / Ajmer",
  customMessage: "Hello! I want to book the comprehensive 9 Days Royal Rajasthan Grand Expedition. Please send complete route itinerary and quotation for our group."
});

const waGroupUrbania = createWhatsAppBookingUrl({ 
  tripType: "Group Rajasthan Tour (Force Urbania / Tempo Traveller)", 
  pickup: "Ajmer",
  customMessage: "Hello! We have a large group / family and need a Force Urbania (13/17 seater) or Tempo Traveller for a Rajasthan Tour. Please share best package rates."
});

const serviceSchema = generateServiceSchema({
  name: "Rajasthan Tour Packages & Sightseeing Taxi Ajmer",
  description: "Comprehensive Rajasthan road trip tour packages, spiritual pilgrimage circuits, and guided sightseeing cab rentals covering Ajmer, Pushkar, Jaipur, Udaipur, Jodhpur, and Jaisalmer.",
  url: `${business.website}/tours/`,
  providerName: business.name,
  providerUrl: business.website,
  price: "1800",
  priceCurrency: "INR"
});

const tourFaqs = [
  {
    question: "Can I customize the Rajasthan tour packages according to my travel dates?",
    answer: "Yes, 100%! All our Rajasthan tour packages are fully customizable. You can adjust the number of days, choose specific cities (such as adding Chittorgarh, Mount Abu, or Ranthambore), set your preferred departure times, and select your vehicle tier.",
    category: "General" as const
  },
  {
    question: "What vehicles are available for Rajasthan multi-day road trips?",
    answer: "We offer a modern, well-maintained fleet: 4-seater sedans (Maruti Swift Dzire & Toyota Etios), 6-seater family MPVs (Maruti Suzuki Ertiga & Toyota Rumion), VIP luxury SUVs (Toyota Innova Crysta), and 13 to 27 seater Maharaja Force Urbania vans and Tempo Travellers for larger families and pilgrim groups.",
    category: "Vehicles" as const
  },
  {
    question: "Are highway toll taxes, state permits, and driver allowances included?",
    answer: "Yes, we provide transparent all-inclusive quotations that clearly detail fuel, vehicle hire, driver night allowance, and state border permits. There are zero surprise surcharges or hidden fees.",
    category: "Pricing" as const
  },
  {
    question: "Can you arrange hotel or railway station pickups from cities other than Ajmer?",
    answer: "Yes! While our base headquarters is in Ajmer & Pushkar, our All-India Tourist Permit fleet operates seamlessly across Jaipur Airport, Delhi IGI Airport, Jodhpur, and Udaipur for pickups and drop-offs.",
    category: "Routes" as const
  },
  {
    question: "How do we book a Rajasthan tour cab?",
    answer: "Booking is effortless! Click any WhatsApp button on this page or call our 24/7 hotline at " + business.phoneFormatted + ". Share your travel dates, passenger count, and preferred route. We will instantly share a tailored itinerary and guaranteed quote.",
    category: "Booking" as const
  }
];

const faqSchema = generateFAQSchema(tourFaqs);
---

<Layout 
  title={pageTitle} 
  description={pageDescription} 
  canonicalPath="/tours/"
  schemaMarkup={serviceSchema}
>
  <Header />

  <main id="main-content">
    <!-- Hero Banner -->
    <section class="tour-hero-section">
      <div class="container text-center">
        <span class="heritage-pill">Premier Chauffeur Tours • Serving Since 2008</span>
        <h1 class="hero-title">Rajasthan Tour Packages &amp; Sightseeing Cabs</h1>
        <p class="hero-desc">
          Handcrafted Spiritual Pilgrimages, Royal Heritage Circuits, and Multi-Day Desert Expeditions with Experienced Highway Chauffeurs
        </p>

        <!-- Trust Highlights -->
        <div class="hero-feature-tags">
          <div class="f-tag">✓ 100% Chilled AC Cabs</div>
          <div class="f-tag">✓ Polite, Verified Drivers</div>
          <div class="f-tag">✓ No Hidden Surcharges</div>
          <div class="f-tag">✓ Doorstep Pickup Across Rajasthan</div>
          <div class="f-tag gold">✓ Dzire, Ertiga, Crysta &amp; Urbania</div>
        </div>

        <div class="hero-cta-group">
          <a href={waCustomTour} target="_blank" rel="noopener noreferrer" class="btn btn--gold btn--lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.087-.178.181-.077.355.101.174.449.741.964 1.2.662.591 1.221.774 1.394.861.173.087.275.072.376-.044.101-.116.433-.506.549-.68.116-.174.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.044.073.044.42-.1 1.016z"/></svg>
            Plan Custom Rajasthan Tour
          </a>
          <a href={`tel:${business.phone}`} class="btn btn--outline-light btn--lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
            Instant Call: {business.phoneFormatted}
          </a>
        </div>
      </div>
    </section>

    <!-- Main Tour Packages Hub -->
    <section class="packages-hub-section" id="tour-packages">
      <div class="container">
        <!-- Interactive Category Filter Navigation -->
        <div class="tour-filter-bar">
          <button type="button" class="filter-btn active" data-filter="all">All Packages (12)</button>
          <button type="button" class="filter-btn" data-filter="spiritual">Spiritual &amp; Pilgrimage (5)</button>
          <button type="button" class="filter-btn" data-filter="heritage">Heritage &amp; Forts (3)</button>
          <button type="button" class="filter-btn" data-filter="desert">Desert &amp; Circuits (3)</button>
          <button type="button" class="filter-btn" data-filter="group">Group &amp; Van Fleet (1)</button>
        </div>

        <!-- Tour Cards Grid -->
        <div class="tours-catalog-grid" id="tours-catalog">

          <!-- 1. 1 Day Ajmer Dargah Darshan -->
          <article class="tour-card" data-category="spiritual">
            <div class="tour-card-header">
              <span class="badge-duration">Full Day / 8 Hours</span>
              <span class="badge-cat spiritual">Spiritual</span>
            </div>
            <h3 class="tour-name">1 Day Ajmer Dargah Darshan &amp; Heritage</h3>
            <p class="tour-desc">A revered spiritual journey through Ajmer Sharif Dargah, historic 12th-century mosques, and the royal lakes of Chauhan kings.</p>
            
            <div class="route-stops-box">
              <span class="stops-title">Covered Attractions:</span>
              <ul class="stops-list">
                <li>📍 Hazrat Khwaja Moinuddin Chishti Dargah</li>
                <li>📍 Adhai Din Ka Jhopra 12th-Century Mosque</li>
                <li>📍 Ana Sagar Lake &amp; Daulat Bagh Pavilions</li>
                <li>📍 Taragarh Fort &amp; Nareli Jain Marble Temple</li>
              </ul>
            </div>

            <div class="tour-pricing-row">
              <div class="price-tier">
                <span class="tier-label">Full Day (8 Hrs / 80 Km)</span>
                <span class="price-val">₹2,500</span>
              </div>
              <div class="price-tier">
                <span class="tier-label">Half Day (4 Hrs / 40 Km)</span>
                <span class="price-val">₹1,500</span>
              </div>
            </div>

            <div class="tour-card-footer">
              <a href={waAjmerTour} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--block">
                Book Ajmer Tour
              </a>
            </div>
          </article>

          <!-- 2. 1 Day Pushkar Pilgrimage & Desert Sunset -->
          <article class="tour-card" data-category="spiritual">
            <div class="tour-card-header">
              <span class="badge-duration">Full Day</span>
              <span class="badge-cat spiritual">Sacred Town</span>
            </div>
            <h3 class="tour-name">1 Day Pushkar Pilgrimage &amp; Desert Ghats</h3>
            <p class="tour-desc">Drive across the scenic Nagpahari hill pass into holy Pushkar for Brahma Temple puja, holy dip at 52 ghats, and sunset over dunes.</p>
            
            <div class="route-stops-box">
              <span class="stops-title">Covered Attractions:</span>
              <ul class="stops-list">
                <li>📍 14th-Century Jagatpita Brahma Temple</li>
                <li>📍 52 Sacred Bathing Ghats of Holy Pushkar Lake</li>
                <li>📍 Savitri Mata Temple Hilltop Ropeway</li>
                <li>📍 Varaha Temple, Rangji Temple &amp; Desert Sunset</li>
              </ul>
            </div>

            <div class="tour-pricing-row">
              <div class="price-tier">
                <span class="tier-label">Swift Dzire / Etios</span>
                <span class="price-val">₹1,800</span>
              </div>
              <div class="price-tier">
                <span class="tier-label">Maruti Ertiga (6-Seater)</span>
                <span class="price-val">₹2,600</span>
              </div>
            </div>

            <div class="tour-card-footer">
              <a href={waPushkarTour} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--block">
                Book Pushkar Tour
              </a>
            </div>
          </article>

          <!-- 3. Ajmer Sharif + Sarwar Sharif Sufi Ziyarat Combo (FEATURED) -->
          <article class="tour-card featured-pkg" data-category="spiritual">
            <div class="pkg-ribbon">Pilgrim Special</div>
            <div class="tour-card-header">
              <span class="badge-duration gold-badge">Same Day Combo</span>
              <span class="badge-cat spiritual">Sufi Ziyarat</span>
            </div>
            <h3 class="tour-name">Ajmer Sharif + Sarwar Sharif Ziyarat Combo</h3>
            <p class="tour-desc">Complete your Sufi pilgrimage by paying respects at both Khwaja Gharib Nawaz Dargah in Ajmer and Hazrat Khwaja Fakhruddin Chishti Dargah at Sarwar.</p>
            
            <div class="route-stops-box">
              <span class="stops-title">Covered Attractions:</span>
              <ul class="stops-list">
                <li>📍 Morning: Ajmer Sharif Dargah Ziyarat &amp; Fatiha</li>
                <li>📍 Scenic 62 km drive to Sarwar Sharif (Sarwad)</li>
                <li>📍 Afternoon: Hazrat Khwaja Fakhruddin Chishti Shrine</li>
                <li>📍 2–3 Hours Ziyarat wait-time &amp; safe return to Ajmer</li>
              </ul>
            </div>

            <div class="tour-pricing-row">
              <div class="price-tier">
                <span class="tier-label">Dzire / Etios</span>
                <span class="price-val gold-text">₹2,800</span>
              </div>
              <div class="price-tier">
                <span class="tier-label">Ertiga 6-Seater</span>
                <span class="price-val">₹3,600</span>
              </div>
              <div class="price-tier">
                <span class="tier-label">Innova Crysta</span>
                <span class="price-val">₹4,800</span>
              </div>
            </div>

            <div class="tour-card-footer">
              <a href={waSarwarCombo} target="_blank" rel="noopener noreferrer" class="btn btn--gold btn--block">
                Book Sufi Combo Tour
              </a>
            </div>
          </article>

          <!-- 4. 2 Days Ajmer + Pushkar Leisure Combo -->
          <article class="tour-card" data-category="spiritual">
            <div class="tour-card-header">
              <span class="badge-duration">2 Days / 1 Night</span>
              <span class="badge-cat spiritual">Twin Cities</span>
            </div>
            <h3 class="tour-name">2 Days Ajmer + Pushkar Complete Tour</h3>
            <p class="tour-desc">The ideal weekend relaxation and pilgrimage tour covering both sacred cities with relaxed sightseeing and evening desert sunset.</p>
            
            <div class="route-stops-box">
              <span class="stops-title">Day-Wise Itinerary:</span>
              <ul class="stops-list">
                <li>📍 Day 1: Ajmer Dargah Ziyarat, Ana Sagar, Taragarh Fort</li>
                <li>📍 Day 2: Pushkar Brahma Temple, 52 Ghats Aarti &amp; Desert Safari</li>
                <li>📍 Doorstep hotel &amp; railway station pickup/drops</li>
                <li>📍 AC cab stays dedicated with you for both days</li>
              </ul>
            </div>

            <div class="tour-pricing-row">
              <div class="price-tier">
                <span class="tier-label">Swift Dzire / Etios</span>
                <span class="price-val">₹3,500</span>
              </div>
              <div class="price-tier">
                <span class="tier-label">Ertiga 6-Seater</span>
                <span class="price-val">₹4,800</span>
              </div>
            </div>

            <div class="tour-card-footer">
              <a href={waCombinedTour} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--block">
                Book 2-Day Combo
              </a>
            </div>
          </article>

          <!-- 5. Khatu Shyam Ji & Salasar Balaji Tour from Ajmer -->
          <article class="tour-card" data-category="spiritual">
            <div class="tour-card-header">
              <span class="badge-duration">1 or 2 Days</span>
              <span class="badge-cat spiritual">Spiritual Circuit</span>
            </div>
            <h3 class="tour-name">Khatu Shyam Ji &amp; Salasar Balaji Yatra</h3>
            <p class="tour-desc">Dedicated pilgrimage cab from Ajmer to Baba Shyam Mandir (Khatu Dham) and Salasar Hanuman Ji with complete darshan wait-time.</p>
            
            <div class="route-stops-box">
              <span class="stops-title">Covered Temples:</span>
              <ul class="stops-list">
                <li>📍 Shri Khatu Shyam Ji Mandir (Sikar)</li>
                <li>📍 Salasar Balaji Hanuman Temple (Churu)</li>
                <li>📍 Optional stop at Jeen Mata Ji shrine</li>
                <li>📍 Experienced highway driver for safe family travel</li>
              </ul>
            </div>

            <div class="tour-pricing-row">
              <div class="price-tier">
                <span class="tier-label">Sedan (Same Day)</span>
                <span class="price-val">₹5,500</span>
              </div>
              <div class="price-tier">
                <span class="tier-label">Ertiga 6-Seater</span>
                <span class="price-val">₹7,200</span>
              </div>
            </div>

            <div class="tour-card-footer">
              <a href={waKhatuSalasar} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--block">
                Book Khatu-Salasar Cab
              </a>
            </div>
          </article>

          <!-- 6. 3 Days Mewar Heritage Circuit (FEATURED) -->
          <article class="tour-card featured-pkg" data-category="heritage">
            <div class="pkg-ribbon">Top Seller</div>
            <div class="tour-card-header">
              <span class="badge-duration gold-badge">3 Days / 2 Nights</span>
              <span class="badge-cat heritage">Royal Mewar</span>
            </div>
            <h3 class="tour-name">3 Days Mewar Heritage Tour (Udaipur &amp; Chittor)</h3>
            <p class="tour-desc">Experience the valour of Chittorgarh, the divine presence of Nathdwara Shrinathji, and the royal lakes of Udaipur in AC luxury.</p>
            
            <div class="route-stops-box">
              <span class="stops-title">Day-Wise Itinerary:</span>
              <ul class="stops-list">
                <li>📍 Day 1: Ajmer ➔ Nathdwara Shrinathji ➔ Udaipur Lake City</li>
                <li>📍 Day 2: City Palace Udaipur, Saheliyon Ki Bari, Pichola Boating</li>
                <li>📍 Day 3: Massive Chittorgarh Fort (Vijay Stambh) ➔ Ajmer Drop</li>
                <li>📍 Smooth 4-lane NH58 / NH48 highway driving</li>
              </ul>
            </div>

            <div class="tour-pricing-row">
              <div class="price-tier">
                <span class="tier-label">Comfort Sedan</span>
                <span class="price-val gold-text">₹9,500</span>
              </div>
              <div class="price-tier">
                <span class="tier-label">Maruti Ertiga</span>
                <span class="price-val">₹13,500</span>
              </div>
              <div class="price-tier">
                <span class="tier-label">Innova Crysta</span>
                <span class="price-val">₹17,500</span>
              </div>
            </div>

            <div class="tour-card-footer">
              <a href={waMewarTour} target="_blank" rel="noopener noreferrer" class="btn btn--gold btn--block">
                Book Mewar Tour
              </a>
            </div>
          </article>

          <!-- 7. 4 Days Royal Rajasthan Classic (Jaipur - Ajmer - Pushkar - Jodhpur) -->
          <article class="tour-card" data-category="heritage">
            <div class="tour-card-header">
              <span class="badge-duration">4 Days / 3 Nights</span>
              <span class="badge-cat heritage">Imperial Circuit</span>
            </div>
            <h3 class="tour-name">4 Days Royal Rajasthan Classic Tour</h3>
            <p class="tour-desc">Connecting the Pink City Jaipur, sacred Ajmer &amp; Pushkar, and the majestic Blue City of Jodhpur with Mehrangarh Fort.</p>
            
            <div class="route-stops-box">
              <span class="stops-title">Day-Wise Itinerary:</span>
              <ul class="stops-list">
                <li>📍 Day 1: Jaipur City Palace, Hawa Mahal &amp; Amer Fort</li>
                <li>📍 Day 2: Jaipur ➔ Kishangarh Dumping Yard ➔ Ajmer Dargah</li>
                <li>📍 Day 3: Pushkar Brahma Temple &amp; Lake ➔ Drive to Jodhpur</li>
                <li>📍 Day 4: Mehrangarh Fort, Jaswant Thada, Umaid Bhawan</li>
              </ul>
            </div>

            <div class="tour-pricing-row">
              <div class="price-tier">
                <span class="tier-label">Comfort Sedan</span>
                <span class="price-val">₹13,500</span>
              </div>
              <div class="price-tier">
                <span class="tier-label">Ertiga 6-Seater</span>
                <span class="price-val">₹18,500</span>
              </div>
            </div>

            <div class="tour-card-footer">
              <a href={waRoyalClassic} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--block">
                Book Royal Classic Tour
              </a>
            </div>
          </article>

          <!-- 8. 5 Days Golden Triangle + Pushkar Circuit -->
          <article class="tour-card" data-category="heritage">
            <div class="tour-card-header">
              <span class="badge-duration">5 Days / 4 Nights</span>
              <span class="badge-cat heritage">World Heritage</span>
            </div>
            <h3 class="tour-name">5 Days Golden Triangle + Pushkar Circuit</h3>
            <p class="tour-desc">The ultimate North India flagship circuit: Delhi capital, Taj Mahal in Agra, Pink City Jaipur, and the spiritual oasis of Ajmer &amp; Pushkar.</p>
            
            <div class="route-stops-box">
              <span class="stops-title">Day-Wise Itinerary:</span>
              <ul class="stops-list">
                <li>📍 Day 1: Delhi pickup ➔ Agra Taj Mahal &amp; Agra Fort</li>
                <li>📍 Day 2: Fatehpur Sikri ➔ Jaipur (Pink City monuments)</li>
                <li>📍 Day 3: Amer Fort, Jal Mahal &amp; Jaipur local bazaars</li>
                <li>📍 Day 4: Jaipur ➔ Ajmer Sharif Dargah &amp; Pushkar Ghats</li>
