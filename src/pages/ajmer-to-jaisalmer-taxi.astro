---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header/Header.astro";
import Footer from "@/components/Footer/Footer.astro";
import FAQ from "@/components/FAQ/FAQ.astro";
import WhatsAppBubble from "@/components/WhatsApp/WhatsAppBubble.astro";
import MobileBottomBar from "@/components/MobileBottomBar/MobileBottomBar.astro";
import { business } from "@/data/business";
import { createWhatsAppBookingUrl } from "@/utils/whatsapp";
import { generateServiceSchema } from "@/utils/seo";

const pageTitle = "Ajmer to Jaisalmer Taxi ₹7,500 Fixed | AC Cab Booking 24/7 (2026)";
const pageDescription = "Book verified Ajmer to Jaisalmer one-way taxi from ₹7,500. 530 km Golden City highway journey in ~9 hours. AC Sedans, Ertiga & Innova Crysta. Doorstep pickup 24/7. No advance needed.";

const waSedan   = createWhatsAppBookingUrl({ pickup: "Ajmer", destination: "Jaisalmer", vehicle: "Maruti Dzire Sedan (₹7,500 Fixed)" });
const waErtiga  = createWhatsAppBookingUrl({ pickup: "Ajmer", destination: "Jaisalmer", vehicle: "Maruti Ertiga (₹10,500 Fixed)" });
const waInnova  = createWhatsAppBookingUrl({ pickup: "Ajmer", destination: "Jaisalmer", vehicle: "Toyota Innova Crysta (₹14,500 Fixed)" });

const serviceSchema = generateServiceSchema(
  "Ajmer to Jaisalmer Taxi Service",
  "One-way and round-trip highway cab from Ajmer to Jaisalmer Golden City via Jodhpur. Comfortable AC vehicles with verified local drivers.",
  `${business.website}/ajmer-to-jaisalmer-taxi/`
);

const faqs = [
  {
    question: "What is the taxi fare from Ajmer to Jaisalmer?",
    answer: "Fixed one-way fares are: Maruti Dzire/Etios Sedan at ₹7,500; Maruti Ertiga (6-seater) at ₹10,500; Toyota Innova Crysta at ₹14,500. Toll taxes are extra as per actual FASTag receipts.",
    category: "Pricing" as const
  },
  {
    question: "How long does it take to travel from Ajmer to Jaisalmer by cab?",
    answer: "The distance is approximately 525–535 km via NH 62 through Jodhpur. The journey typically takes 8.5 to 10 hours depending on traffic in Jodhpur city.",
    category: "Routes" as const
  },
  {
    question: "Which route does the driver take from Ajmer to Jaisalmer?",
    answer: "The standard route is Ajmer → Beawar → Pali → Jodhpur → Pokhran → Jaisalmer via NH 62 and NH 125. A brief tea break is usually taken at Pali or Jodhpur.",
    category: "Routes" as const
  },
  {
    question: "Can I book a round trip from Ajmer to Jaisalmer?",
    answer: "Yes, round trips are available with driver halt included. The round-trip rate for a Dzire is approximately ₹13,500 (2 days). Please book at least 24 hours in advance for round trips.",
    category: "Booking" as const
  },
  {
    question: "Is it safe to travel from Ajmer to Jaisalmer at night?",
    answer: "We recommend daytime departures (before 8 AM) to enjoy the scenic desert drive and arrive before sunset. However, our verified chauffeurs are experienced on this route and can handle night journeys as well.",
    category: "Booking" as const
  }
];
---

<Layout title={pageTitle} description={pageDescription} canonicalPath="/ajmer-to-jaisalmer-taxi/" schemaMarkup={serviceSchema}>
  <Header />

  <main id="main-content">
    <section class="route-hero">
      <div class="container text-center">
        <span class="heritage-pill">Verified Route • NH 62 Desert Highway • Since 2008</span>
        <h1 class="route-title">Ajmer to Jaisalmer Taxi Service</h1>
        <p class="route-subtitle">Fixed One-Way Sedan Fare ₹7,500 • 530 km • ~9 Hours • Golden City Drop 24/7</p>
        <div class="hero-fare-pills">
          <div class="h-pill">Dzire / Etios: <strong>₹7,500</strong></div>
          <div class="h-pill">Ertiga 6-Seater: <strong>₹10,500</strong></div>
          <div class="h-pill">Innova Crysta: <strong>₹14,500</strong></div>
        </div>
      </div>
    </section>

    <section class="route-content-section">
      <div class="container">
        <div class="route-grid">
          <div class="route-main">
            <span class="section-subtitle">Desert Journey to the Golden City</span>
            <h2 class="section-title">Reliable Ajmer to Jaisalmer Cab Rental</h2>
            <p>
              Planning a trip to Jaisalmer's golden forts and sand dunes? Panwar Taxi has been operating Ajmer to Jaisalmer cab bookings since 2008, covering this iconic 530 km desert highway through the heart of Rajasthan. Skip the uncomfortable overnight buses and arrive in style in your own private AC cab.
            </p>
            <p>
              Our route passes through the historic city of Jodhpur, giving you the option of a brief sightseeing stop at Mehrangarh Fort before continuing into the Thar Desert. Our chauffeurs are experienced on the NH 62 desert highway and know every fuel station, dhaba, and rest stop en route.
            </p>

            <h3 class="tier-heading">Verified Fare Breakdown (Ajmer ➔ Jaisalmer)</h3>
            <div class="pricing-cards-row">
              <div class="p-card">
                <span class="p-type">Comfort Sedan</span>
                <h4 class="p-car">Maruti Swift Dzire</h4>
                <div class="p-fare">₹7,500 <small>one-way</small></div>
                <ul class="p-features">
                  <li>✓ 4 Passenger Seats</li>
                  <li>✓ 2 Large Bags</li>
                  <li>✓ 100% Chilled AC</li>
                  <li>✓ Doorstep Pickup & Drop</li>
                </ul>
                <a href={waSedan} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--sm p-btn">
                  Book Sedan @ ₹7,500
                </a>
              </div>

              <div class="p-card featured-p-card">
                <span class="p-type gold">Family MPV — Best Value</span>
                <h4 class="p-car">Maruti Ertiga</h4>
                <div class="p-fare">₹10,500 <small>one-way</small></div>
                <ul class="p-features">
                  <li>✓ 6 Passenger Seats</li>
                  <li>✓ 3–4 Luggage Bags</li>
                  <li>✓ Dual AC Vents</li>
                  <li>✓ Extra Legroom — Ideal for Long Journey</li>
                </ul>
                <a href={waErtiga} target="_blank" rel="noopener noreferrer" class="btn btn--gold btn--sm p-btn">
                  Book Ertiga @ ₹10,500
                </a>
              </div>

              <div class="p-card">
                <span class="p-type">Luxury MUV</span>
                <h4 class="p-car">Toyota Innova Crysta</h4>
                <div class="p-fare">₹14,500 <small>one-way</small></div>
                <ul class="p-features">
                  <li>✓ 6/7 Captain Seats</li>
                  <li>✓ 4+ Large Suitcases</li>
                  <li>✓ Premium Suspension</li>
                  <li>✓ Executive Desert Travel</li>
                </ul>
                <a href={waInnova} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--sm p-btn">
                  Book Crysta @ ₹14,500
                </a>
              </div>
            </div>

            <div class="route-itinerary-box">
              <h3>Route Highlights & En-Route Stops</h3>
              <ul>
                <li>• <strong>Beawar & Pali:</strong> Clean highway dhabas for breakfast or tea break, approximately 1.5–2 hours from Ajmer.</li>
                <li>• <strong>Jodhpur (Optional Stop):</strong> 3.5 hours from Ajmer. Option to stop at Mehrangarh Fort, Clock Tower Market, or Jodhpur Railway Station for pickups.</li>
                <li>• <strong>Pokhran:</strong> Historic site of India's nuclear tests, now a popular photo stop on the way to Jaisalmer.</li>
                <li>• <strong>Jaisalmer Drops Available:</strong> Jaisalmer Fort area, Sam Sand Dunes, Gadisar Lake, Patwa Haveli, and any hotel or resort in Jaisalmer district.</li>
              </ul>
            </div>
          </div>

          <aside class="route-sidebar">
            <div class="sidebar-box">
              <h3 class="side-title">Quick Route Summary</h3>
              <div class="side-list">
                <div class="side-item">
                  <span class="s-label">Origin:</span>
                  <span class="s-val">Ajmer / Pushkar</span>
                </div>
                <div class="side-item">
                  <span class="s-label">Destination:</span>
                  <span class="s-val">Jaisalmer (Any Location)</span>
                </div>
                <div class="side-item">
                  <span class="s-label">Highway:</span>
                  <span class="s-val">NH 62 via Jodhpur</span>
                </div>
                <div class="side-item">
                  <span class="s-label">Distance:</span>
                  <span class="s-val">~530 km</span>
                </div>
                <div class="side-item">
                  <span class="s-label">Travel Time:</span>
                  <span class="s-val">8.5 to 10 Hours</span>
                </div>
                <div class="side-item">
                  <span class="s-label">Starting Price:</span>
                  <span class="s-val gold-text">₹7,500 (Sedan)</span>
                </div>
              </div>
              <div class="side-actions">
                <a href={waSedan} target="_blank" rel="noopener noreferrer" class="btn btn--gold btn--sm full-w">
                  WhatsApp Instant Quote
                </a>
                <a href={`tel:${business.phone}`} class="btn btn--outline-primary btn--sm full-w">
                  Call: {business.phoneFormatted}
                </a>
              </div>
            </div>
            <div class="sidebar-trust">
              <h4>Why Book With Us?</h4>
              <p>18+ years serving Ajmer's longest highway routes. Zero advance required — pay the driver at destination. All cabs are AC, commercially insured and permit-verified.</p>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <FAQ items={faqs} title="Ajmer to Jaisalmer Taxi FAQs" subtitle="Frequently Asked Questions" />
  </main>

  <Footer />
  <WhatsAppBubble />
  <MobileBottomBar />
</Layout>

<style>
  .route-hero {
    background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
    color: #FFFFFF;
    padding: calc(var(--header-height, 74px) + 38px) 0 36px;
    border-bottom: 3px solid var(--color-accent);
  }
  .heritage-pill {
    display: inline-block;
    background: rgba(197,155,39,0.2);
    border: 1px solid var(--color-accent);
    color: var(--color-accent-light);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 4px 14px;
    border-radius: var(--radius-full);
    margin-bottom: 12px;
  }
  .route-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 2.75rem);
    color: #FFFFFF;
    margin-bottom: 6px;
  }
  .route-subtitle {
    font-size: 1.125rem;
    color: rgba(255,255,255,0.9);
    max-width: 720px;
    margin: 0 auto var(--space-lg);
  }
  .hero-fare-pills { display: flex; justify-content: center; gap: var(--space-sm); flex-wrap: wrap; }
  .h-pill {
    background: rgba(0,0,0,0.3);
    border: 1px solid rgba(197,155,39,0.4);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    color: #F8E6B8;
  }
  .h-pill strong { color: #FFFFFF; }
  .route-content-section { padding: var(--space-4xl) 0; background: #FFFFFF; }
  .route-grid { display: grid; grid-template-columns: 1fr 340px; gap: var(--space-3xl); }
  .tier-heading { font-family: var(--font-heading); font-size: 1.375rem; color: var(--color-primary); margin: var(--space-2xl) 0 var(--space-md); }
  .pricing-cards-row { display: grid; grid-template-columns: repeat(3,1fr); gap: var(--space-md); margin-bottom: var(--space-2xl); }
  .p-card { background: #FFF; border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-lg); display: flex; flex-direction: column; box-shadow: 0 4px 12px rgba(34,24,28,0.05); }
  .featured-p-card { border: 2px solid var(--color-accent); background: var(--color-cream); }
  .p-type { font-size: 0.75rem; font-weight: 700; color: var(--color-primary); text-transform: uppercase; display: block; margin-bottom: 2px; }
  .p-type.gold { color: var(--color-accent-dark); }
  .p-car { font-family: var(--font-heading); font-size: 1.125rem; color: var(--color-text); margin-bottom: var(--space-xs); }
  .p-fare { font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; color: var(--color-primary); margin-bottom: var(--space-md); }
  .p-fare small { font-size: 0.75rem; font-weight: 500; color: var(--color-text-muted); }
  .p-features { list-style: none; padding: 0; margin: 0 0 var(--space-lg); display: flex; flex-direction: column; gap: 6px; font-size: 0.8125rem; color: var(--color-text); flex: 1; }
  .p-btn { width: 100%; justify-content: center; margin-top: auto; }
  .route-itinerary-box { background: var(--color-cream); border: 1px solid var(--color-border); border-left: 4px solid var(--color-accent); padding: var(--space-xl); border-radius: var(--radius-md); }
  .route-itinerary-box h3 { font-family: var(--font-heading); color: var(--color-primary); font-size: 1.25rem; margin-bottom: var(--space-sm); }
  .route-itinerary-box ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; font-size: 0.875rem; color: var(--color-text); }
  .route-sidebar { display: flex; flex-direction: column; gap: var(--space-lg); }
  .sidebar-box { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-xl); }
  .side-title { font-family: var(--font-heading); font-size: 1.125rem; color: var(--color-primary); margin-bottom: var(--space-md); padding-bottom: 6px; border-bottom: 2px solid var(--color-accent); }
  .side-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: var(--space-lg); }
  .side-item { display: flex; justify-content: space-between; font-size: 0.84375rem; padding-bottom: 4px; border-bottom: 1px dashed var(--color-border); }
  .s-label { color: var(--color-text-muted); }
  .s-val { font-weight: 600; color: var(--color-text); }
  .gold-text { color: var(--color-primary); font-weight: 700; }
  .side-actions { display: flex; flex-direction: column; gap: 8px; }
  .full-w { width: 100%; justify-content: center; }
  .sidebar-trust { background: var(--color-cream); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-lg); }
  .sidebar-trust h4 { font-family: var(--font-heading); color: var(--color-primary); font-size: 1rem; margin-bottom: 4px; }
  .sidebar-trust p { font-size: 0.8125rem; color: var(--color-text-muted); line-height: 1.5; margin: 0; }
  @media (max-width: 992px) {
    .route-grid { grid-template-columns: 1fr; }
    .pricing-cards-row { grid-template-columns: 1fr; }
  }
</style>
