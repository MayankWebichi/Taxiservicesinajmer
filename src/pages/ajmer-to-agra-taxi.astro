---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header/Header.astro";
import Footer from "@/components/Footer/Footer.astro";
import FAQ from "@/components/FAQ/FAQ.astro";
import WhatsAppBubble from "@/components/WhatsApp/WhatsAppBubble.astro";
import MobileBottomBar from "@/components/MobileBottomBar/MobileBottomBar.astro";
import { business } from "@/data/business";
import { createWhatsAppBookingUrl } from "@/utils/whatsapp";
import { generateServiceSchema } from "@/utils/seo";

const pageTitle = "Ajmer to Agra Taxi ₹5,800 Fixed | Taj Mahal Cab Booking 24/7 (2026)";
const pageDescription = "Book reliable Ajmer to Agra one-way taxi from ₹5,800. 390 km journey to the Taj Mahal in ~6 hours via NH 52 & Yamuna Expressway. AC Sedans, Ertiga & Innova. No advance, pay after ride.";

const waSedan  = createWhatsAppBookingUrl({ pickup: "Ajmer", destination: "Agra (Taj Mahal)", vehicle: "Maruti Dzire Sedan (₹5,800 Fixed)" });
const waErtiga = createWhatsAppBookingUrl({ pickup: "Ajmer", destination: "Agra (Taj Mahal)", vehicle: "Maruti Ertiga (₹8,500 Fixed)" });
const waInnova = createWhatsAppBookingUrl({ pickup: "Ajmer", destination: "Agra (Taj Mahal)", vehicle: "Toyota Innova Crysta (₹12,000 Fixed)" });

const serviceSchema = generateServiceSchema(
  "Ajmer to Agra Taxi Service",
  "One-way and round-trip cab from Ajmer to Agra covering Taj Mahal, Agra Fort, and Fatehpur Sikri. Comfortable AC vehicles with verified drivers.",
  `${business.website}/ajmer-to-agra-taxi/`
);

const faqs = [
  {
    question: "What is the taxi fare from Ajmer to Agra?",
    answer: "Fixed one-way fares: Maruti Dzire Sedan at ₹5,800; Maruti Ertiga (6-seater) at ₹8,500; Toyota Innova Crysta at ₹12,000. Toll and parking charges are extra as per actual receipts.",
    category: "Pricing" as const
  },
  {
    question: "How long does it take from Ajmer to Agra by cab?",
    answer: "The distance is approximately 385–395 km via NH 52 and the Yamuna Expressway. The journey takes approximately 6 to 7 hours including a short tea/meal break.",
    category: "Routes" as const
  },
  {
    question: "Can I visit Fatehpur Sikri en route to Agra?",
    answer: "Yes! Fatehpur Sikri is located about 40 km before Agra on the same highway. We can include a 1-hour sightseeing stop at the UNESCO World Heritage Site at a small additional charge for waiting time.",
    category: "Routes" as const
  },
  {
    question: "Is a round-trip available for Ajmer to Agra with a day's halt?",
    answer: "Yes. We offer round trips with a 1-night driver halt in Agra. The round-trip rate for a Sedan is approximately ₹10,500 (2 days). Book at least 24 hours in advance.",
    category: "Booking" as const
  },
  {
    question: "Which gate of the Taj Mahal will the driver drop me at?",
    answer: "Our drivers drop at the East Gate (most popular), South Gate, or West Gate of the Taj Mahal as per your preference. The driver will guide you on the best entry based on the time of day.",
    category: "Routes" as const
  }
];
---

<Layout title={pageTitle} description={pageDescription} canonicalPath="/ajmer-to-agra-taxi/" schemaMarkup={serviceSchema}>
  <Header />

  <main id="main-content">
    <section class="route-hero">
      <div class="container text-center">
        <span class="heritage-pill">Verified Route • NH 52 + Yamuna Expressway • Since 2008</span>
        <h1 class="route-title">Ajmer to Agra Taxi Service</h1>
        <p class="route-subtitle">Fixed One-Way Sedan Fare ₹5,800 • 390 km • ~6 Hours • Taj Mahal Doorstep Drop 24/7</p>
        <div class="hero-fare-pills">
          <div class="h-pill">Dzire / Etios: <strong>₹5,800</strong></div>
          <div class="h-pill">Ertiga 6-Seater: <strong>₹8,500</strong></div>
          <div class="h-pill">Innova Crysta: <strong>₹12,000</strong></div>
        </div>
      </div>
    </section>

    <section class="route-content-section">
      <div class="container">
        <div class="route-grid">
          <div class="route-main">
            <span class="section-subtitle">Comfortable Journey to the Taj Mahal</span>
            <h2 class="section-title">Trusted Ajmer to Agra Cab Booking</h2>
            <p>
              Agra — home to the world-famous Taj Mahal, the mighty Agra Fort, and Fatehpur Sikri — is one of India's most visited tourist destinations. Our taxi service offers verified, comfortable and affordable one-way and round-trip cab service from Ajmer to Agra since 2008, ensuring you travel in peace and arrive on time for your golden-hour visit to the Taj.
            </p>
            <p>
              Our Ajmer to Agra route uses the NH 52 highway connecting Jaipur to Agra (the famous "Golden Triangle" route), known for good road quality and manageable traffic. An optional breakfast stop at Bharatpur or a sightseeing halt at Fatehpur Sikri can be arranged on request.
            </p>

            <h3 class="tier-heading">Verified Fare Breakdown (Ajmer ➔ Agra)</h3>
            <div class="pricing-cards-row">
              <div class="p-card">
                <span class="p-type">Comfort Sedan</span>
                <h4 class="p-car">Maruti Swift Dzire</h4>
                <div class="p-fare">₹5,800 <small>one-way</small></div>
                <ul class="p-features">
                  <li>✓ 4 Passenger Seats</li>
                  <li>✓ 2 Large Bags</li>
                  <li>✓ 100% Chilled AC</li>
                  <li>✓ Doorstep Pickup & Drop</li>
                </ul>
                <a href={waSedan} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--sm p-btn">
                  Book Sedan @ ₹5,800
                </a>
              </div>

              <div class="p-card featured-p-card">
                <span class="p-type gold">Family MPV — Best Value</span>
                <h4 class="p-car">Maruti Ertiga</h4>
                <div class="p-fare">₹8,500 <small>one-way</small></div>
                <ul class="p-features">
                  <li>✓ 6 Passenger Seats</li>
                  <li>✓ 3–4 Luggage Bags</li>
                  <li>✓ Dual AC Vents</li>
                  <li>✓ Extra Legroom for Long Journey</li>
                </ul>
                <a href={waErtiga} target="_blank" rel="noopener noreferrer" class="btn btn--gold btn--sm p-btn">
                  Book Ertiga @ ₹8,500
                </a>
              </div>

              <div class="p-card">
                <span class="p-type">Luxury MUV</span>
                <h4 class="p-car">Toyota Innova Crysta</h4>
                <div class="p-fare">₹12,000 <small>one-way</small></div>
                <ul class="p-features">
                  <li>✓ 6/7 Captain Seats</li>
                  <li>✓ 4+ Large Suitcases</li>
                  <li>✓ Premium Suspension</li>
                  <li>✓ Executive Travel</li>
                </ul>
                <a href={waInnova} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--sm p-btn">
                  Book Crysta @ ₹12,000
                </a>
              </div>
            </div>

            <div class="route-itinerary-box">
              <h3>Route Highlights & En-Route Sightseeing</h3>
              <ul>
                <li>• <strong>Jaipur (Via/Bypass):</strong> About 2.5 hours from Ajmer. Option for a quick Hawa Mahal view or Amber Fort photo stop before continuing towards Agra on NH 52.</li>
                <li>• <strong>Fatehpur Sikri (Optional Stop):</strong> UNESCO World Heritage Site, 40 km before Agra. Mughal-era ghost city with stunning red sandstone architecture.</li>
                <li>• <strong>Bharatpur (Optional Wildlife Stop):</strong> Keoladeo National Park bird sanctuary for bird-watchers.</li>
                <li>• <strong>Agra Drops Available:</strong> Taj Mahal (all gates), Agra Fort, Sikandra, Sadar Bazaar, Agra Cantt Railway Station, and all hotels.</li>
              </ul>
            </div>
          </div>

          <aside class="route-sidebar">
            <div class="sidebar-box">
              <h3 class="side-title">Quick Route Summary</h3>
              <div class="side-list">
                <div class="side-item">
                  <span class="s-label">Origin:</span>
                  <span class="s-val">Ajmer / Pushkar</span>
                </div>
                <div class="side-item">
                  <span class="s-label">Destination:</span>
                  <span class="s-val">Agra (Taj Mahal)</span>
                </div>
                <div class="side-item">
                  <span class="s-label">Highway:</span>
                  <span class="s-val">NH 52 via Jaipur</span>
                </div>
                <div class="side-item">
                  <span class="s-label">Distance:</span>
                  <span class="s-val">~390 km</span>
                </div>
                <div class="side-item">
                  <span class="s-label">Travel Time:</span>
                  <span class="s-val">6 to 7 Hours</span>
                </div>
                <div class="side-item">
                  <span class="s-label">Starting Price:</span>
                  <span class="s-val gold-text">₹5,800 (Sedan)</span>
                </div>
              </div>
              <div class="side-actions">
                <a href={waSedan} target="_blank" rel="noopener noreferrer" class="btn btn--gold btn--sm full-w">
                  WhatsApp Instant Quote
                </a>
                <a href={`tel:${business.phone}`} class="btn btn--outline-primary btn--sm full-w">
                  Call: {business.phoneFormatted}
                </a>
              </div>
            </div>
            <div class="sidebar-trust">
              <h4>Why Book With Us?</h4>
              <p>18+ years on Rajasthan's Golden Triangle routes. Zero advance — pay the driver at drop. All cabs verified with commercial permits and insurance.</p>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <FAQ items={faqs} title="Ajmer to Agra Taxi FAQs" subtitle="Frequently Asked Questions" />
  </main>

  <Footer />
  <WhatsAppBubble />
  <MobileBottomBar />
</Layout>

<style>
  .route-hero { background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%); color: #FFF; padding: calc(var(--header-height, 74px) + 38px) 0 36px; border-bottom: 3px solid var(--color-accent); }
  .heritage-pill { display: inline-block; background: rgba(197,155,39,0.2); border: 1px solid var(--color-accent); color: var(--color-accent-light); font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; padding: 4px 14px; border-radius: var(--radius-full); margin-bottom: 12px; }
  .route-title { font-family: var(--font-heading); font-size: clamp(2rem, 4vw, 2.75rem); color: #FFF; margin-bottom: 6px; }
  .route-subtitle { font-size: 1.125rem; color: rgba(255,255,255,0.9); max-width: 720px; margin: 0 auto var(--space-lg); }
  .hero-fare-pills { display: flex; justify-content: center; gap: var(--space-sm); flex-wrap: wrap; }
  .h-pill { background: rgba(0,0,0,0.3); border: 1px solid rgba(197,155,39,0.4); padding: 6px 14px; border-radius: var(--radius-full); font-size: 0.875rem; color: #F8E6B8; }
  .h-pill strong { color: #FFF; }
  .route-content-section { padding: var(--space-4xl) 0; background: #FFF; }
  .route-grid { display: grid; grid-template-columns: 1fr 340px; gap: var(--space-3xl); }
  .tier-heading { font-family: var(--font-heading); font-size: 1.375rem; color: var(--color-primary); margin: var(--space-2xl) 0 var(--space-md); }
  .pricing-cards-row { display: grid; grid-template-columns: repeat(3,1fr); gap: var(--space-md); margin-bottom: var(--space-2xl); }
  .p-card { background: #FFF; border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-lg); display: flex; flex-direction: column; box-shadow: 0 4px 12px rgba(34,24,28,0.05); }
  .featured-p-card { border: 2px solid var(--color-accent); background: var(--color-cream); }
  .p-type { font-size: 0.75rem; font-weight: 700; color: var(--color-primary); text-transform: uppercase; display: block; margin-bottom: 2px; }
  .p-type.gold { color: var(--color-accent-dark); }
  .p-car { font-family: var(--font-heading); font-size: 1.125rem; color: var(--color-text); margin-bottom: var(--space-xs); }
  .p-fare { font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; color: var(--color-primary); margin-bottom: var(--space-md); }
  .p-fare small { font-size: 0.75rem; font-weight: 500; color: var(--color-text-muted); }
  .p-features { list-style: none; padding: 0; margin: 0 0 var(--space-lg); display: flex; flex-direction: column; gap: 6px; font-size: 0.8125rem; color: var(--color-text); flex: 1; }
  .p-btn { width: 100%; justify-content: center; margin-top: auto; }
  .route-itinerary-box { background: var(--color-cream); border: 1px solid var(--color-border); border-left: 4px solid var(--color-accent); padding: var(--space-xl); border-radius: var(--radius-md); }
  .route-itinerary-box h3 { font-family: var(--font-heading); color: var(--color-primary); font-size: 1.25rem; margin-bottom: var(--space-sm); }
  .route-itinerary-box ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; font-size: 0.875rem; color: var(--color-text); }
  .route-sidebar { display: flex; flex-direction: column; gap: var(--space-lg); }
  .sidebar-box { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-xl); }
  .side-title { font-family: var(--font-heading); font-size: 1.125rem; color: var(--color-primary); margin-bottom: var(--space-md); padding-bottom: 6px; border-bottom: 2px solid var(--color-accent); }
  .side-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: var(--space-lg); }
  .side-item { display: flex; justify-content: space-between; font-size: 0.84375rem; padding-bottom: 4px; border-bottom: 1px dashed var(--color-border); }
  .s-label { color: var(--color-text-muted); }
  .s-val { font-weight: 600; color: var(--color-text); }
  .gold-text { color: var(--color-primary); font-weight: 700; }
  .side-actions { display: flex; flex-direction: column; gap: 8px; }
  .full-w { width: 100%; justify-content: center; }
  .sidebar-trust { background: var(--color-cream); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-lg); }
  .sidebar-trust h4 { font-family: var(--font-heading); color: var(--color-primary); font-size: 1rem; margin-bottom: 4px; }
  .sidebar-trust p { font-size: 0.8125rem; color: var(--color-text-muted); line-height: 1.5; margin: 0; }
  @media (max-width: 992px) { .route-grid { grid-template-columns: 1fr; } .pricing-cards-row { grid-template-columns: 1fr; } }
</style>
