---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header/Header.astro";
import Footer from "@/components/Footer/Footer.astro";
import FAQ from "@/components/FAQ/FAQ.astro";
import WhatsAppBubble from "@/components/WhatsApp/WhatsAppBubble.astro";
import MobileBottomBar from "@/components/MobileBottomBar/MobileBottomBar.astro";
import { business } from "@/data/business";
import { createWhatsAppBookingUrl } from "@/utils/whatsapp";
import { generateServiceSchema } from "@/utils/seo";

const pageTitle = "Ajmer to Mathura Vrindavan Taxi ₹4,500 | Cab Booking 24/7 (2026)";
const pageDescription = "Book Ajmer to Mathura–Vrindavan one-way taxi from ₹4,500. 330 km spiritual journey in ~5 hours via NH 52. AC Sedans & Innova available. Pilgrimage cab service, no advance needed.";

const waSedan  = createWhatsAppBookingUrl({ pickup: "Ajmer", destination: "Mathura Vrindavan", vehicle: "Maruti Dzire Sedan (₹4,500 Fixed)" });
const waErtiga = createWhatsAppBookingUrl({ pickup: "Ajmer", destination: "Mathura Vrindavan", vehicle: "Maruti Ertiga (₹6,500 Fixed)" });
const waInnova = createWhatsAppBookingUrl({ pickup: "Ajmer", destination: "Mathura Vrindavan", vehicle: "Toyota Innova Crysta (₹9,500 Fixed)" });

const serviceSchema = generateServiceSchema(
  "Ajmer to Mathura Vrindavan Taxi Service",
  "Pilgrimage cab service from Ajmer to Mathura and Vrindavan. AC vehicles with experienced drivers. Ideal for Janmashtami and all-year pilgrimage trips.",
  `${business.website}/ajmer-to-mathura-vrindavan-taxi/`
);

const faqs = [
  { question: "What is the taxi fare from Ajmer to Mathura?", answer: "Fixed one-way fares from Ajmer to Mathura: Maruti Dzire Sedan ₹4,500; Ertiga (6-seater) ₹6,500; Toyota Innova Crysta ₹9,500. Toll costs are extra as per actual FASTag.", category: "Pricing" as const },
  { question: "How far is Mathura from Ajmer by road?", answer: "Mathura is approximately 330–345 km from Ajmer via NH 52 (through Jaipur). The journey takes approximately 5 to 6 hours.", category: "Routes" as const },
  { question: "Can I visit both Mathura and Vrindavan in one trip?", answer: "Yes! Mathura and Vrindavan are just 12 km apart. Our drivers can take you to major temples in both cities — Dwarkadhish Temple (Mathura), Banke Bihari Temple (Vrindavan), ISKCON Vrindavan, and Prem Mandir.", category: "Routes" as const },
  { question: "Do you offer special pilgrimage packages for Ajmer to Mathura?", answer: "Yes, we offer customized pilgrimage packages including Ajmer Sharif Dargah → Mathura → Vrindavan → Agra (Taj Mahal) in a 2–3 day tour. Call us for a customized itinerary.", category: "Booking" as const }
];
---

<Layout title={pageTitle} description={pageDescription} canonicalPath="/ajmer-to-mathura-vrindavan-taxi/" schemaMarkup={serviceSchema}>
  <Header />
  <main id="main-content">
    <section class="route-hero">
      <div class="container text-center">
        <span class="heritage-pill">Pilgrimage Route • NH 52 • Since 2008</span>
        <h1 class="route-title">Ajmer to Mathura–Vrindavan Taxi</h1>
        <p class="route-subtitle">Fixed One-Way Sedan Fare ₹4,500 • 330 km • ~5 Hours • Pilgrimage Cab 24/7</p>
        <div class="hero-fare-pills">
          <div class="h-pill">Dzire / Etios: <strong>₹4,500</strong></div>
          <div class="h-pill">Ertiga 6-Seater: <strong>₹6,500</strong></div>
          <div class="h-pill">Innova Crysta: <strong>₹9,500</strong></div>
        </div>
      </div>
    </section>

    <section class="route-content-section">
      <div class="container">
        <div class="route-grid">
          <div class="route-main">
            <span class="section-subtitle">Sacred Pilgrimage from Ajmer to Lord Krishna's Birthplace</span>
            <h2 class="section-title">Ajmer to Mathura–Vrindavan Pilgrimage Cab</h2>
            <p>
              Ajmer, home to the revered Dargah Sharif of Hazrat Khwaja Moinuddin Chishti, and Mathura–Vrindavan, the divine birthplace of Lord Krishna — two of India's most sacred pilgrimage destinations can now be visited in one comfortable road journey. We have been running this spiritual corridor since 2008, serving pilgrims, families, and religious groups.
            </p>
            <p>
              Our route passes through Jaipur and then continues east on NH 52 towards Bharatpur and Mathura. The road quality is excellent and our drivers are well-versed with the temple locations in both Mathura and Vrindavan.
            </p>

            <h3 class="tier-heading">Verified Fare Breakdown (Ajmer ➔ Mathura–Vrindavan)</h3>
            <div class="pricing-cards-row">
              <div class="p-card">
                <span class="p-type">Comfort Sedan</span>
                <h4 class="p-car">Maruti Swift Dzire</h4>
                <div class="p-fare">₹4,500 <small>one-way</small></div>
                <ul class="p-features"><li>✓ 4 Passenger Seats</li><li>✓ 2 Large Bags</li><li>✓ Full AC</li><li>✓ Doorstep Pickup</li></ul>
                <a href={waSedan} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--sm p-btn">Book Sedan @ ₹4,500</a>
              </div>
              <div class="p-card featured-p-card">
                <span class="p-type gold">Family Pilgrimage — Best Value</span>
                <h4 class="p-car">Maruti Ertiga</h4>
                <div class="p-fare">₹6,500 <small>one-way</small></div>
                <ul class="p-features"><li>✓ 6 Passenger Seats</li><li>✓ 3–4 Luggage Bags</li><li>✓ Dual AC</li><li>✓ Extra Comfort for Elders</li></ul>
                <a href={waErtiga} target="_blank" rel="noopener noreferrer" class="btn btn--gold btn--sm p-btn">Book Ertiga @ ₹6,500</a>
              </div>
              <div class="p-card">
                <span class="p-type">Luxury MUV</span>
                <h4 class="p-car">Toyota Innova Crysta</h4>
                <div class="p-fare">₹9,500 <small>one-way</small></div>
                <ul class="p-features"><li>✓ 6/7 Captain Seats</li><li>✓ 4+ Suitcases</li><li>✓ Premium Ride</li><li>✓ Ideal for Large Families</li></ul>
                <a href={waInnova} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--sm p-btn">Book Crysta @ ₹9,500</a>
              </div>
            </div>

            <div class="route-itinerary-box">
              <h3>Temples & Places We Cover in Mathura–Vrindavan</h3>
              <ul>
                <li>• <strong>Mathura:</strong> Dwarkadhish Temple, Krishna Janmabhoomi (Birthplace), Vishram Ghat, Jama Masjid, Government Museum.</li>
                <li>• <strong>Vrindavan (12 km from Mathura):</strong> Banke Bihari Temple, ISKCON Temple (Hare Krishna), Prem Mandir, Radha Raman Temple, Shri Radha Damodar Temple.</li>
                <li>• <strong>Gokul & Barsana (Optional):</strong> Available as add-ons with additional charges for extended sightseeing.</li>
              </ul>
            </div>
          </div>

          <aside class="route-sidebar">
            <div class="sidebar-box">
              <h3 class="side-title">Quick Route Summary</h3>
              <div class="side-list">
                <div class="side-item"><span class="s-label">Origin:</span><span class="s-val">Ajmer / Pushkar</span></div>
                <div class="side-item"><span class="s-label">Destination:</span><span class="s-val">Mathura & Vrindavan</span></div>
                <div class="side-item"><span class="s-label">Highway:</span><span class="s-val">NH 52 via Jaipur</span></div>
                <div class="side-item"><span class="s-label">Distance:</span><span class="s-val">~330 km</span></div>
                <div class="side-item"><span class="s-label">Travel Time:</span><span class="s-val">5 to 6 Hours</span></div>
                <div class="side-item"><span class="s-label">Starting Price:</span><span class="s-val gold-text">₹4,500 (Sedan)</span></div>
              </div>
              <div class="side-actions">
                <a href={waSedan} target="_blank" rel="noopener noreferrer" class="btn btn--gold btn--sm full-w">WhatsApp Instant Quote</a>
                <a href={`tel:${business.phone}`} class="btn btn--outline-primary btn--sm full-w">Call: {business.phoneFormatted}</a>
              </div>
            </div>
            <div class="sidebar-trust">
              <h4>Pilgrimage Experts Since 2008</h4>
              <p>We handle pilgrimages from Dargah Sharif Ajmer to Mathura and beyond. Respectful drivers, zero advance, transparent pricing.</p>
            </div>
          </aside>
        </div>
      </div>
    </section>
    <FAQ items={faqs} title="Ajmer to Mathura Taxi FAQs" subtitle="Frequently Asked Questions" />
  </main>
  <Footer />
  <WhatsAppBubble />
  <MobileBottomBar />
</Layout>

<style>
  .route-hero { background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%); color: #FFF; padding: calc(var(--header-height, 74px) + 38px) 0 36px; border-bottom: 3px solid var(--color-accent); }
  .heritage-pill { display: inline-block; background: rgba(197,155,39,0.2); border: 1px solid var(--color-accent); color: var(--color-accent-light); font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; padding: 4px 14px; border-radius: var(--radius-full); margin-bottom: 12px; }
  .route-title { font-family: var(--font-heading); font-size: clamp(2rem, 4vw, 2.75rem); color: #FFF; margin-bottom: 6px; }
  .route-subtitle { font-size: 1.125rem; color: rgba(255,255,255,0.9); max-width: 720px; margin: 0 auto var(--space-lg); }
  .hero-fare-pills { display: flex; justify-content: center; gap: var(--space-sm); flex-wrap: wrap; }
  .h-pill { background: rgba(0,0,0,0.3); border: 1px solid rgba(197,155,39,0.4); padding: 6px 14px; border-radius: var(--radius-full); font-size: 0.875rem; color: #F8E6B8; }
  .h-pill strong { color: #FFF; }
  .route-content-section { padding: var(--space-4xl) 0; background: #FFF; }
  .route-grid { display: grid; grid-template-columns: 1fr 340px; gap: var(--space-3xl); }
  .tier-heading { font-family: var(--font-heading); font-size: 1.375rem; color: var(--color-primary); margin: var(--space-2xl) 0 var(--space-md); }
  .pricing-cards-row { display: grid; grid-template-columns: repeat(3,1fr); gap: var(--space-md); margin-bottom: var(--space-2xl); }
  .p-card { background: #FFF; border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-lg); display: flex; flex-direction: column; box-shadow: 0 4px 12px rgba(34,24,28,0.05); }
  .featured-p-card { border: 2px solid var(--color-accent); background: var(--color-cream); }
  .p-type { font-size: 0.75rem; font-weight: 700; color: var(--color-primary); text-transform: uppercase; display: block; margin-bottom: 2px; }
  .p-type.gold { color: var(--color-accent-dark); }
  .p-car { font-family: var(--font-heading); font-size: 1.125rem; color: var(--color-text); margin-bottom: var(--space-xs); }
  .p-fare { font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; color: var(--color-primary); margin-bottom: var(--space-md); }
  .p-fare small { font-size: 0.75rem; font-weight: 500; color: var(--color-text-muted); }
  .p-features { list-style: none; padding: 0; margin: 0 0 var(--space-lg); display: flex; flex-direction: column; gap: 6px; font-size: 0.8125rem; color: var(--color-text); flex: 1; }
  .p-btn { width: 100%; justify-content: center; margin-top: auto; }
  .route-itinerary-box { background: var(--color-cream); border: 1px solid var(--color-border); border-left: 4px solid var(--color-accent); padding: var(--space-xl); border-radius: var(--radius-md); }
  .route-itinerary-box h3 { font-family: var(--font-heading); color: var(--color-primary); font-size: 1.25rem; margin-bottom: var(--space-sm); }
  .route-itinerary-box ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; font-size: 0.875rem; color: var(--color-text); }
  .route-sidebar { display: flex; flex-direction: column; gap: var(--space-lg); }
  .sidebar-box { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-xl); }
  .side-title { font-family: var(--font-heading); font-size: 1.125rem; color: var(--color-primary); margin-bottom: var(--space-md); padding-bottom: 6px; border-bottom: 2px solid var(--color-accent); }
  .side-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: var(--space-lg); }
  .side-item { display: flex; justify-content: space-between; font-size: 0.84375rem; padding-bottom: 4px; border-bottom: 1px dashed var(--color-border); }
  .s-label { color: var(--color-text-muted); }
  .s-val { font-weight: 600; color: var(--color-text); }
  .gold-text { color: var(--color-primary); font-weight: 700; }
  .side-actions { display: flex; flex-direction: column; gap: 8px; }
  .full-w { width: 100%; justify-content: center; }
  .sidebar-trust { background: var(--color-cream); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-lg); }
  .sidebar-trust h4 { font-family: var(--font-heading); color: var(--color-primary); font-size: 1rem; margin-bottom: 4px; }
  .sidebar-trust p { font-size: 0.8125rem; color: var(--color-text-muted); line-height: 1.5; margin: 0; }
  @media (max-width: 992px) { .route-grid { grid-template-columns: 1fr; } .pricing-cards-row { grid-template-columns: 1fr; } }
</style>
