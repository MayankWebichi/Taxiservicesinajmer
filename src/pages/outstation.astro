---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header/Header.astro";
import Footer from "@/components/Footer/Footer.astro";
import PopularRoutes from "@/components/Routes/PopularRoutes.astro";
import FleetComparison from "@/components/Vehicles/FleetComparison.astro";
import FAQ from "@/components/FAQ/FAQ.astro";
import WhatsAppBubble from "@/components/WhatsApp/WhatsAppBubble.astro";
import MobileBottomBar from "@/components/MobileBottomBar/MobileBottomBar.astro";
import { createWhatsAppBookingUrl } from "@/utils/whatsapp";

const pageTitle = "Outstation Taxi Service in Ajmer | One-Way & Round Trip (Since 2008)";
const pageDescription = "Reliable outstation cabs from Ajmer & Pushkar to Jaipur, Delhi, Udaipur, Jodhpur, and beyond. Verified one-way rates from ₹10/km. 24/7 highway-experienced drivers.";
const waUrl = createWhatsAppBookingUrl({ tripType: "Outstation Cab" });
---

<Layout title={pageTitle} description={pageDescription} canonicalPath="/outstation/">
  <Header />

  <main id="main-content">
    <section class="page-banner">
      <div class="container text-center">
        <span class="heritage-pill">Intercity Travel Specialists</span>
        <h1 class="page-title">Outstation Taxi Service in Ajmer</h1>
        <p class="page-subtitle">Punctual Highway Cabs for One-Way Drops, Return Trips &amp; Multi-City Tours</p>
      </div>
    </section>

    <!-- Outstation Benefits Section -->
    <section class="outstation-intro-section">
      <div class="container">
        <div class="intro-grid">
          <div class="intro-box">
            <span class="box-tag">One-Way Drops</span>
            <h3>Pay Only One Side</h3>
            <p>Traveling to Jaipur, Delhi, or Udaipur for a flight, train, or meeting? Book our one-way taxi service and never pay return fare charges. Doorstep pickup in Ajmer or Pushkar.</p>
          </div>
          <div class="intro-box">
            <span class="box-tag">Round Trips</span>
            <h3>Dedicated Vehicle &amp; Driver</h3>
            <p>Planning a pilgrimage to Khatu Shyam Ji, Salasar Balaji, or a family vacation to Udaipur and Mount Abu? The chauffeur stays dedicated to your group for the entire itinerary.</p>
          </div>
          <div class="intro-box">
            <span class="box-tag">Transparent Fares</span>
            <h3>Zero Toll Surprises</h3>
            <p>We quote exact per-km rates with clear guidelines on standard toll taxes, state road taxes, and driver night allowances. No hidden billing extras.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Popular Routes Component -->
    <PopularRoutes limit={10} showAllLink={false} />

    <!-- Fleet Comparison Table -->
    <FleetComparison />

    <!-- Outstation Specific FAQs -->
    <FAQ 
      title="Outstation Travel FAQs" 
      subtitle="Know Before You Book" 
    />
  </main>

  <Footer />
  <WhatsAppBubble />
  <MobileBottomBar />
</Layout>

<style>
  .page-banner {
    background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
    color: #FFFFFF;
    padding: calc(var(--header-height, 72px) + 38px) 0 36px;
    border-bottom: 3px solid var(--color-accent);
  }

  .heritage-pill {
    display: inline-block;
    background: rgba(197, 155, 39, 0.2);
    border: 1px solid var(--color-accent);
    color: var(--color-accent-light);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 4px 14px;
    border-radius: var(--radius-full);
    margin-bottom: 12px;
  }

  .page-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 2.75rem);
    color: #FFFFFF;
    margin-bottom: 6px;
  }

  .page-subtitle {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.9);
    max-width: 650px;
    margin: 0 auto;
  }

  .outstation-intro-section {
    padding: calc(var(--header-height, 74px) + 38px) 0 36px;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }

  .intro-box {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    box-shadow: 0 4px 16px rgba(34, 24, 28, 0.05);
  }

  .box-tag {
    display: inline-block;
    background: var(--color-cream);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-xs);
    border: 1px solid var(--color-border);
  }

  .intro-box h3 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--color-primary);
    margin-bottom: 8px;
  }

  .intro-box p {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 992px) {
    .intro-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
