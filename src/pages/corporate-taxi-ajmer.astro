---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header/Header.astro";
import Footer from "@/components/Footer/Footer.astro";
import FAQ from "@/components/FAQ/FAQ.astro";
import WhatsAppBubble from "@/components/WhatsApp/WhatsAppBubble.astro";
import MobileBottomBar from "@/components/MobileBottomBar/MobileBottomBar.astro";
import { business } from "@/data/business";
import { createWhatsAppBookingUrl } from "@/utils/whatsapp";
import { generateServiceSchema } from "@/utils/seo";

const pageTitle = "Corporate Taxi Ajmer | Office Cab Service — Taxi Services in Ajmer (2026)";
const pageDescription = "Book corporate cab service in Ajmer for employee transfers, client pickups, and airport drops. Monthly contracts available. AC vehicles, uniformed drivers, billing support. 24/7 available.";

const waMonthly  = createWhatsAppBookingUrl({ tripType: "Corporate Monthly Contract", customMessage: "Hello, I am interested in a corporate monthly cab contract for office employee transfers. Please share rate card and terms." });
const waAirport  = createWhatsAppBookingUrl({ tripType: "Corporate Airport Transfer", customMessage: "Hello, I need a corporate cab for airport transfer. Please share availability and rate." });
const waGeneral  = createWhatsAppBookingUrl({ tripType: "Corporate Cab Ajmer", customMessage: "Hello, I need corporate cab service for my office/business. Please share rate card." });

const serviceSchema = generateServiceSchema(
  "Corporate Taxi Service Ajmer",
  "Professional corporate cab and employee transportation service in Ajmer. Monthly contracts, billing support, uniformed drivers, 24/7 availability.",
  `${business.website}/corporate-taxi-ajmer/`
);

const faqs = [
  { question: "Do you offer monthly corporate cab contracts in Ajmer?", answer: "Yes, we offer monthly cab contracts for employee transportation, executive transfers, and daily office commute. Please contact us for a customized rate card based on your requirements.", category: "Booking" as const },
  { question: "Can you provide cabs for client/guest airport pickups from Kishangarh Airport?", answer: "Yes, we specialize in Kishangarh Airport (VIKG) transfers for corporate clients and their guests. Our drivers track flight status and adjust pickup time accordingly.", category: "Booking" as const },
  { question: "Do you provide GST invoices for corporate billing?", answer: "Yes, we provide proper GST-compliant invoices for all corporate bookings. Monthly billing with MIS reports can be arranged for companies with regular requirements.", category: "Booking" as const },
  { question: "Are your drivers suitable for executive client transfers?", answer: "Our drivers for corporate bookings are formally dressed, trained in professional etiquette, and maintain strict confidentiality. Vehicles are always impeccably clean.", category: "Booking" as const }
];
---

<Layout title={pageTitle} description={pageDescription} canonicalPath="/corporate-taxi-ajmer/" schemaMarkup={serviceSchema}>
  <Header />
  <main id="main-content">
    <section class="route-hero corporate-hero">
      <div class="container text-center">
        <span class="heritage-pill">Corporate Cab Service • Ajmer • GST Billing Available</span>
        <h1 class="route-title">Corporate Taxi Service in Ajmer</h1>
        <p class="route-subtitle">Employee Transfers · Client Pickups · Airport Drops · Monthly Contracts · Professional Uniformed Drivers</p>
        <div class="cta-row">
          <a href={waMonthly} target="_blank" rel="noopener noreferrer" class="btn btn--gold">Get Corporate Rate Card</a>
          <a href={`tel:${business.phone}`} class="btn btn--outline-white">Call: {business.phoneFormatted}</a>
        </div>
      </div>
    </section>

    <section class="route-content-section">
      <div class="container">
        <div class="route-grid">
          <div class="route-main">
            <span class="section-subtitle">Trusted by Ajmer's Business Community Since 2008</span>
            <h2 class="section-title">Professional Corporate Cab Service — Ajmer</h2>
            <p>
              We provide reliable, professional corporate cab and employee transportation services for businesses, government offices, hospitals, hotels, and industrial units across Ajmer. From daily employee pickup and drop to one-time executive airport transfers — we handle all corporate mobility requirements with the professionalism your business demands.
            </p>

            <h3 class="tier-heading">Corporate Services We Offer</h3>
            <div class="service-cards">
              <div class="svc-card">
                <div class="svc-icon">🏢</div>
                <h4>Employee Daily Commute</h4>
                <p>Regular morning and evening office pickup and drop for employees from their homes. Monthly contract with MIS reports.</p>
                <a href={waMonthly} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--sm">Get Monthly Rate</a>
              </div>
              <div class="svc-card svc-card--featured">
                <div class="svc-icon">👔</div>
                <h4>Executive Client Transfers</h4>
                <p>Premium Innova Crysta with uniformed driver for VIP client/guest pickups from Kishangarh Airport, Jaipur Airport, or railway station.</p>
                <a href={waAirport} target="_blank" rel="noopener noreferrer" class="btn btn--gold btn--sm">Book Executive Cab</a>
              </div>
              <div class="svc-card">
                <div class="svc-icon">✈️</div>
                <h4>Airport/Station Transfers</h4>
                <p>Corporate airport drops and pickups from Kishangarh (KQH), Jaipur (JAI), and Delhi (DEL) airports. Flight tracking included.</p>
                <a href={waAirport} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--sm">Book Airport Cab</a>
              </div>
              <div class="svc-card">
                <div class="svc-icon">🗓️</div>
                <h4>Event & Conference Cabs</h4>
                <p>Multi-vehicle arrangements for corporate events, trade fairs, and conferences in Ajmer and Pushkar.</p>
                <a href={waGeneral} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--sm">Enquire Now</a>
              </div>
            </div>

            <h3 class="tier-heading">Why Businesses Choose Us</h3>
            <div class="why-grid">
              <div class="why-item"><span class="why-icon">📄</span><strong>GST Invoices</strong><p>Proper billing for corporate accounts</p></div>
              <div class="why-item"><span class="why-icon">⏰</span><strong>100% On Time</strong><p>Driver sends ETA before every pickup</p></div>
              <div class="why-item"><span class="why-icon">🎽</span><strong>Uniformed Drivers</strong><p>Professional appearance at all times</p></div>
              <div class="why-item"><span class="why-icon">📊</span><strong>Monthly Reports</strong><p>Trip logs & MIS for HR/Finance</p></div>
              <div class="why-item"><span class="why-icon">📞</span><strong>Dedicated Support</strong><p>Dedicated coordinator for your account</p></div>
              <div class="why-item"><span class="why-icon">🔒</span><strong>Confidential</strong><p>Driver NDA available for sensitive clients</p></div>
            </div>
          </div>

          <aside class="route-sidebar">
            <div class="sidebar-box">
              <h3 class="side-title">Corporate Enquiry</h3>
              <p style="font-size:0.875rem; color:var(--color-text-muted); margin-bottom:var(--space-md);">Share your company name, number of employees/trips, and routes for a customized rate card.</p>
              <div class="side-actions">
                <a href={waMonthly} target="_blank" rel="noopener noreferrer" class="btn btn--gold btn--sm full-w">WhatsApp Enquiry</a>
                <a href={`tel:${business.phone}`} class="btn btn--outline-primary btn--sm full-w">Call: {business.phoneFormatted}</a>
                <a href={waGeneral} target="_blank" rel="noopener noreferrer" class="btn btn--outline-primary btn--sm full-w" style="font-size:0.8125rem">or Custom WhatsApp Enquiry</a>
              </div>
            </div>
            <div class="sidebar-trust">
              <h4>Our Corporate Promise</h4>
              <p>18+ years of reliability. If a corporate vehicle is ever unavailable due to an emergency, we arrange a replacement within 30 minutes — guaranteed.</p>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <FAQ items={faqs} title="Corporate Taxi FAQs — Ajmer" subtitle="Frequently Asked Questions" />
  </main>
  <Footer />
  <WhatsAppBubble />
  <MobileBottomBar />
</Layout>

<style>
  .route-hero { background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%); color: #FFF; padding: calc(var(--header-height, 74px) + 38px) 0 36px; border-bottom: 3px solid var(--color-accent); }
  .corporate-hero { background: linear-gradient(135deg, #0A0F1E 0%, #1A2540 50%, #1F3560 100%); }
  .heritage-pill { display: inline-block; background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.4); color: rgba(255,255,255,0.95); font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; padding: 4px 14px; border-radius: var(--radius-full); margin-bottom: 12px; }
  .route-title { font-family: var(--font-heading); font-size: clamp(2rem, 4vw, 2.75rem); color: #FFF; margin-bottom: 6px; }
  .route-subtitle { font-size: 1.125rem; color: rgba(255,255,255,0.9); max-width: 720px; margin: 0 auto var(--space-lg); }
  .cta-row { display: flex; gap: var(--space-sm); justify-content: center; flex-wrap: wrap; }
  .btn--outline-white { border: 2px solid rgba(255,255,255,0.5); color: #FFF; background: transparent; padding: 10px 20px; border-radius: var(--radius-full); font-weight: 700; font-size: 0.9375rem; }
  .route-content-section { padding: var(--space-4xl) 0; background: #FFF; }
  .route-grid { display: grid; grid-template-columns: 1fr 340px; gap: var(--space-3xl); }
  .tier-heading { font-family: var(--font-heading); font-size: 1.375rem; color: var(--color-primary); margin: var(--space-xl) 0 var(--space-md); }
  .service-cards { display: grid; grid-template-columns: repeat(2,1fr); gap: var(--space-md); margin-bottom: var(--space-xl); }
  .svc-card { background: #FFF; border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-lg); display: flex; flex-direction: column; gap: var(--space-sm); box-shadow: 0 4px 12px rgba(34,24,28,0.05); }
  .svc-card--featured { border: 2px solid var(--color-accent); background: var(--color-cream); }
  .svc-icon { font-size: 2rem; }
  .svc-card h4 { font-family: var(--font-heading); font-size: 1rem; color: var(--color-primary); margin: 0; }
  .svc-card p { font-size: 0.8125rem; color: var(--color-text-muted); line-height: 1.5; flex: 1; margin: 0; }
  .why-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: var(--space-md); }
  .why-item { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-md); }
  .why-icon { font-size: 1.5rem; display: block; margin-bottom: 6px; }
  .why-item strong { display: block; font-size: 0.875rem; color: var(--color-primary); margin-bottom: 4px; }
  .why-item p { font-size: 0.78rem; color: var(--color-text-muted); margin: 0; }
  .route-sidebar { display: flex; flex-direction: column; gap: var(--space-lg); }
  .sidebar-box { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-xl); }
  .side-title { font-family: var(--font-heading); font-size: 1.125rem; color: var(--color-primary); margin-bottom: var(--space-sm); padding-bottom: 6px; border-bottom: 2px solid var(--color-accent); }
  .side-actions { display: flex; flex-direction: column; gap: 8px; }
  .full-w { width: 100%; justify-content: center; }
  .sidebar-trust { background: var(--color-cream); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-lg); }
  .sidebar-trust h4 { font-family: var(--font-heading); color: var(--color-primary); font-size: 1rem; margin-bottom: 4px; }
  .sidebar-trust p { font-size: 0.8125rem; color: var(--color-text-muted); line-height: 1.5; margin: 0; }
  @media (max-width: 992px) { .route-grid { grid-template-columns: 1fr; } .service-cards { grid-template-columns: 1fr; } .why-grid { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 600px) { .why-grid { grid-template-columns: 1fr; } }
</style>
