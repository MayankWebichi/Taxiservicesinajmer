---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header/Header.astro";
import Footer from "@/components/Footer/Footer.astro";
import FAQ from "@/components/FAQ/FAQ.astro";
import WhatsAppBubble from "@/components/WhatsApp/WhatsAppBubble.astro";
import MobileBottomBar from "@/components/MobileBottomBar/MobileBottomBar.astro";
import { business } from "@/data/business";
import { createWhatsAppBookingUrl } from "@/utils/whatsapp";
import { generateServiceSchema } from "@/utils/seo";

const pageTitle = "Wedding Taxi Ajmer | Marriage Cab Booking — Panwar Taxi (2026)";
const pageDescription = "Book wedding & marriage cab service in Ajmer. AC Sedan, Innova Crysta & Tempo Traveller for baraat, venue drops, and guest transfers. Decorated vehicles available. Call 24/7.";

const waInnova = createWhatsAppBookingUrl({ vehicle: "Toyota Innova Crysta", tripType: "Wedding / Marriage Cab", customMessage: "Hello Panwar Taxi Ajmer, I need a cab for a wedding event in Ajmer. Please share details for Innova Crysta and availability." });
const waTempo  = createWhatsAppBookingUrl({ vehicle: "Tempo Traveller", tripType: "Wedding Guest Transfer", customMessage: "Hello Panwar Taxi Ajmer, I need a Tempo Traveller for wedding guest transfers. Please share rate and availability." });
const waGeneral = createWhatsAppBookingUrl({ tripType: "Wedding Cab Ajmer", customMessage: "Hello Panwar Taxi Ajmer, I need cab service for a wedding. Please share vehicle options and rates." });

const serviceSchema = generateServiceSchema(
  "Wedding Taxi Service Ajmer",
  "Premium wedding and marriage cab service in Ajmer. Innova Crysta, decorated sedans, and Tempo Travellers for baraat, venue drops, and wedding guest transfers.",
  `${business.website}/wedding-taxi-ajmer/`
);

const faqs = [
  { question: "Do you provide decorated cabs for weddings in Ajmer?", answer: "Yes, we offer flower-decorated Toyota Innova Crysta and Maruti Ertiga for wedding baraat and venue entry. Decoration charges are minimal and can be arranged with advance booking.", category: "Booking" as const },
  { question: "What vehicles are available for wedding cab service in Ajmer?", answer: "We offer: Maruti Dzire/Etios (Sedan) for guest transfers; Maruti Ertiga/Toyota Innova Crysta for family and baraat; Tempo Traveller (12–17 seater) for large wedding guest groups.", category: "Booking" as const },
  { question: "Can I book multiple cabs for a wedding in Ajmer?", answer: "Yes, we handle multi-vehicle wedding logistics. We can coordinate 2–10+ vehicles for simultaneous guest pickup from different locations, venues, and hotels.", category: "Booking" as const },
  { question: "How far in advance should I book wedding cabs?", answer: "We recommend booking wedding cabs at least 7–15 days in advance, especially for popular wedding seasons (November to February and April to May). Peak season bookings should be made a month in advance.", category: "Booking" as const }
];
---

<Layout title={pageTitle} description={pageDescription} canonicalPath="/wedding-taxi-ajmer/" schemaMarkup={serviceSchema}>
  <Header />
  <main id="main-content">
    <section class="route-hero wedding-hero">
      <div class="container text-center">
        <span class="heritage-pill">Wedding & Marriage Cab Service • Ajmer • Since 2008</span>
        <h1 class="route-title">Wedding Taxi Service in Ajmer</h1>
        <p class="route-subtitle">Premium Cabs for Baraat, Guest Transfers & Venue Drops · Innova Crysta · Tempo Traveller · Decorated Vehicles</p>
        <div class="cta-row">
          <a href={waGeneral} target="_blank" rel="noopener noreferrer" class="btn btn--gold">Book Wedding Cab</a>
          <a href={`tel:${business.phone}`} class="btn btn--outline-white">Call: {business.phoneFormatted}</a>
        </div>
      </div>
    </section>

    <section class="route-content-section">
      <div class="container">
        <div class="route-grid">
          <div class="route-main">
            <span class="section-subtitle">Rajasthan's Most Reliable Wedding Cab Partner</span>
            <h2 class="section-title">Trusted Wedding & Marriage Cab in Ajmer</h2>
            <p>
              Your wedding day deserves nothing but the best. Panwar Taxi has been trusted by hundreds of Ajmer families for wedding cab services since 2008. Whether you need a decorated Innova for the baraat entry, Tempo Travellers to transport your guests from hotels to venues, or a fleet of sedans for post-wedding airport drops — we handle it all with precision and professionalism.
            </p>
            <p>
              We understand that weddings involve complex logistics — multiple pickups, strict timelines, and the need for impeccably clean and reliable vehicles. Our team coordinates multi-vehicle wedding bookings seamlessly so you can focus on your celebration.
            </p>

            <h3 class="tier-heading">Wedding Cab Options</h3>
            <div class="pricing-cards-row">
              <div class="p-card">
                <span class="p-type">Guest Transfer</span>
                <h4 class="p-car">Maruti Swift Dzire</h4>
                <div class="p-fare">₹400<small>/trip</small></div>
                <ul class="p-features">
                  <li>✓ 4 Passenger Seats</li>
                  <li>✓ Airport/Railway → Hotel</li>
                  <li>✓ Hotel → Venue Transfers</li>
                  <li>✓ Book Multiple Units</li>
                </ul>
                <a href={waGeneral} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--sm p-btn">Book Sedan</a>
              </div>

              <div class="p-card featured-p-card">
                <span class="p-type gold">Baraat & Family VIP</span>
                <h4 class="p-car">Toyota Innova Crysta</h4>
                <div class="p-fare">₹3,500<small>/day</small></div>
                <ul class="p-features">
                  <li>✓ 6/7 Captain Seats</li>
                  <li>✓ Flower Decoration Available</li>
                  <li>✓ Ideal for Baraat Entry</li>
                  <li>✓ Premium Comfort for Elders</li>
                </ul>
                <a href={waInnova} target="_blank" rel="noopener noreferrer" class="btn btn--gold btn--sm p-btn">Book Innova</a>
              </div>

              <div class="p-card">
                <span class="p-type">Group Guest Transfer</span>
                <h4 class="p-car">Tempo Traveller</h4>
                <div class="p-fare">₹4,500<small>/day</small></div>
                <ul class="p-features">
                  <li>✓ 12–17 Passenger Seats</li>
                  <li>✓ Pushback AC Seats</li>
                  <li>✓ Large Luggage Racks</li>
                  <li>✓ Best for Group Transfers</li>
                </ul>
                <a href={waTempo} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--sm p-btn">Book Tempo</a>
              </div>
            </div>

            <div class="wedding-services-grid">
              <div class="ws-item">
                <div class="ws-icon">💐</div>
                <h4>Decorated Baraat Cab</h4>
                <p>Flower-decorated Innova or Ertiga for the groom's baraat entry to the venue.</p>
              </div>
              <div class="ws-item">
                <div class="ws-icon">✈️</div>
                <h4>Airport Transfers</h4>
                <p>Pick up outstation wedding guests from Jaipur or Kishangarh Airport.</p>
              </div>
              <div class="ws-item">
                <div class="ws-icon">🏨</div>
                <h4>Hotel Shuttles</h4>
                <p>Scheduled hotel-to-venue and venue-to-hotel runs for all guest hotels.</p>
              </div>
              <div class="ws-item">
                <div class="ws-icon">📋</div>
                <h4>Fleet Coordination</h4>
                <p>We manage 2–10 vehicles simultaneously with a dedicated coordinator.</p>
              </div>
            </div>
          </div>

          <aside class="route-sidebar">
            <div class="sidebar-box">
              <h3 class="side-title">Book Wedding Cabs</h3>
              <p style="font-size:0.875rem; color:var(--color-text-muted); margin-bottom:var(--space-md);">For wedding bookings, please contact us at least 7 days in advance. Multi-vehicle packages available.</p>
              <div class="side-actions">
                <a href={waGeneral} target="_blank" rel="noopener noreferrer" class="btn btn--gold btn--sm full-w">WhatsApp for Quote</a>
                <a href={`tel:${business.phone}`} class="btn btn--outline-primary btn--sm full-w">Call: {business.phoneFormatted}</a>
              </div>
            </div>
            <div class="sidebar-trust">
              <h4>Trusted by 500+ Families</h4>
              <p>Since 2008 we've served hundreds of Ajmer weddings. Our vehicles are always clean, on time, and our drivers are formally dressed for wedding events.</p>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <FAQ items={faqs} title="Wedding Taxi FAQs — Ajmer" subtitle="Frequently Asked Questions" />
  </main>
  <Footer />
  <WhatsAppBubble />
  <MobileBottomBar />
</Layout>

<style>
  .route-hero { background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%); color: #FFF; padding: calc(var(--header-height, 74px) + 38px) 0 36px; border-bottom: 3px solid var(--color-accent); }
  .wedding-hero { background: linear-gradient(135deg, #1A0A1E 0%, #4A1259 50%, #6B1A80 100%); }
  .heritage-pill { display: inline-block; background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.4); color: rgba(255,255,255,0.95); font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; padding: 4px 14px; border-radius: var(--radius-full); margin-bottom: 12px; }
  .route-title { font-family: var(--font-heading); font-size: clamp(2rem, 4vw, 2.75rem); color: #FFF; margin-bottom: 6px; }
  .route-subtitle { font-size: 1.125rem; color: rgba(255,255,255,0.9); max-width: 720px; margin: 0 auto var(--space-lg); }
  .cta-row { display: flex; gap: var(--space-sm); justify-content: center; flex-wrap: wrap; }
  .btn--outline-white { border: 2px solid rgba(255,255,255,0.5); color: #FFF; background: transparent; padding: 10px 20px; border-radius: var(--radius-full); font-weight: 700; font-size: 0.9375rem; }
  .route-content-section { padding: var(--space-4xl) 0; background: #FFF; }
  .route-grid { display: grid; grid-template-columns: 1fr 340px; gap: var(--space-3xl); }
  .tier-heading { font-family: var(--font-heading); font-size: 1.375rem; color: var(--color-primary); margin: var(--space-xl) 0 var(--space-md); }
  .pricing-cards-row { display: grid; grid-template-columns: repeat(3,1fr); gap: var(--space-md); margin-bottom: var(--space-xl); }
  .p-card { background: #FFF; border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-lg); display: flex; flex-direction: column; box-shadow: 0 4px 12px rgba(34,24,28,0.05); }
  .featured-p-card { border: 2px solid var(--color-accent); background: var(--color-cream); }
  .p-type { font-size: 0.75rem; font-weight: 700; color: var(--color-primary); text-transform: uppercase; display: block; margin-bottom: 2px; }
  .p-type.gold { color: var(--color-accent-dark); }
  .p-car { font-family: var(--font-heading); font-size: 1.125rem; color: var(--color-text); margin-bottom: var(--space-xs); }
  .p-fare { font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; color: var(--color-primary); margin-bottom: var(--space-md); }
  .p-fare small { font-size: 0.75rem; font-weight: 500; color: var(--color-text-muted); }
  .p-features { list-style: none; padding: 0; margin: 0 0 var(--space-lg); display: flex; flex-direction: column; gap: 6px; font-size: 0.8125rem; color: var(--color-text); flex: 1; }
  .p-btn { width: 100%; justify-content: center; margin-top: auto; }
  .wedding-services-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: var(--space-md); margin-top: var(--space-xl); }
  .ws-item { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-md); }
  .ws-icon { font-size: 1.75rem; margin-bottom: 8px; }
  .ws-item h4 { font-family: var(--font-heading); font-size: 0.9375rem; color: var(--color-primary); margin-bottom: 6px; }
  .ws-item p { font-size: 0.8125rem; color: var(--color-text-muted); line-height: 1.5; margin: 0; }
  .route-sidebar { display: flex; flex-direction: column; gap: var(--space-lg); }
  .sidebar-box { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-xl); }
  .side-title { font-family: var(--font-heading); font-size: 1.125rem; color: var(--color-primary); margin-bottom: var(--space-sm); padding-bottom: 6px; border-bottom: 2px solid var(--color-accent); }
  .side-actions { display: flex; flex-direction: column; gap: 8px; }
  .full-w { width: 100%; justify-content: center; }
  .sidebar-trust { background: var(--color-cream); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-lg); }
  .sidebar-trust h4 { font-family: var(--font-heading); color: var(--color-primary); font-size: 1rem; margin-bottom: 4px; }
  .sidebar-trust p { font-size: 0.8125rem; color: var(--color-text-muted); line-height: 1.5; margin: 0; }
  @media (max-width: 992px) { .route-grid { grid-template-columns: 1fr; } .pricing-cards-row { grid-template-columns: 1fr; } .wedding-services-grid { grid-template-columns: 1fr; } }
</style>
