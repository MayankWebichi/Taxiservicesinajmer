---
import { seoRoutesData, type SeoRouteItem } from "@/data/seoRoutesData";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header/Header.astro";
import Footer from "@/components/Footer/Footer.astro";
import WhatsAppBubble from "@/components/WhatsApp/WhatsAppBubble.astro";
import MobileBottomBar from "@/components/MobileBottomBar/MobileBottomBar.astro";
import { business } from "@/data/business";
import { createWhatsAppBookingUrl } from "@/utils/whatsapp";
import { generateServiceSchema, generateFAQSchema } from "@/utils/seo";

export async function getStaticPaths() {
  return seoRoutesData.map((route) => ({
    params: { route: route.slug },
    props: { route },
  }));
}

interface Props {
  route: SeoRouteItem;
}

const { route } = Astro.props;

const waSedan = createWhatsAppBookingUrl({
  pickup: route.from,
  destination: route.to,
  vehicle: `Maruti Swift Dzire / Toyota Etios (₹${route.sedanFare.toLocaleString('en-IN')})`,
  tripType: `${route.from} to ${route.to} Taxi`,
  customMessage: `Hello! I want to book an AC Sedan (Dzire/Etios) for ${route.from} to ${route.to} taxi at ₹${route.sedanFare.toLocaleString('en-IN')}. Please confirm availability.`
});

const waErtiga = createWhatsAppBookingUrl({
  pickup: route.from,
  destination: route.to,
  vehicle: `Maruti Ertiga 6-Seater (₹${route.suvFare.toLocaleString('en-IN')})`,
  tripType: `${route.from} to ${route.to} Taxi`,
  customMessage: `Hello! I want to book a 6-Seater Maruti Ertiga for ${route.from} to ${route.to} taxi at ₹${route.suvFare.toLocaleString('en-IN')}. Please confirm availability.`
});

const waCrysta = createWhatsAppBookingUrl({
  pickup: route.from,
  destination: route.to,
  vehicle: `Toyota Innova Crysta (₹${route.crystaFare.toLocaleString('en-IN')})`,
  tripType: `${route.from} to ${route.to} Taxi`,
  customMessage: `Hello! I want to book a Toyota Innova Crysta for ${route.from} to ${route.to} taxi at ₹${route.crystaFare.toLocaleString('en-IN')}. Please confirm availability.`
});

const serviceSchema = generateServiceSchema({
  name: `${route.from} to ${route.to} Taxi Service`,
  description: route.metaDescription,
  url: `${business.website}/${route.slug}/`,
  providerName: business.name,
  providerUrl: business.website,
  price: String(route.sedanFare),
  priceCurrency: "INR"
});

const faqSchema = generateFAQSchema(route.faqs);
---

<Layout
  title={route.title}
  description={route.metaDescription}
  canonicalPath={`/${route.slug}/`}
  schemaMarkup={serviceSchema}
>
  <Header />

  <main id="main-content">
    <!-- Hero Banner -->
    <section class="seo-route-hero">
      <div class="container text-center">
        <span class="heritage-pill">Verified Highway Taxi Rate • Serving Since 2008</span>
        <h1 class="route-title">{route.from} to {route.to} Taxi Service</h1>
        <p class="route-subtitle">{route.heroSubtitle}</p>

        <!-- Route Spec Strip in Hero -->
        <div class="hero-specs-strip">
          <div class="spec-chip">
            <span class="chip-icon">📍</span>
            <span>Distance: <strong>~{route.distanceKm} km</strong></span>
          </div>
          <div class="spec-chip">
            <span class="chip-icon">⏱️</span>
            <span>Est. Time: <strong>{route.estimatedTime}</strong></span>
          </div>
          <div class="spec-chip">
            <span class="chip-icon">🛣️</span>
            <span>Highway: <strong>{route.highway}</strong></span>
          </div>
        </div>

        <!-- Pricing Pills -->
        <div class="hero-fare-pills">
          <div class="h-pill">
            <span class="car-tag">🚗 Sedan:</span>
            <strong>₹{route.sedanFare.toLocaleString('en-IN')}</strong>
          </div>
          <div class="h-pill gold">
            <span class="car-tag">🚙 Ertiga 6-Str:</span>
            <strong>₹{route.suvFare.toLocaleString('en-IN')}</strong>
          </div>
          <div class="h-pill">
            <span class="car-tag">🚐 Crysta:</span>
            <strong>₹{route.crystaFare.toLocaleString('en-IN')}</strong>
          </div>
        </div>

        <!-- Hero Action Buttons -->
        <div class="hero-cta-btns">
          <a href={waSedan} target="_blank" rel="noopener noreferrer" class="btn-hero-action btn-hero-action--wa">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.087-.178.181-.077.355.101.174.449.741.964 1.2.662.591 1.221.774 1.394.861.173.087.275.072.376-.044.101-.116.433-.506.549-.68.116-.174.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.044.073.044.42-.1 1.016z"/></svg>
            <span>Book Cab on WhatsApp</span>
          </a>
          <a href={`tel:${business.phone}`} class="btn-hero-action btn-hero-action--call">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
            <span>Call 24/7: {business.phoneFormatted}</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Main Content Section -->
    <section class="route-content-section">
      <div class="container">
        
        <!-- Mobile Quick CTA Bar (< 768px) -->
        <div class="route-mobile-cta-bar">
          <a href={waSedan} target="_blank" rel="noopener noreferrer" class="m-cta-btn m-cta-btn--wa">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.087-.178.181-.077.355.101.174.449.741.964 1.2.662.591 1.221.774 1.394.861.173.087.275.072.376-.044.101-.116.433-.506.549-.68.116-.174.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.044.073.044.42-.1 1.016z"/></svg>
            <span>Book on WhatsApp</span>
          </a>
          <a href={`tel:${business.phone}`} class="m-cta-btn m-cta-btn--call">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
            <span>Call 24/7</span>
          </a>
        </div>

        <div class="route-grid">
          <!-- Main Content Area -->
          <div class="route-main">
            <!-- Route Overview Block -->
            <div class="content-block">
              <span class="section-subtitle">Comfortable Highway Journey</span>
              <h2 class="section-title">Reliable {route.from} to {route.to} Cab Rental</h2>
              <p>
                Looking for a dependable, private, and air-conditioned cab between <strong>{route.from}</strong> and <strong>{route.to}</strong>? With over 18 years of Rajasthan transport experience since 2008, <strong>Taxi Services in Ajmer</strong> delivers punctual doorstep pickups, experienced chauffeurs, and 100% transparent pricing.
              </p>
              <p>
                The journey covers roughly <strong>{route.distanceKm} km</strong> via <strong>{route.highway}</strong>, taking approximately <strong>{route.estimatedTime}</strong>. Whether you need an early-morning train/flight transfer, a family pilgrimage trip, or a corporate outstation commute, our clean vehicles and verified drivers ensure maximum comfort.
              </p>
            </div>

            <!-- Vehicle Pricing Cards -->
            <div class="content-block">
              <div class="block-header">
                <div>
                  <h3 class="tier-heading">Verified Fares ({route.from} ➔ {route.to})</h3>
                  <p class="tier-subtext">Direct-operator pricing with doorstep pickup, chilled AC, sanitized interior, and no hidden booking fees.</p>
                </div>
                <span class="live-rate-tag"><span class="pulse-dot"></span> LIVE 2026 RATES</span>
              </div>

              <div class="pricing-cards-row">
                <!-- 1. Sedan -->
                <div class="p-card">
                  <div class="p-card-top">
                    <span class="p-type">Comfort Sedan</span>
                    <h4 class="p-car">Maruti Dzire / Etios</h4>
                  </div>
                  <div class="p-image-wrap">
                    <img 
                      src="/images/vehicles/Maruti%20Swift%20Dzire.png" 
                      alt={`Maruti Swift Dzire for ${route.from} to ${route.to}`}
                      width="240"
                      height="140"
                      loading="lazy"
                    />
                  </div>
                  <div class="p-fare">
                    <span class="currency">₹</span><span class="amount">{route.sedanFare.toLocaleString('en-IN')}</span>
                    <span class="fare-tag">Fixed Fare</span>
                  </div>
                  <ul class="p-features">
                    <li>✓ 4 Passenger Seats with Chilled AC</li>
                    <li>✓ 2 Medium Luggage Bags</li>
                    <li>✓ Doorstep Pickup &amp; Direct Drop</li>
                    <li>✓ Punctual, Background-Checked Driver</li>
                  </ul>
                  <a href={waSedan} target="_blank" rel="noopener noreferrer" class="p-btn p-btn--primary">
                    <span>Book Sedan @ ₹{route.sedanFare.toLocaleString('en-IN')}</span>
                    <span class="arr">&rarr;</span>
                  </a>
                </div>

                <!-- 2. Ertiga (Featured) -->
                <div class="p-card featured-p-card">
                  <div class="card-badge">Family &amp; Luggage Bestseller</div>
                  <div class="p-card-top">
                    <span class="p-type gold">Spacious 6-Seater MPV</span>
                    <h4 class="p-car">Maruti Suzuki Ertiga</h4>
                  </div>
                  <div class="p-image-wrap">
                    <img 
                      src="/images/vehicles/Maruti%20Suzuki%20Ertiga.png" 
                      alt={`Maruti Suzuki Ertiga for ${route.from} to ${route.to}`}
                      width="240"
                      height="140"
                      loading="lazy"
                    />
                  </div>
                  <div class="p-fare gold-fare">
                    <span class="currency">₹</span><span class="amount">{route.suvFare.toLocaleString('en-IN')}</span>
                    <span class="fare-tag gold-tag">Best Value</span>
                  </div>
                  <ul class="p-features">
                    <li>✓ 6 Comfortable Passenger Seats</li>
                    <li>✓ Dual Chilled Air Conditioning Vents</li>
                    <li>✓ Extra Legroom for Elders &amp; Children</li>
                    <li>✓ Ample Space for 3–4 Large Bags</li>
                  </ul>
                  <a href={waErtiga} target="_blank" rel="noopener noreferrer" class="p-btn p-btn--gold">
                    <span>Book Ertiga @ ₹{route.suvFare.toLocaleString('en-IN')}</span>
                    <span class="arr">&rarr;</span>
                  </a>
                </div>

                <!-- 3. Innova Crysta -->
                <div class="p-card">
                  <div class="p-card-top">
                    <span class="p-type">VIP Luxury SUV</span>
                    <h4 class="p-car">Toyota Innova Crysta</h4>
                  </div>
                  <div class="p-image-wrap">
                    <img 
                      src="/images/vehicles/inova%20cresta.png" 
                      alt={`Toyota Innova Crysta for ${route.from} to ${route.to}`}
                      width="240"
                      height="140"
                      loading="lazy"
                    />
                  </div>
                  <div class="p-fare">
                    <span class="currency">₹</span><span class="amount">{route.crystaFare.toLocaleString('en-IN')}</span>
                    <span class="fare-tag">VIP Travel</span>
                  </div>
                  <ul class="p-features">
                    <li>✓ 6/7 Captain Recliner Seats</li>
                    <li>✓ Supreme Highway Ride &amp; Suspension</li>
                    <li>✓ High Safety Rating &amp; Luggage Carrier</li>
                    <li>✓ Executive Senior Chauffeur</li>
                  </ul>
                  <a href={waCrysta} target="_blank" rel="noopener noreferrer" class="p-btn p-btn--primary">
                    <span>Book Crysta @ ₹{route.crystaFare.toLocaleString('en-IN')}</span>
                    <span class="arr">&rarr;</span>
                  </a>
                </div>
              </div>
            </div>

            <!-- Route Stops & Highlights -->
            <div class="content-block itinerary-block">
              <h3 class="tier-heading">Trip Highlights &amp; Suggested Highway Stops</h3>
              <p class="highlight-desc">{route.routeHighlights}</p>
              
              <div class="stops-box">
                <span class="stops-label">En-Route Convenience &amp; Sightseeing Points:</span>
                <div class="stops-grid">
                  {route.popularStops.map((stop, idx) => (
                    <div class="stop-item">
                      <span class="stop-num">{idx + 1}</span>
                      <span class="stop-text">{stop}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <!-- Why Choose Us -->
            <div class="content-block why-choose-block">
              <h3 class="tier-heading">Why Book Your {route.from} to {route.to} Taxi with Us?</h3>
              <div class="reasons-grid">
                <div class="reason-card">
                  <span class="r-icon">🏆</span>
                  <div>
                    <h4>18+ Years Experience</h4>
                    <p>Serving tourists, pilgrims, and local residents across Rajasthan since 2008 with a proven track record.</p>
                  </div>
                </div>

                <div class="reason-card">
                  <span class="r-icon">⏱️</span>
                  <div>
                    <h4>100% Punctual Pickup</h4>
                    <p>We pick you up right from your doorstep, hotel porch, or railway platform with zero delay.</p>
                  </div>
                </div>

                <div class="reason-card">
                  <span class="r-icon">🚫</span>
                  <div>
                    <h4>Zero Advance Deposit</h4>
                    <p>No upfront prepayment needed. Pay your driver directly at the end of your trip.</p>
                  </div>
                </div>

                <div class="reason-card">
                  <span class="r-icon">🛡️</span>
                  <div>
                    <h4>Verified Highway Drivers</h4>
                    <p>Polite, non-smoking, uniformed highway drivers with exhaustive route knowledge and safety permits.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Sticky Sidebar -->
          <aside class="route-sidebar">
            <div class="sidebar-box booking-quick-box">
              <span class="side-badge">Trip Overview</span>
              <h3 class="side-title">Quick Booking Summary</h3>
              
              <div class="route-quick-specs">
                <div class="spec-row">
                  <span class="label">Pickup Point:</span>
                  <span class="val">{route.from}</span>
                </div>
                <div class="spec-row">
                  <span class="label">Drop Location:</span>
                  <span class="val">{route.to}</span>
                </div>
                <div class="spec-row">
                  <span class="label">Total Distance:</span>
                  <span class="val">~{route.distanceKm} km</span>
                </div>
                <div class="spec-row">
                  <span class="label">Driving Time:</span>
                  <span class="val">{route.estimatedTime}</span>
                </div>
                <div class="spec-row">
                  <span class="label">Main Route:</span>
                  <span class="val highway-val">{route.highway}</span>
                </div>
              </div>

              <div class="side-fare-summary">
                <div class="fare-row">
                  <span>Sedan (Dzire/Etios)</span>
                  <strong>₹{route.sedanFare.toLocaleString('en-IN')}</strong>
                </div>
                <div class="fare-row highlight">
                  <span>Maruti Ertiga (6-Str)</span>
                  <strong>₹{route.suvFare.toLocaleString('en-IN')}</strong>
                </div>
                <div class="fare-row">
                  <span>Toyota Innova Crysta</span>
                  <strong>₹{route.crystaFare.toLocaleString('en-IN')}</strong>
                </div>
              </div>

              <div class="side-cta-stack">
                <a href={waSedan} target="_blank" rel="noopener noreferrer" class="side-action-btn side-action-btn--wa">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.087-.178.181-.077.355.101.174.449.741.964 1.2.662.591 1.221.774 1.394.861.173.087.275.072.376-.044.101-.116.433-.506.549-.68.116-.174.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.044.073.044.42-.1 1.016z"/></svg>
                  <span>Book on WhatsApp</span>
                </a>
                <a href={`tel:${business.phone}`} class="side-action-btn side-action-btn--call">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
                  <span>Call: {business.phoneFormatted}</span>
                </a>
              </div>
            </div>

            <!-- Interlinked Links Box -->
            <div class="sidebar-box routes-box">
              <h4 class="tips-title">Popular Routes &amp; Tours</h4>
              <ul class="sidebar-links">
                <li><a href="/pushkar-to-ajmer-taxi/">&rarr; Pushkar to Ajmer Taxi (₹700)</a></li>
                <li><a href="/ajmer-to-pushkar-taxi/">&rarr; Ajmer to Pushkar Taxi (₹700)</a></li>
                <li><a href="/ajmer-to-sarwar-sharif-taxi/">&rarr; Ajmer to Sarwar Sharif (₹1,800)</a></li>
                <li><a href="/ajmer-to-jaipur-taxi/">&rarr; Ajmer to Jaipur Cab (₹1,800)</a></li>
                <li><a href="/fare-calculator/">&rarr; Live Cab Fare Calculator</a></li>
                <li><a href="/tours/">&rarr; Handcrafted Rajasthan Tours</a></li>
              </ul>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- FAQs Section -->
    <section class="faq-section">
      <div class="container">
        <div class="section-header text-center">
          <span class="section-subtitle">Got Questions?</span>
          <h2 class="section-title">Frequently Asked Questions — {route.from} to {route.to}</h2>
          <p class="section-desc">Clear information about fares, driving times, and vehicle options.</p>
        </div>

        <div class="faq-accordion-list">
          {route.faqs.map((faq, idx) => (
            <details class="faq-item" id={`faq-${idx}`}>
              <summary class="faq-question">
                <span>{faq.question}</span>
                <svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <div class="faq-answer">
                <p>{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Bottom Pre-Footer CTA -->
    <section class="bottom-cta-banner">
      <div class="container text-center">
        <h2>Ready to Book Your {route.from} to {route.to} Cab?</h2>
        <p>Book with Ajmer's verified chauffeur service since 2008. Punctual doorstep pickup, clean air-conditioned vehicles, and honest direct pricing.</p>
        <div class="bottom-cta-row">
          <a href={waSedan} target="_blank" rel="noopener noreferrer" class="btn-hero-action btn-hero-action--wa">
