---
import { seoRoutesData, type SeoRouteItem } from "@/data/seoRoutesData";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header/Header.astro";
import Footer from "@/components/Footer/Footer.astro";
import FAQ from "@/components/FAQ/FAQ.astro";
import WhatsAppBubble from "@/components/WhatsApp/WhatsAppBubble.astro";
import MobileBottomBar from "@/components/MobileBottomBar/MobileBottomBar.astro";
import { business } from "@/data/business";
import { createWhatsAppBookingUrl } from "@/utils/whatsapp";
import { generateServiceSchema, generateFAQSchema } from "@/utils/seo";

export async function getStaticPaths() {
  return seoRoutesData.map((route) => ({
    params: { route: route.slug },
    props: { route },
  }));
}

interface Props {
  route: SeoRouteItem;
}

const { route } = Astro.props;

const waSedan = createWhatsAppBookingUrl({
  pickup: route.from,
  destination: route.to,
  vehicle: `Maruti Swift Dzire / Toyota Etios (₹${route.sedanFare.toLocaleString('en-IN')})`,
  tripType: `${route.from} to ${route.to} Taxi`,
  customMessage: `Hello! I want to book an AC Sedan (Dzire/Etios) for ${route.from} to ${route.to} taxi at ₹${route.sedanFare.toLocaleString('en-IN')}. Please confirm cab timings and availability.`
});

const waErtiga = createWhatsAppBookingUrl({
  pickup: route.from,
  destination: route.to,
  vehicle: `Maruti Ertiga 6-Seater (₹${route.suvFare.toLocaleString('en-IN')})`,
  tripType: `${route.from} to ${route.to} Taxi`,
  customMessage: `Hello! I want to book a 6-Seater Maruti Ertiga for ${route.from} to ${route.to} taxi at ₹${route.suvFare.toLocaleString('en-IN')}. Please confirm cab timings and availability.`
});

const waCrysta = createWhatsAppBookingUrl({
  pickup: route.from,
  destination: route.to,
  vehicle: `Toyota Innova Crysta (₹${route.crystaFare.toLocaleString('en-IN')})`,
  tripType: `${route.from} to ${route.to} Taxi`,
  customMessage: `Hello! I want to book a Toyota Innova Crysta for ${route.from} to ${route.to} taxi at ₹${route.crystaFare.toLocaleString('en-IN')}. Please confirm cab timings and availability.`
});

const serviceSchema = generateServiceSchema({
  name: `${route.from} to ${route.to} Taxi Service`,
  description: route.metaDescription,
  url: `${business.website}/${route.slug}/`,
  providerName: business.name,
  providerUrl: business.website,
  price: String(route.sedanFare),
  priceCurrency: "INR"
});

const faqSchema = generateFAQSchema(route.faqs);

// Timing Slots metadata
const timingSlots = [
  {
    slot: "Early Morning Slot",
    timeRange: "04:00 AM – 08:00 AM",
    badge: "Fastest Highway Transit",
    desc: `Optimal for morning flights, express train arrivals, or early pilgrimage ziyarat. Clear highway conditions on ${route.highway.split(';')[0]} with minimal congestion.`
  },
  {
    slot: "Standard Day Slot",
    timeRange: "08:00 AM – 04:00 PM",
    badge: "Popular for Families",
    desc: `Doorstep hotel checkout and city sightseeing pickup. Clean air-conditioned cabin with optional hygienic family food and refreshment halts.`
  },
  {
    slot: "Evening Twilight Slot",
    timeRange: "04:00 PM – 09:00 PM",
    badge: "Pleasant Sunset Drive",
    desc: `Comfortable evening intercity transfer. Enjoy sunset views across Rajasthan hills with punctual arrival at your destination.`
  },
  {
    slot: "Night / Late Flight Slot",
    timeRange: "09:00 PM – 04:00 AM",
    badge: "24/7 On-Demand Service",
    desc: `Late-night flight arrivals or midnight train drops. Experienced night chauffeurs, secure travel for solo women & families, zero hidden night surge fees.`
  }
];
---

<Layout
  title={route.title}
  description={route.metaDescription}
  canonicalPath={`/${route.slug}/`}
  schemaMarkup={serviceSchema}
>
  <Header />

  <main id="main-content">
    <!-- Hero Banner -->
    <section class="route-hero">
      <div class="container text-center">
        <span class="heritage-pill">Verified Highway Taxi Rate • Serving Since 2008</span>
        <h1 class="route-title">{route.from} to {route.to} Taxi &amp; Cab Timings</h1>
        <p class="route-subtitle">{route.heroSubtitle}</p>

        <!-- Route Spec Strip -->
        <div class="hero-specs-strip">
          <div class="spec-chip">
            <span class="chip-icon">📍</span>
            <span>Distance: <strong>~{route.distanceKm} km</strong></span>
          </div>
          <div class="spec-chip">
            <span class="chip-icon">⏱️</span>
            <span>Est. Time: <strong>{route.estimatedTime}</strong></span>
          </div>
          <div class="spec-chip">
            <span class="chip-icon">🛣️</span>
            <span>Highway: <strong>{route.highway}</strong></span>
          </div>
          <div class="spec-chip">
            <span class="chip-icon">🕒</span>
            <span>Timings: <strong>24/7 Available</strong></span>
          </div>
        </div>

        <!-- Pricing Pills in Hero -->
        <div class="hero-fare-pills">
          <div class="h-pill">
            <span class="car-tag">Sedan:</span>
            <strong>₹{route.sedanFare.toLocaleString('en-IN')}</strong>
          </div>
          <div class="h-pill gold">
            <span class="car-tag">Ertiga 6-Str:</span>
            <strong>₹{route.suvFare.toLocaleString('en-IN')}</strong>
          </div>
          <div class="h-pill">
            <span class="car-tag">Innova Crysta:</span>
            <strong>₹{route.crystaFare.toLocaleString('en-IN')}</strong>
          </div>
        </div>

        <!-- Hero Action Buttons -->
        <div class="hero-cta-btns">
          <a href={waSedan} target="_blank" rel="noopener noreferrer" class="btn btn--gold hero-cta-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.087-.178.181-.077.355.101.174.449.741.964 1.2.662.591 1.221.774 1.394.861.173.087.275.072.376-.044.101-.116.433-.506.549-.68.116-.174.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.044.073.044.42-.1 1.016z"/></svg>
            <span>Book Cab on WhatsApp</span>
          </a>
          <a href={`tel:${business.phone}`} class="btn btn--outline-primary hero-cta-btn hero-cta-btn--call">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
            <span>Call 24/7: {business.phoneFormatted}</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Main Content Section -->
    <section class="route-content-section">
      <div class="container">
        
        <!-- Mobile Quick CTA Bar (< 768px) -->
        <div class="route-mobile-cta-bar">
          <a href={waSedan} target="_blank" rel="noopener noreferrer" class="m-cta-btn m-cta-btn--wa">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.087-.178.181-.077.355.101.174.449.741.964 1.2.662.591 1.221.774 1.394.861.173.087.275.072.376-.044.101-.116.433-.506.549-.68.116-.174.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.044.073.044.42-.1 1.016z"/></svg>
            <span>Book on WhatsApp</span>
          </a>
          <a href={`tel:${business.phone}`} class="m-cta-btn m-cta-btn--call">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
            <span>Call: {business.phoneFormatted}</span>
          </a>
        </div>

        <div class="route-grid">
          <!-- Main Content Area -->
          <div class="route-main">
            <!-- Route Overview -->
            <div class="content-card">
              <span class="section-subtitle">Comfortable Highway Journey</span>
              <h2 class="section-title">Reliable {route.from} to {route.to} Cab Service</h2>
              <p class="body-p">
                Looking for a dependable, private, and air-conditioned cab between <strong>{route.from}</strong> and <strong>{route.to}</strong>? With over 18 years of Rajasthan transport experience since 2008, <strong>Taxi Services in Ajmer</strong> delivers punctual doorstep pickups, experienced highway chauffeurs, and 100% transparent pricing.
              </p>
              <p class="body-p">
                The trip spans approximately <strong>{route.distanceKm} km</strong> along <strong>{route.highway}</strong>, taking roughly <strong>{route.estimatedTime}</strong> under typical driving conditions. Whether you are traveling for a flight connection, train transfer, business conference, family pilgrimage, or sightseeing tour, our clean fleet guarantees complete peace of mind.
              </p>
            </div>

            <!-- Route Timings & Departure Schedule (Crucial for User) -->
            <div class="content-card timings-card" id="route-timings">
              <div class="card-header-flex">
                <div>
                  <span class="section-subtitle">Departure Schedules &amp; Slots</span>
                  <h3 class="tier-heading">Cab Timings &amp; Daily Frequency ({route.from} ➔ {route.to})</h3>
                </div>
                <span class="badge-247">24/7 ON-DEMAND</span>
              </div>
              <p class="card-intro">
                Unlike state buses with rigid schedules or private buses that pick up from remote bus stands, our private chauffeur cabs depart <strong>exactly at your preferred time</strong> directly from your hotel porch, home doorstep, railway platform, or airport terminal.
              </p>

              <div class="timings-grid">
                {timingSlots.map((ts) => (
                  <div class="timing-box">
                    <div class="timing-top">
                      <strong class="timing-slot">{ts.slot}</strong>
                      <span class="timing-badge">{ts.badge}</span>
                    </div>
                    <div class="timing-hours">
                      <span class="clock-icon">⏰</span>
                      <span>{ts.timeRange}</span>
                    </div>
                    <p class="timing-desc">{ts.desc}</p>
                  </div>
                ))}
              </div>

              <!-- Quick Dispatch Notice -->
              <div class="dispatch-notice">
                <span class="notice-icon">⚡</span>
                <div class="notice-text">
                  <strong>Need Immediate Pickup?</strong>
                  <p>Our fleet is stationed across key junctions in Ajmer &amp; Pushkar. Urgent taxis can be dispatched within <strong>15 to 20 minutes</strong> of your confirmation.</p>
                </div>
              </div>
            </div>

            <!-- Vehicle Pricing Cards -->
            <div class="content-card">
              <div class="card-header-flex">
                <div>
                  <span class="section-subtitle">Direct Operator Pricing</span>
                  <h3 class="tier-heading">Verified Fare Breakdown ({route.from} ➔ {route.to})</h3>
                </div>
                <span class="live-rate-tag">2026 FIXED FARES</span>
              </div>
              <p class="card-intro">No surge pricing, no platform convenience charges, and zero hidden return fare penalties.</p>

              <div class="pricing-cards-row">
                <!-- 1. Sedan -->
                <div class="p-card">
                  <span class="p-type">Comfort Sedan</span>
                  <h4 class="p-car">Maruti Dzire / Etios</h4>
                  <div class="p-fare">
                    <span class="currency">₹</span><span class="amount">{route.sedanFare.toLocaleString('en-IN')}</span>
                    <small>Fixed One-Way</small>
                  </div>
                  <ul class="p-features">
                    <li>✓ 4 Passenger Seats with AC</li>
                    <li>✓ 2 Medium Luggage Bags</li>
                    <li>✓ Doorstep Pickup &amp; Direct Drop</li>
                    <li>✓ Verified Highway Driver</li>
                  </ul>
                  <a href={waSedan} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--sm p-btn">
                    Book Sedan @ ₹{route.sedanFare.toLocaleString('en-IN')} &rarr;
                  </a>
                </div>

                <!-- 2. Ertiga (Featured) -->
                <div class="p-card featured-p-card">
                  <div class="featured-badge">Family &amp; Luggage Bestseller</div>
                  <span class="p-type gold">Spacious MPV</span>
                  <h4 class="p-car">Maruti Suzuki Ertiga</h4>
                  <div class="p-fare">
                    <span class="currency">₹</span><span class="amount">{route.suvFare.toLocaleString('en-IN')}</span>
                    <small>Fixed One-Way</small>
                  </div>
                  <ul class="p-features">
                    <li>✓ 6 Passenger Seats</li>
                    <li>✓ Dual Chilled AC Vents</li>
                    <li>✓ Extra Legroom for Elders</li>
                    <li>✓ Space for 3–4 Luggage Bags</li>
                  </ul>
                  <a href={waErtiga} target="_blank" rel="noopener noreferrer" class="btn btn--gold btn--sm p-btn">
                    Book Ertiga @ ₹{route.suvFare.toLocaleString('en-IN')} &rarr;
                  </a>
                </div>

                <!-- 3. Innova Crysta -->
                <div class="p-card">
                  <span class="p-type">VIP Executive</span>
                  <h4 class="p-car">Toyota Innova Crysta</h4>
                  <div class="p-fare">
                    <span class="currency">₹</span><span class="amount">{route.crystaFare.toLocaleString('en-IN')}</span>
                    <small>Fixed One-Way</small>
                  </div>
                  <ul class="p-features">
                    <li>✓ 6/7 Captain Recliner Seats</li>
                    <li>✓ Supreme Highway Suspension</li>
                    <li>✓ Ample Space for 5+ Large Bags</li>
                    <li>✓ Senior Executive Chauffeur</li>
                  </ul>
                  <a href={waCrysta} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--sm p-btn">
                    Book Crysta @ ₹{route.crystaFare.toLocaleString('en-IN')} &rarr;
                  </a>
                </div>
              </div>
            </div>

            <!-- Route Highlights & Suggested Stops -->
            <div class="content-card itinerary-card">
              <span class="section-subtitle">Highway Travel Highlights</span>
              <h3 class="tier-heading">Route Highlights &amp; Suggested En-Route Halts</h3>
              <p class="card-intro">{route.highlights}</p>
              
              <div class="stops-timeline">
                <div class="timeline-step">
                  <div class="step-num">1</div>
                  <div class="step-content">
                    <strong>Punctual Doorstep Pickup</strong>
                    <p>Driver arrives 10–15 minutes early at your hotel, home, airport terminal, or railway station in {route.from}.</p>
                  </div>
                </div>
                <div class="timeline-step">
                  <div class="step-num">2</div>
                  <div class="step-content">
                    <strong>Smooth Highway Cruising on {route.highway}</strong>
                    <p>Enjoy picturesque Rajasthan landscapes, toll expressways, and smooth rides with courteous local chauffeurs.</p>
                  </div>
                </div>
                <div class="timeline-step">
                  <div class="step-num">3</div>
                  <div class="step-content">
                    <strong>Hygienic Food &amp; Refreshment Break</strong>
                    <p>Optional halt at clean, vetted highway restaurants for fresh tea, Rajasthani snacks, and sanitary washroom facilities.</p>
                  </div>
                </div>
                <div class="timeline-step">
                  <div class="step-num">4</div>
                  <div class="step-content">
                    <strong>Guaranteed Safe Drop at {route.to}</strong>
                    <p>Direct luggage assistance and drop right to your destination gate, terminal, or hotel lobby.</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Why Choose Us Grid -->
            <div class="content-card">
              <span class="section-subtitle">Trusted Heritage Since 2008</span>
              <h3 class="tier-heading">Why 50,000+ Travelers Choose Our Ajmer Fleet</h3>
              
              <div class="trust-grid">
                <div class="trust-item">
                  <span class="trust-icon">🏆</span>
                  <div>
                    <h4>18+ Years Direct Service</h4>
                    <p>Founded in 2008, we are Ajmer's authentic local operator — not a third-party aggregator that re-sells bookings.</p>
                  </div>
                </div>
                <div class="trust-item">
                  <span class="trust-icon">⏱️</span>
                  <div>
                    <h4>100% Punctual Pickups</h4>
                    <p>Guaranteed on-time arrivals for critical flight departures and train connections with driver contact shared in advance.</p>
                  </div>
                </div>
                <div class="trust-item">
                  <span class="trust-icon">🚫</span>
                  <div>
                    <h4>Zero Return Toll Scam</h4>
                    <p>One-way fares are truly one-way. We never bill you for return driver allowance or round-trip empty kilometres.</p>
                  </div>
                </div>
                <div class="trust-item">
                  <span class="trust-icon">🛡️</span>
                  <div>
                    <h4>Verified Highway Drivers</h4>
                    <p>Polite, background-verified, non-smoking chauffeurs with thorough knowledge of Rajasthan shortcuts and safe passing.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Sticky Sidebar -->
          <aside class="route-sidebar">
            <div class="sidebar-box">
              <span class="side-badge">Trip Quick Reference</span>
              <h3 class="side-title">Route &amp; Fare Summary</h3>
              
              <div class="side-list">
                <div class="side-item">
                  <span class="s-label">Origin:</span>
                  <strong class="s-val">{route.from}</strong>
                </div>
                <div class="side-item">
                  <span class="s-label">Destination:</span>
                  <strong class="s-val">{route.to}</strong>
                </div>
                <div class="side-item">
                  <span class="s-label">Distance:</span>
                  <strong class="s-val">~{route.distanceKm} km</strong>
                </div>
                <div class="side-item">
                  <span class="s-label">Driving Time:</span>
                  <strong class="s-val">{route.estimatedTime}</strong>
                </div>
                <div class="side-item">
                  <span class="s-label">Highway Route:</span>
                  <strong class="s-val text-primary">{route.highway}</strong>
                </div>
                <div class="side-item">
                  <span class="s-label">Service Window:</span>
                  <strong class="s-val text-gold">24 Hours / 7 Days</strong>
                </div>
              </div>

              <!-- Starting Fares Pill Box -->
              <div class="sidebar-fare-callout">
                <span class="callout-label">Fixed One-Way Cab Rates</span>
                <div class="fare-tiers">
                  <div class="fare-tier-line">
                    <span>Sedan (Dzire):</span>
                    <strong>₹{route.sedanFare.toLocaleString('en-IN')}</strong>
                  </div>
                  <div class="fare-tier-line highlight">
                    <span>Ertiga (6-Str):</span>
                    <strong>₹{route.suvFare.toLocaleString('en-IN')}</strong>
                  </div>
                  <div class="fare-tier-line">
                    <span>Innova Crysta:</span>
                    <strong>₹{route.crystaFare.toLocaleString('en-IN')}</strong>
                  </div>
                </div>
              </div>

              <div class="side-actions">
                <a href={waSedan} target="_blank" rel="noopener noreferrer" class="btn btn--gold btn--sm full-w">
                  Book Instant on WhatsApp
                </a>
                <a href={`tel:${business.phone}`} class="btn btn--outline-primary btn--sm full-w">
                  Call: {business.phoneFormatted}
                </a>
              </div>
            </div>

            <!-- Interlinked Routes Box -->
            <div class="sidebar-box links-box">
              <h4 class="side-title-sm">Popular Connected Routes</h4>
              <ul class="sidebar-links">
                <li><a href="/pushkar-to-ajmer-taxi/">&rarr; Pushkar to Ajmer Taxi (₹700)</a></li>
                <li><a href="/ajmer-to-pushkar-taxi/">&rarr; Ajmer to Pushkar Taxi (₹700)</a></li>
                <li><a href="/ajmer-to-kishangarh-airport-taxi/">&rarr; Ajmer to Kishangarh Airport (₹800)</a></li>
                <li><a href="/ajmer-to-jaipur-taxi/">&rarr; Ajmer to Jaipur Cab (₹1,999)</a></li>
                <li><a href="/ajmer-to-sarwar-sharif-taxi/">&rarr; Ajmer to Sarwar Sharif (₹2,000)</a></li>
                <li><a href="/routes/">&rarr; Explore All 220+ Rajasthan Routes</a></li>
                <li><a href="/fare-calculator/">&rarr; Live Taxi Fare Calculator</a></li>
              </ul>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- Official FAQs Component -->
    <FAQ items={route.faqs} title={`Frequently Asked Questions — ${route.from} to ${route.to}`} subtitle="Clear Answers Before You Travel" />

    <!-- Bottom CTA Banner -->
    <section class="bottom-cta-banner">
      <div class="container text-center">
        <h2>Ready to Travel from {route.from} to {route.to}?</h2>
        <p>Book with Ajmer's verified chauffeur service since 2008. Punctual doorstep pickup, clean air-conditioned vehicles, and honest direct operator pricing.</p>
        <div class="bottom-cta-row">
          <a href={waSedan} target="_blank" rel="noopener noreferrer" class="btn btn--gold">
