    fixedErtiga?: number;
    fixedCrysta?: number;
  }

  const CITY_CACHE: Record<string, CityNode> = {
    "ajmer": { name: "Ajmer", lat: 26.4499, lng: 74.6399, distFromAjmer: 0, timeFromAjmer: "0 Mins", highway: "City Center" },
