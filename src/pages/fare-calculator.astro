    "jodhpur": { name: "Jodhpur", lat: 26.2389, lng: 73.0243, distFromAjmer: 200, timeFromAjmer: "3.5-4 Hrs", highway: "NH 25 via Beawar & Pali", fixedSedan: 3500, fixedErtiga: 4500, fixedCrysta: 6000 },
    "udaipur": { name: "Udaipur", lat: 24.5854, lng: 73.7125, distFromAjmer: 265, timeFromAjmer: "4.5-5 Hrs", highway: "NH 58 4-Lane Highway", fixedSedan: 4500, fixedErtiga: 6500, fixedCrysta: 8500 },
