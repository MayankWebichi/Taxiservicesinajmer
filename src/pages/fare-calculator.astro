    "bikaner": { name: "Bikaner", lat: 28.0229, lng: 73.3119, distFromAjmer: 275, timeFromAjmer: "5 Hrs", highway: "NH 58 via Nagaur", fixedSedan: 4500, fixedErtiga: 6200, fixedCrysta: 8000 },
    "chittorgarh": { name: "Chittorgarh", lat: 24.8887, lng: 74.6269, distFromAjmer: 185, timeFromAjmer: "3.5 Hrs", highway: "NH 48 Golden Quadrilateral", fixedSedan: 3200, fixedErtiga: 4400, fixedCrysta: 5800 },
    "nathdwara": { name: "Nathdwara (Shrinathji)", lat: 24.9333, lng: 73.8167, distFromAjmer: 215, timeFromAjmer: "4 Hrs", highway: "NH 58 Highway", fixedSedan: 3600, fixedErtiga: 5000, fixedCrysta: 6500 },
    "ranthambore": { name: "Ranthambore / Sawai Madhopur", lat: 25.9968, lng: 76.3688, distFromAjmer: 260, timeFromAjmer: "4.5-5 Hrs", highway: "State Highway via Dausa", fixedSedan: 4200, fixedErtiga: 5800, fixedCrysta: 7500 },
    "kota": { name: "Kota", lat: 25.2138, lng: 75.8648, distFromAjmer: 210, timeFromAjmer: "4 Hrs", highway: "NH 52 Highway", fixedSedan: 3500, fixedErtiga: 4800, fixedCrysta: 6200 },
    "bundi": { name: "Bundi", lat: 25.4414, lng: 75.6450, distFromAjmer: 175, timeFromAjmer: "3.5 Hrs", highway: "NH 52 via Deoli", fixedSedan: 3000, fixedErtiga: 4200, fixedCrysta: 5500 },
    "beawar": { name: "Beawar", lat: 26.1013, lng: 74.3197, distFromAjmer: 54, timeFromAjmer: "1 Hr", highway: "NH 48 6-Lane Expressway", fixedSedan: 1500, fixedErtiga: 2200, fixedCrysta: 2800 },
    "kekri": { name: "Kekri", lat: 25.9723, lng: 75.1528, distFromAjmer: 80, timeFromAjmer: "1.5 Hrs", highway: "NH 448 Highway", fixedSedan: 1800, fixedErtiga: 2500, fixedCrysta: 3200 },
    "nasirabad": { name: "Nasirabad", lat: 26.3039, lng: 74.7339, distFromAjmer: 24, timeFromAjmer: "35 Mins", highway: "NH 48 Bypass", fixedSedan: 900, fixedErtiga: 1400, fixedCrysta: 1800 },
    "merta-city": { name: "Merta City", lat: 26.6492, lng: 74.0323, distFromAjmer: 85, timeFromAjmer: "1.8 Hrs", highway: "State Highway 58", fixedSedan: 1900, fixedErtiga: 2600, fixedCrysta: 3400 },
    "nagaur": { name: "Nagaur", lat: 27.1983, lng: 73.7493, distFromAjmer: 145, timeFromAjmer: "3 Hrs", highway: "NH 58 Highway", fixedSedan: 2800, fixedErtiga: 3800, fixedCrysta: 4800 },
    "makrana": { name: "Makrana", lat: 27.0422, lng: 74.7278, distFromAjmer: 85, timeFromAjmer: "1.8 Hrs", highway: "Kishangarh-Makrana Highway", fixedSedan: 1900, fixedErtiga: 2600, fixedCrysta: 3400 },
    "kumbhalgarh": { name: "Kumbhalgarh", lat: 25.1478, lng: 73.5878, distFromAjmer: 240, timeFromAjmer: "4.5 Hrs", highway: "NH 58 & Rajsamand Road", fixedSedan: 4000, fixedErtiga: 5500, fixedCrysta: 7200 },
    "ramdevra": { name: "Ramdevra", lat: 27.0264, lng: 71.9172, distFromAjmer: 390, timeFromAjmer: "7 Hrs", highway: "NH 11 & Pokaran Highway", fixedSedan: 6000, fixedErtiga: 8500, fixedCrysta: 11000 },
    "mathura": { name: "Mathura – Vrindavan", lat: 27.4924, lng: 77.6737, distFromAjmer: 330, timeFromAjmer: "5.5 Hrs", highway: "NH 21 Bharatpur Expressway", fixedSedan: 5000, fixedErtiga: 7000, fixedCrysta: 9000 },
    "haridwar": { name: "Haridwar & Rishikesh", lat: 29.9457, lng: 78.1642, distFromAjmer: 620, timeFromAjmer: "10-11 Hrs", highway: "Western Peripheral & NH 334", fixedSedan: 9500, fixedErtiga: 13000, fixedCrysta: 17000 }
  };

  // State
  let origin = "Ajmer";
  let destination = "Pushkar";
  let tripType = "one-way";

  // Elements
  const inputOrigin = document.getElementById("input-origin") as HTMLInputElement;
  const inputDest = document.getElementById("input-dest") as HTMLInputElement;
  const btnSwap = document.getElementById("btn-swap-locations") as HTMLButtonElement;
  const btnGps = document.getElementById("btn-gps-origin") as HTMLButtonElement;
  const btnClearOrigin = document.getElementById("btn-clear-origin") as HTMLButtonElement;
  const btnClearDest = document.getElementById("btn-clear-dest") as HTMLButtonElement;
  const originSuggestions = document.getElementById("origin-suggestions") as HTMLUListElement;
  const destSuggestions = document.getElementById("dest-suggestions") as HTMLUListElement;
  const travelDateInput = document.getElementById("input-travel-date") as HTMLInputElement;
  const travelTimeInput = document.getElementById("input-travel-time") as HTMLSelectElement;

  const chipDist = document.getElementById("chip-dist") as HTMLElement;
  const chipTime = document.getElementById("chip-time") as HTMLElement;
  const chipHighway = document.getElementById("chip-highway") as HTMLElement;
  const seoBridgeBox = document.getElementById("seo-bridge-box") as HTMLElement;
  const seoBridgeLink = document.getElementById("seo-bridge-link") as HTMLAnchorElement;
  const resultsHeading = document.getElementById("results-heading") as HTMLElement;

  // Set default travel date to today
  if (travelDateInput) {
    const today = new Date().toISOString().split("T")[0];
    travelDateInput.value = today;
    travelDateInput.min = today;
  }

  // Haversine formula with highway tortuosity factor (1.25x in India)
  function calculateRoadDistance(lat1: number, lon1: number, lat2: number, lon2: number): number {
    const R = 6371; // Earth radius in km
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLon = (lon2 - lon1) * Math.PI / 180;
    const a =
      Math.sin(dLat / 2) * Math.sin(dLat / 2) +
      Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
      Math.sin(dLon / 2) * Math.sin(dLon / 2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    const straightKm = R * c;
    // Highway winding factor
    return Math.round(straightKm * 1.25);
  }

  // Resolve matching city or geocode
  async function resolveCity(query: string): Promise<CityNode> {
    const q = query.toLowerCase().trim();

    // Check cache
    for (const [key, c] of Object.entries(CITY_CACHE)) {
      if (key === q || c.name.toLowerCase() === q || c.name.toLowerCase().includes(q)) {
        return c;
      }
    }

    // Try online free geocoding via OpenStreetMap Nominatim
    try {
      const resp = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&countrycodes=in&limit=1`);
      if (resp.ok) {
        const data = await resp.json();
        if (data && data.length > 0) {
          return {
            name: query,
            lat: parseFloat(data[0].lat),
            lng: parseFloat(data[0].lon)
          };
        }
      }
    } catch (e) {
      // Ignore geocoding failure, fallback below
    }

    // Default coordinate near Ajmer if unknown
    return { name: query, lat: 26.4499, lng: 74.6399 };
  }

  // Check if a dedicated route SEO page exists
  function checkSeoBridge(from: string, to: string) {
    const fromSlug = from.toLowerCase().replace(/[^a-z0-9]/g, "-").replace(/-+/g, "-");
    const toSlug = to.toLowerCase().replace(/[^a-z0-9]/g, "-").replace(/-+/g, "-");
    const targetSlug = `${fromSlug}-to-${toSlug}-taxi`;

    // High traffic known pages
    const knownPages = [
      "pushkar-to-ajmer-taxi",
      "ajmer-to-pushkar-taxi",
      "ajmer-to-jaipur-taxi",
      "pushkar-to-jaipur-taxi",
      "ajmer-to-sarwar-sharif-taxi",
      "ajmer-to-delhi-taxi",
      "ajmer-to-udaipur-taxi",
      "ajmer-to-jodhpur-taxi",
      "ajmer-to-kishangarh-airport-taxi",
      "kishangarh-marble-dumping-yard-taxi-from-ajmer",
      "kishangarh-marble-dumping-yard-taxi-from-pushkar",
      "ajmer-to-khatu-shyam-ji-taxi",
      "ajmer-to-salasar-balaji-taxi"
    ];

    if (knownPages.includes(targetSlug)) {
      seoBridgeLink.href = `/${targetSlug}/`;
      seoBridgeLink.textContent = `🏆 Dedicated Route Guide: ${from} ➔ ${to} Fare, Distance & FAQs →`;
      seoBridgeBox.style.display = "block";
    } else {
      seoBridgeBox.style.display = "none";
    }
  }

  // Main Fare Engine Calculation
  async function runEngine() {
    chipDist.textContent = "Calculating route...";
    resultsHeading.textContent = `Available Cabs for ${origin} ➔ ${destination}`;

    const cityA = await resolveCity(origin);
    const cityB = await resolveCity(destination);

    let distance = 0;
    let duration = "2-3 Hrs";
    let highway = "National Highway Route";

    // Known verified route distance
    if (cityA.name === "Ajmer" && cityB.distFromAjmer !== undefined) {
      distance = cityB.distFromAjmer;
      duration = cityB.timeFromAjmer || `${Math.round(distance / 50 * 10) / 10} Hrs`;
      highway = cityB.highway || "NH 48 Highway";
    } else if (cityB.name === "Ajmer" && cityA.distFromAjmer !== undefined) {
      distance = cityA.distFromAjmer;
      duration = cityA.timeFromAjmer || `${Math.round(distance / 50 * 10) / 10} Hrs`;
      highway = cityA.highway || "NH 48 Highway";
    } else if (cityA.name === "Pushkar" && cityB.name === "Jaipur") {
      distance = 145;
      duration = "2.5-3 Hrs";
      highway = "Pushkar Bypass & NH 48";
    } else {
      distance = calculateRoadDistance(cityA.lat, cityA.lng, cityB.lat, cityB.lng);
      duration = `~${Math.round(distance / 50 * 10) / 10} Hrs`;
      highway = "NH 48 / State Expressway";
    }

    if (distance === 0) distance = 14;

    const isRound = tripType === "round-trip";
    const isLocal = tripType === "local";
    const billDist = isRound ? distance * 2 : distance;

    chipDist.textContent = isRound ? `${distance} KM (Round Trip ~${billDist} KM)` : `${distance} KM Highway Drive`;
    chipTime.textContent = isRound ? `${duration} (each side)` : duration;
    chipHighway.textContent = highway;

    // Check SEO bridge
    checkSeoBridge(origin, destination);

    // Calculate prices for all 5 car classes
    const vehiclesConfig = [
      { key: "sedan", rate: 11, min: 700, mrpMultiplier: 1.35, fixed: !isRound && cityA.name === "Ajmer" ? cityB.fixedSedan : undefined },
      { key: "ertiga", rate: 13, min: 1200, mrpMultiplier: 1.33, fixed: !isRound && cityA.name === "Ajmer" ? cityB.fixedErtiga : undefined },
      { key: "crysta", rate: 18, min: 1500, mrpMultiplier: 1.35, fixed: !isRound && cityA.name === "Ajmer" ? cityB.fixedCrysta : undefined },
      { key: "tempo", rate: 25, min: 2500, mrpMultiplier: 1.35, fixed: undefined },
      { key: "urbania", rate: 35, min: 3500, mrpMultiplier: 1.35, fixed: undefined }
    ];

    vehiclesConfig.forEach(v => {
      let finalPrice = 0;
      if (isLocal) {
        // Local 8hr/80km packages
        finalPrice = v.key === "sedan" ? 2200 : v.key === "ertiga" ? 3000 : v.key === "crysta" ? 4200 : v.key === "tempo" ? 6500 : 9500;
      } else if (v.fixed) {
        finalPrice = v.fixed;
      } else {
        const raw = Math.max(billDist * v.rate, v.min);
        finalPrice = Math.round(raw / 50) * 50;
      }

      const mrp = Math.round((finalPrice * v.mrpMultiplier) / 50) * 50;
      const savings = mrp - finalPrice;

      // Update DOM
      const priceEl = document.getElementById(`price-${v.key}`);
      const mrpEl = document.getElementById(`mrp-${v.key}`);
      const saveEl = document.getElementById(`save-${v.key}`);
      const btnEl = document.getElementById(`btn-book-${v.key}`) as HTMLAnchorElement;

      if (priceEl) priceEl.textContent = finalPrice.toLocaleString("en-IN");
      if (mrpEl) mrpEl.textContent = `₹${mrp.toLocaleString("en-IN")}`;
      if (saveEl) saveEl.textContent = `Save ₹${savings.toLocaleString("en-IN")} (Direct Online Rate)`;

      if (btnEl) {
        const waText = encodeURIComponent(
          `Hello Panwar Taxi Services,\n\nI want to book via your Fare Search Engine:\n• Route: ${origin} to ${destination}\n• Trip Type: ${isRound ? "Round Trip" : isLocal ? "Local 8Hr/80Km" : "One-Way Drop"}\n• Car Class: ${v.key.toUpperCase()}\n• Highway Distance: ~${distance} KM\n• Quoted Fare: ₹${finalPrice.toLocaleString("en-IN")}\n• Date: ${travelDateInput.value} (${travelTimeInput.value})\n\nPlease confirm cab availability.`
        );
        btnEl.href = `https://wa.me/917737314538?text=${waText}`;
      }
    });

    // Update URL query string without reloading page
    const params = new URLSearchParams();
    params.set("from", origin);
    params.set("to", destination);
    params.set("trip", tripType);
    window.history.replaceState({}, "", `${window.location.pathname}?${params.toString()}`);
  }

  // Setup Autocomplete Search
  function setupAutocomplete(input: HTMLInputElement, list: HTMLUListElement, onSelect: (val: string) => void) {
    function showMatches() {
      const q = input.value.trim().toLowerCase();
      list.innerHTML = "";

      if (!q) {
        list.style.display = "none";
        return;
      }

      const matches = Object.values(CITY_CACHE).filter(c => c.name.toLowerCase().includes(q));

      if (matches.length === 0) {
        const li = document.createElement("li");
        li.className = "engine-suggestion-item custom-match";
        li.innerHTML = `<span>🔍 Search: <strong>"${input.value}"</strong></span>`;
        li.addEventListener("click", () => {
          onSelect(input.value);
          list.style.display = "none";
        });
        list.appendChild(li);
      } else {
        matches.slice(0, 7).forEach(c => {
          const li = document.createElement("li");
          li.className = "engine-suggestion-item";
          li.innerHTML = `
            <div class="sug-left">📍 ${c.name}</div>
            <div class="sug-right">${c.distFromAjmer !== undefined ? c.distFromAjmer + " km" : ""}</div>
          `;
          li.addEventListener("click", () => {
            input.value = c.name;
            onSelect(c.name);
            list.style.display = "none";
          });
          list.appendChild(li);
        });
      }

      list.style.display = "block";
    }

    input.addEventListener("input", showMatches);
    input.addEventListener("focus", showMatches);

    document.addEventListener("click", (e) => {
      if (!input.contains(e.target as Node) && !list.contains(e.target as Node)) {
        list.style.display = "none";
      }
    });
  }

  setupAutocomplete(inputOrigin, originSuggestions, (val) => {
    origin = val;
    runEngine();
  });

  setupAutocomplete(inputDest, destSuggestions, (val) => {
    destination = val;
    runEngine();
  });

  // Swap Locations button
  btnSwap.addEventListener("click", () => {
    const temp = origin;
    origin = destination;
    destination = temp;

    inputOrigin.value = origin;
    inputDest.value = destination;

    runEngine();
  });

  // GPS Current Location button
  btnGps.addEventListener("click", () => {
    if ("geolocation" in navigator) {
      btnGps.classList.add("loading");
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          btnGps.classList.remove("loading");
          // Check proximity to Ajmer or Pushkar
          const lat = pos.coords.latitude;
          const lng = pos.coords.longitude;
          const distToAjmer = calculateRoadDistance(lat, lng, 26.4499, 74.6399);
          const distToPushkar = calculateRoadDistance(lat, lng, 26.4899, 74.5511);

          if (distToPushkar < 8) {
            origin = "Pushkar";
          } else if (distToAjmer < 35) {
            origin = "Ajmer";
          } else {
            origin = "My Current Location";
          }

          inputOrigin.value = origin;
          runEngine();
        },
        () => {
          btnGps.classList.remove("loading");
          alert("Could not detect GPS location. Please type your city.");
        }
      );
    }
  });

  // Clear buttons
  btnClearOrigin.addEventListener("click", () => {
    inputOrigin.value = "";
    inputOrigin.focus();
  });
  btnClearDest.addEventListener("click", () => {
    inputDest.value = "";
    inputDest.focus();
  });

  // Quick Chips
  const qdChips = document.querySelectorAll(".qd-chip");
  qdChips.forEach(chip => {
    chip.addEventListener("click", () => {
      qdChips.forEach(c => c.classList.remove("active"));
      chip.classList.add("active");

      origin = chip.getAttribute("data-from") || "Ajmer";
      destination = chip.getAttribute("data-to") || "Pushkar";

      inputOrigin.value = origin;
      inputDest.value = destination;

      runEngine();
    });
  });

  // Trip Mode Tabs
  const modeTabs = document.querySelectorAll(".mode-tab");
  modeTabs.forEach(tab => {
    tab.addEventListener("click", () => {
      modeTabs.forEach(t => t.classList.remove("active"));
      tab.classList.add("active");
      tripType = tab.getAttribute("data-trip") || "one-way";
      runEngine();
    });
  });

  // Share link button
  const btnShare = document.getElementById("btn-share-link");
  if (btnShare) {
    btnShare.addEventListener("click", () => {
      navigator.clipboard.writeText(window.location.href);
      const span = btnShare.querySelector("span");
      if (span) {
        span.textContent = "Copied Link!";
        setTimeout(() => { span.textContent = "Share Route"; }, 2000);
      }
    });
  }

  // Parse Initial URL Query Params (?from=...&to=...)
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get("from")) {
    origin = urlParams.get("from")!;
    inputOrigin.value = origin;
  }
  if (urlParams.get("to")) {
    destination = urlParams.get("to")!;
    inputDest.value = destination;
  }
  if (urlParams.get("trip")) {
    tripType = urlParams.get("trip")!;
    modeTabs.forEach(t => {
      if (t.getAttribute("data-trip") === tripType) t.classList.add("active");
      else t.classList.remove("active");
    });
  }

  // Initial Run
  runEngine();
</script>

