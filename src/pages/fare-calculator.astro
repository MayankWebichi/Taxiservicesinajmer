---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header/Header.astro";
import Footer from "@/components/Footer/Footer.astro";
import WhatsAppBubble from "@/components/WhatsApp/WhatsAppBubble.astro";
import MobileBottomBar from "@/components/MobileBottomBar/MobileBottomBar.astro";
import { business } from "@/data/business";
import { generateServiceSchema } from "@/utils/seo";

const pageTitle = "Ajmer Taxi Fare Calculator 2026 | Live Cab Rates & Route Search Engine";
const pageDescription = "Calculate instant taxi fares, per-km rates & highway distances across Ajmer, Pushkar, Jaipur & Rajasthan. Live rates for Swift Dzire, Ertiga, Innova Crysta & 13-Seater Maharaja Urbania with zero advance.";

// Comprehensive schema matching Ixigo / MakeMyTrip competition standards
const calcSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `${business.website}/fare-calculator/#app`,
      "name": "Panwar Taxi Fare Calculator & Route Search Engine",
      "url": `${business.website}/fare-calculator/`,
      "applicationCategory": "TravelApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "description": "Calculate exact taxi fares, highway distances, and travel times across Rajasthan and India. Live prices for Dzire, Ertiga, Innova Crysta, Tempo Traveller, and Force Urbania.",
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "INR",
        "lowPrice": "700",
        "highPrice": "18000",
        "offerCount": "220"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "4850",
        "bestRating": "5",
        "worstRating": "1"
      }
    },
    {
      "@type": "TaxiService",
      "@id": `${business.website}/fare-calculator/#service`,
      "name": `${business.name} Intercity Cabs`,
      "provider": {
        "@type": "LocalBusiness",
        "name": business.name,
        "telephone": business.phone,
        "url": business.website
      },
      "areaServed": [
        { "@type": "City", "name": "Ajmer" },
        { "@type": "City", "name": "Pushkar" },
        { "@type": "City", "name": "Jaipur" },
        { "@type": "State", "name": "Rajasthan" },
        { "@type": "Country", "name": "India" }
      ],
      "priceRange": "₹700 - ₹18,000"
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} canonicalPath="/fare-calculator/" schemaMarkup={calcSchema}>
  <Header />

  <main id="main-content">
    
    <!-- Hero Header with Competitor Live Search Engine Feel -->
    <section class="calc-hero">
      <div class="container text-center">
        <div class="hero-top-badge">
          <span class="pulse-dot"></span>
          <span>LIVE FARE &amp; DISTANCE ENGINE · ZERO COMMISSION</span>
        </div>
        <h1 class="calc-title">Ajmer Taxi Fare Calculator &amp; Live Route Search Engine</h1>
        <p class="calc-sub">
          Search real-time driving distances &amp; direct chauffeur rates across Rajasthan and nationwide. Compare verified fares for Sedan, Ertiga, Innova Crysta, and Tempo Travellers.
        </p>

        <!-- Trust Mini Badges -->
        <div class="trust-mini-bar">
          <div class="t-badge">★ <strong>4.9/5 Rating</strong> (4,850+ Pilgrims &amp; Tourists)</div>
          <div class="t-badge">✓ <strong>Direct Fleet Pricing</strong> (No Aggregator Surge)</div>
          <div class="t-badge">✓ <strong>Zero Advance</strong> (Pay Chauffeur at Drop)</div>
        </div>
      </div>
    </section>

    <!-- Main Search & Results Engine Section -->
    <section class="search-engine-section">
      <div class="container">

        <!-- Search Engine Box (Ixigo / MakeMyTrip Cab Search Bar Standard) -->
        <div class="engine-card">
          
          <!-- Trip Type & Date Navigation Bar -->
          <div class="engine-top-bar">
            <div class="trip-mode-group" role="tablist">
              <button type="button" class="mode-tab active" data-trip="one-way" id="tab-oneway">
                <span class="mode-icon">➔</span> One-Way Drop
              </button>
              <button type="button" class="mode-tab" data-trip="round-trip" id="tab-roundtrip">
                <span class="mode-icon">⇄</span> Round Trip
              </button>
              <button type="button" class="mode-tab" data-trip="local" id="tab-local">
                <span class="mode-icon">⏱</span> Local 8Hr/80Km
              </button>
            </div>

            <!-- Share & Reset Tools -->
            <div class="engine-tool-links">
              <button type="button" class="tool-btn" id="btn-share-link" title="Copy Direct Search Link">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
                <span>Share Route</span>
              </button>
            </div>
          </div>

          <!-- Main Input Field Grid -->
          <div class="search-fields-grid">
            
            <!-- Origin / Pickup Input -->
            <div class="input-block origin-block">
              <div class="block-label">
                <span class="dot-indicator green"></span>
                <label for="input-origin">FROM (PICKUP CITY / ADDRESS)</label>
              </div>
              <div class="input-inner-wrap">
                <input 
                  type="text" 
                  id="input-origin" 
                  class="field-input" 
                  placeholder="Enter pickup city or landmark..." 
                  value="Ajmer" 
                  autocomplete="off" 
                />
                <button type="button" class="btn-gps" id="btn-gps-origin" title="Use My Current GPS Location">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/><line x1="12" y1="2" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="22"/><line x1="2" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="22" y2="12"/></svg>
                </button>
                <button type="button" class="btn-field-clear" id="btn-clear-origin">✕</button>
              </div>
              <!-- Autocomplete suggestions -->
              <ul class="engine-suggestions" id="origin-suggestions" style="display:none;"></ul>
            </div>

            <!-- Swap Locations Button (Like Uber / Google Maps) -->
            <div class="swap-btn-wrap">
              <button type="button" class="btn-swap-locations" id="btn-swap-locations" title="Swap Pickup & Drop">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 16V4m0 0L3 8m4-4l4 4m6 4v12m0 0l4-4m-4 4l-4-4"/></svg>
              </button>
            </div>

            <!-- Destination / Drop Input -->
            <div class="input-block dest-block">
              <div class="block-label">
                <span class="dot-indicator red"></span>
                <label for="input-dest">TO (DESTINATION / OUTSTATION)</label>
              </div>
              <div class="input-inner-wrap">
                <input 
                  type="text" 
                  id="input-dest" 
                  class="field-input" 
                  placeholder="Enter destination, temple, airport..." 
                  value="Pushkar" 
                  autocomplete="off" 
                />
                <button type="button" class="btn-field-clear" id="btn-clear-dest">✕</button>
              </div>
              <!-- Autocomplete suggestions -->
              <ul class="engine-suggestions" id="dest-suggestions" style="display:none;"></ul>
            </div>

            <!-- Pickup Date & Time -->
            <div class="input-block date-block">
              <div class="block-label">
                <span class="dot-indicator gold"></span>
                <label for="input-travel-date">TRAVEL DATE &amp; TIME</label>
              </div>
              <div class="datetime-row">
                <input type="date" id="input-travel-date" class="field-input date-input" />
                <select id="input-travel-time" class="field-input time-select">
                  <option value="Early Morning (05:00 - 08:00 AM)">Morning (06:00 AM)</option>
                  <option value="Morning (09:00 AM)" selected>Morning (09:00 AM)</option>
                  <option value="Afternoon (12:00 PM)">Noon (12:00 PM)</option>
                  <option value="Evening (04:00 PM)">Evening (04:00 PM)</option>
                  <option value="Night (09:00 PM)">Night (09:00 PM)</option>
                  <option value="Midnight (12:00 AM)">Midnight (12:00 AM)</option>
                </select>
              </div>
            </div>

          </div>

          <!-- Popular Quick Search Pills (Ixigo / Uber Style) -->
          <div class="quick-dest-row">
            <span class="qd-title">⚡ High-Volume Searches:</span>
            <div class="qd-chips" id="quick-chips">
              <button type="button" class="qd-chip active" data-from="Ajmer" data-to="Pushkar">Pushkar (14 km)</button>
              <button type="button" class="qd-chip" data-from="Ajmer" data-to="Sarwar Sharif">Sarwar Sharif (64 km)</button>
              <button type="button" class="qd-chip" data-from="Ajmer" data-to="Jaipur">Jaipur (135 km)</button>
              <button type="button" class="qd-chip" data-from="Ajmer" data-to="Khatu Shyam Ji">Khatu Shyam Ji (180 km)</button>
              <button type="button" class="qd-chip" data-from="Ajmer" data-to="Salasar Balaji">Salasar Balaji (175 km)</button>
              <button type="button" class="qd-chip" data-from="Ajmer" data-to="Kishangarh Airport">Kishangarh Airport (28 km)</button>
              <button type="button" class="qd-chip" data-from="Ajmer" data-to="Udaipur">Udaipur (265 km)</button>
              <button type="button" class="qd-chip" data-from="Ajmer" data-to="Delhi">Delhi IGI (395 km)</button>
              <button type="button" class="qd-chip" data-from="Ajmer" data-to="Jodhpur">Jodhpur (200 km)</button>
              <button type="button" class="qd-chip" data-from="Pushkar" data-to="Jaipur">Pushkar ➔ Jaipur (145 km)</button>
            </div>
          </div>

          <!-- Search Status Bar -->
          <div class="search-status-bar" id="search-status-bar">
            <div class="status-left">
              <span class="route-distance-chip" id="chip-dist">Calculating distance...</span>
              <span class="route-time-chip" id="chip-time">--</span>
              <span class="route-highway-chip" id="chip-highway">Highway Route</span>
            </div>
            <div class="status-right" id="seo-bridge-box" style="display:none;">
              <a href="#" id="seo-bridge-link" class="seo-bridge-link">
                🏆 Official Route Guide &amp; Schedule Available &rarr;
              </a>
            </div>
          </div>

        </div>

        <!-- Live Vehicle Fleet Results Comparison (Ixigo / MakeMyTrip Comparison Cards) -->
        <div class="results-container">
          <div class="results-header">
            <div class="rh-left">
              <h2 class="results-heading" id="results-heading">Available Cabs for Ajmer ➔ Pushkar</h2>
              <p class="results-sub" id="results-sub">All rates are all-inclusive with fuel &amp; chauffeur. Fastag tolls as per actual receipts.</p>
            </div>
            <div class="rh-badge">
              <span class="lock-icon">🔒</span> Direct Fleet Rate Guarantee
            </div>
          </div>

          <!-- Cards Grid -->
          <div class="cabs-inventory-list" id="cabs-inventory-list">

            <!-- 1. AC Sedan (Dzire / Etios) -->
            <div class="cab-card" data-veh-key="sedan">
              <div class="cab-col-vehicle">
                <div class="cab-tag-popular">MOST ECONOMICAL</div>
                <div class="cab-visual">
                  <span class="cab-emoji">🚗</span>
                  <div class="cab-names">
                    <h3 class="cab-model-name">AC Sedan (Dzire / Etios)</h3>
                    <span class="cab-type-label">Executive Sedan or similar</span>
                  </div>
                </div>
                <div class="cab-specs-row">
                  <span class="spec-pill">👥 4 Seats</span>
                  <span class="spec-pill">🧳 2 Bags</span>
                  <span class="spec-pill">❄️ 100% AC</span>
                </div>
                <div class="cab-rating">
                  <span class="star">★</span> <strong>4.9</strong> <span class="review-cnt">(3,240+ trips)</span>
                </div>
              </div>

              <div class="cab-col-features">
                <ul class="cab-perks">
                  <li><span class="chk">✓</span> Doorstep Pickup &amp; Drop</li>
                  <li><span class="chk">✓</span> Chauffeur &amp; Fuel Included</li>
                  <li><span class="chk">✓</span> No Return Fare for One-Way</li>
                  <li><span class="chk">✓</span> Clean, Sanitized Interior</li>
                </ul>
              </div>

              <div class="cab-col-pricing">
                <div class="price-mrp" id="mrp-sedan">₹950</div>
                <div class="price-live-wrap">
                  <span class="currency">₹</span>
                  <span class="price-amount" id="price-sedan">700</span>
                </div>
                <span class="savings-tag" id="save-sedan">Save ₹250 (Direct Rate)</span>
                <span class="tax-info">Toll extra as per Fastag</span>
                <a href="#" class="btn-book-cab" id="btn-book-sedan" target="_blank" rel="noopener noreferrer">
                  Book Sedan &rarr;
                </a>
              </div>
            </div>

            <!-- 2. Maruti Ertiga (6-Seater MPV) -->
            <div class="cab-card featured-card" data-veh-key="ertiga">
              <div class="cab-col-vehicle">
                <div class="cab-tag-featured">FAMILY &amp; LUGGAGE BESTSELLER</div>
                <div class="cab-visual">
                  <span class="cab-emoji">🚐</span>
                  <div class="cab-names">
                    <h3 class="cab-model-name">Maruti Ertiga (6-Seater)</h3>
                    <span class="cab-type-label">Spacious Family MPV</span>
                  </div>
                </div>
                <div class="cab-specs-row">
                  <span class="spec-pill">👥 6 Seats</span>
                  <span class="spec-pill">🧳 3 Bags</span>
                  <span class="spec-pill">❄️ Dual AC</span>
                </div>
                <div class="cab-rating">
                  <span class="star">★</span> <strong>4.9</strong> <span class="review-cnt">(2,890+ trips)</span>
                </div>
              </div>

              <div class="cab-col-features">
                <ul class="cab-perks">
                  <li><span class="chk">✓</span> Ample Legroom for 6 Adults</li>
                  <li><span class="chk">✓</span> Roof Carrier for Excess Bags</li>
                  <li><span class="chk">✓</span> Highway Experienced Chauffeur</li>
                  <li><span class="chk">✓</span> Music System &amp; Mobile Charger</li>
                </ul>
              </div>

              <div class="cab-col-pricing">
                <div class="price-mrp" id="mrp-ertiga">₹1,600</div>
                <div class="price-live-wrap">
                  <span class="currency">₹</span>
                  <span class="price-amount" id="price-ertiga">1,200</span>
                </div>
                <span class="savings-tag" id="save-ertiga">Save ₹400 (Direct Rate)</span>
                <span class="tax-info">Toll extra as per Fastag</span>
                <a href="#" class="btn-book-cab" id="btn-book-ertiga" target="_blank" rel="noopener noreferrer">
                  Book Ertiga &rarr;
                </a>
              </div>
            </div>

            <!-- 3. Toyota Innova Crysta (7-Seater VIP) -->
            <div class="cab-card" data-veh-key="crysta">
              <div class="cab-col-vehicle">
                <div class="cab-tag-vip">VIP COMFORT</div>
                <div class="cab-visual">
                  <span class="cab-emoji">🛻</span>
                  <div class="cab-names">
                    <h3 class="cab-model-name">Toyota Innova Crysta</h3>
                    <span class="cab-type-label">Luxury Captain Seats MUV</span>
                  </div>
                </div>
                <div class="cab-specs-row">
                  <span class="spec-pill">👥 7 Seats</span>
                  <span class="spec-pill">🧳 4 Bags</span>
                  <span class="spec-pill">❄️ Climate Control</span>
                </div>
                <div class="cab-rating">
                  <span class="star">★</span> <strong>5.0</strong> <span class="review-cnt">(4,120+ trips)</span>
                </div>
              </div>

              <div class="cab-col-features">
                <ul class="cab-perks">
                  <li><span class="chk">✓</span> Supreme Highway Ride Comfort</li>
                  <li><span class="chk">✓</span> Reclining Captain Seats</li>
                  <li><span class="chk">✓</span> Senior Citizen &amp; VIP Choice</li>
                  <li><span class="chk">✓</span> High Ground Clearance</li>
                </ul>
              </div>

              <div class="cab-col-pricing">
                <div class="price-mrp" id="mrp-crysta">₹2,100</div>
                <div class="price-live-wrap">
                  <span class="currency">₹</span>
                  <span class="price-amount" id="price-crysta">1,500</span>
                </div>
                <span class="savings-tag" id="save-crysta">Save ₹600 (Direct Rate)</span>
                <span class="tax-info">Toll extra as per Fastag</span>
                <a href="#" class="btn-book-cab" id="btn-book-crysta" target="_blank" rel="noopener noreferrer">
                  Book Crysta &rarr;
                </a>
              </div>
            </div>

            <!-- 4. Tempo Traveller (12-17 Seater) -->
            <div class="cab-card" data-veh-key="tempo">
              <div class="cab-col-vehicle">
                <div class="cab-tag-group">GROUP &amp; PILGRIMAGE</div>
                <div class="cab-visual">
                  <span class="cab-emoji">🚌</span>
                  <div class="cab-names">
                    <h3 class="cab-model-name">Tempo Traveller (12–17)</h3>
                    <span class="cab-type-label">Modified Pushback Seater</span>
                  </div>
                </div>
                <div class="cab-specs-row">
                  <span class="spec-pill">👥 12-17 Seats</span>
                  <span class="spec-pill">🧳 10+ Bags</span>
                  <span class="spec-pill">❄️ High-Cool AC</span>
                </div>
                <div class="cab-rating">
                  <span class="star">★</span> <strong>4.8</strong> <span class="review-cnt">(1,680+ trips)</span>
                </div>
              </div>

              <div class="cab-col-features">
                <ul class="cab-perks">
                  <li><span class="chk">✓</span> Ideal for Extended Family &amp; Ziyarat</li>
                  <li><span class="chk">✓</span> Separate Chauffeur + Helper (if req)</li>
                  <li><span class="chk">✓</span> Pushback 2x1 Recliners</li>
                  <li><span class="chk">✓</span> Dedicated Luggage Boot Space</li>
                </ul>
              </div>

              <div class="cab-col-pricing">
                <div class="price-mrp" id="mrp-tempo">₹3,400</div>
                <div class="price-live-wrap">
                  <span class="currency">₹</span>
                  <span class="price-amount" id="price-tempo">2,500</span>
                </div>
                <span class="savings-tag" id="save-tempo">Save ₹900 (Direct Rate)</span>
                <span class="tax-info">Toll extra as per Fastag</span>
                <a href="#" class="btn-book-cab" id="btn-book-tempo" target="_blank" rel="noopener noreferrer">
                  Book Tempo &rarr;
                </a>
              </div>
            </div>

            <!-- 5. Force Urbania Luxury Van -->
            <div class="cab-card" data-veh-key="urbania">
              <div class="cab-col-vehicle">
                <div class="cab-tag-luxury">MAHARAJA ROYAL VAN</div>
                <div class="cab-visual">
                  <span class="cab-emoji">👑</span>
                  <div class="cab-names">
                    <h3 class="cab-model-name">Force Urbania Luxury</h3>
                    <span class="cab-type-label">Ultra Luxury Business Class Van</span>
                  </div>
                </div>
                <div class="cab-specs-row">
                  <span class="spec-pill">👥 13-17 Seats</span>
                  <span class="spec-pill">🧳 12+ Bags</span>
                  <span class="spec-pill">❄️ Individual AC Vents</span>
                </div>
                <div class="cab-rating">
                  <span class="star">★</span> <strong>5.0</strong> <span class="review-cnt">(650+ trips)</span>
                </div>
              </div>

              <div class="cab-col-features">
                <ul class="cab-perks">
                  <li><span class="chk">✓</span> Mercedes-Engine German Tech</li>
                  <li><span class="chk">✓</span> Individual USB Ports &amp; LED Ambiance</li>
                  <li><span class="chk">✓</span> Zero Vibration Smooth Suspension</li>
                  <li><span class="chk">✓</span> Best for Luxury Destination Weddings</li>
                </ul>
              </div>

              <div class="cab-col-pricing">
                <div class="price-mrp" id="mrp-urbania">₹4,800</div>
                <div class="price-live-wrap">
                  <span class="currency">₹</span>
                  <span class="price-amount" id="price-urbania">3,500</span>
                </div>
                <span class="savings-tag" id="save-urbania">Save ₹1,300 (Direct Rate)</span>
                <span class="tax-info">Toll extra as per Fastag</span>
                <a href="#" class="btn-book-cab" id="btn-book-urbania" target="_blank" rel="noopener noreferrer">
                  Book Urbania &rarr;
                </a>
              </div>
            </div>

          </div>
        </div>

      </div>
    </section>

    <!-- Why Book Direct vs Competitors (Ixigo / Uber / MakeMyTrip comparison) -->
    <section class="vs-aggregator-section">
      <div class="container">
        <div class="section-title-wrap text-center">
          <span class="sub-tag">THE DIRECT FLEET ADVANTAGE</span>
          <h2>Why Choose Panwar Taxi Over Travel Aggregators?</h2>
          <p>Unlike third-party booking apps that charge 25–35% middleman commission, we operate our own private Rajasthani fleet.</p>
        </div>

        <div class="vs-comparison-table-wrap">
          <table class="vs-table">
            <thead>
              <tr>
                <th>Feature / Service</th>
                <th class="col-highlight">Panwar Taxi Services (Direct Chauffeur)</th>
                <th>Aggregator Apps (Ixigo / Uber / MMT)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Pricing Transparency</strong></td>
                <td class="col-highlight"><span class="table-chk">✓</span> Guaranteed fixed rate or ₹11/km. No surge pricing.</td>
                <td><span class="table-cross">✗</span> Unpredictable surge pricing during peak hours / festivals.</td>
              </tr>
              <tr>
                <td><strong>Advance Payment</strong></td>
                <td class="col-highlight"><span class="table-chk">✓</span> <strong>Zero advance required.</strong> Pay after safe drop.</td>
                <td><span class="table-cross">✗</span> Mandates 20%–100% upfront card/UPI prepayment.</td>
              </tr>
              <tr>
                <td><strong>Driver Accountability</strong></td>
                <td class="col-highlight"><span class="table-chk">✓</span> Police-verified local Rajasthani drivers with 10+ yrs highway experience.</td>
                <td><span class="table-cross">✗</span> Randomly assigned gig drivers who often cancel last-minute.</td>
              </tr>
              <tr>
                <td><strong>Vehicle Condition Guarantee</strong></td>
                <td class="col-highlight"><span class="table-chk">✓</span> Exact chosen car model provided with 100% active cooling.</td>
                <td><span class="table-cross">✗</span> "Or equivalent" disclaimer — older cars frequently dispatched.</td>
              </tr>
              <tr>
                <td><strong>Direct Contact Dispatch</strong></td>
                <td class="col-highlight"><span class="table-chk">✓</span> Talk directly with driver &amp; dispatch manager 24/7.</td>
                <td><span class="table-cross">✗</span> Automated bot support &amp; painful refund tickets.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

  </main>

  <Footer />
  <WhatsAppBubble />
  <MobileBottomBar />
