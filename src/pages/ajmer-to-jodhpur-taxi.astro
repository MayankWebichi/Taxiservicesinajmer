---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header/Header.astro";
import Footer from "@/components/Footer/Footer.astro";
import FAQ from "@/components/FAQ/FAQ.astro";
import WhatsAppBubble from "@/components/WhatsApp/WhatsAppBubble.astro";
import MobileBottomBar from "@/components/MobileBottomBar/MobileBottomBar.astro";
import SmoothMotion from "@/components/SmoothMotion/SmoothMotion.astro";
import { business } from "@/data/business";
import { createWhatsAppBookingUrl } from "@/utils/whatsapp";
import { generateServiceSchema } from "@/utils/seo";

const pageTitle = "Ajmer to Jodhpur Taxi | Cab Fare from ₹3,000 (Since 2008)";
const pageDescription = "Book verified Ajmer to Jodhpur taxi from ₹3,000. 205 km highway trip in 4 hours via NH 25. Clean AC Sedans, Ertiga & Innova Crysta to the Blue City. 24/7 service.";

const waSedan = createWhatsAppBookingUrl({ pickup: "Ajmer", destination: "Jodhpur", vehicle: "Sedan (Dzire/Etios)" });
const waCrysta = createWhatsAppBookingUrl({ pickup: "Ajmer", destination: "Jodhpur", vehicle: "Toyota Innova Crysta" });

const serviceSchema = generateServiceSchema({
  name: "Ajmer to Jodhpur Taxi Service",
  description: "One-way and round-trip highway cab service connecting Ajmer to the Sun City and Blue City of Jodhpur.",
  providerName: business.name,
  providerUrl: business.website,
  price: "3000",
  priceCurrency: "INR"
});

const jodhpurFaqs = [
  {
    question: "What is the distance and travel time from Ajmer to Jodhpur?",
    answer: "The distance is approximately 205 km via NH 25 (passing through Beawar, Bar, and Bilara), taking about 4 to 4.5 hours by car.",
    category: "Routes" as const
  },
  {
    question: "What is the one-way taxi fare from Ajmer to Jodhpur?",
    answer: "Our one-way fares start from ₹3,000 for a 4-seater AC sedan (Dzire/Etios), ₹4,200 for a 6-seater Ertiga, and ₹5,500 for an Innova Crysta. Toll taxes are payable as per actuals.",
    category: "Pricing" as const
  },
  {
    question: "Can the taxi pick me up from my hotel in Pushkar for Jodhpur?",
    answer: "Yes, we provide direct door-to-door pickups in both Ajmer and Pushkar for seamless highway travel to Jodhpur.",
    category: "Booking" as const
  }
];
---

<Layout title={pageTitle} description={pageDescription} canonicalPath="/ajmer-to-jodhpur-taxi/" schemaMarkup={serviceSchema}>
  <Header />

  <main id="main-content">
    <section class="route-hero">
      <div class="route-hero__backdrop" aria-hidden="true"></div>
      <div class="container text-center route-hero__content">
        <div class="hero-badge-row">
          <span class="heritage-pill">Blue City Express Corridor</span>
          <span class="live-beacon"><span class="live-beacon__dot"></span> 24/7 Direct Dispatch</span>
        </div>
        <h1 class="route-title">Ajmer to Jodhpur Taxi Service</h1>
        <p class="route-subtitle">205 km • ~4 Hours • Doorstep Pickup in Ajmer &amp; Pushkar • Starting from ₹3,000</p>
        
        <div class="route-hero__cta-group">
          <a href={waSedan} target="_blank" rel="noopener noreferrer" class="btn btn--gold btn-pressable btn--sm">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.288.043.088.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.2.662.589 1.221.77 1.394.856.173.086.275.073.376-.044.101-.116.433-.506.549-.68.116-.174.231-.145.39-.087s1.011.477 1.184.564.289.13.332.203c.043.072.043.419-.101.824z"/></svg>
            Instant WhatsApp Quote
          </a>
          <a href={`tel:${business.phone}`} class="btn btn--outline-light btn-pressable btn--sm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
            Call: {business.phoneFormatted}
          </a>
        </div>
      </div>
    </section>

    <section class="route-content-section">
      <div class="container">
        <div class="route-grid">
          <div class="route-main">
            <span class="section-subtitle">Gateway to the Thar Desert</span>
            <h2 class="section-title">Private Highway Cab to the Blue City</h2>
            <p>
              Heading to the historic Sun City of <strong>Jodhpur</strong>? We offer a smooth, reliable highway cab service connecting Ajmer and Pushkar directly to Mehrangarh Fort, Umaid Bhawan Palace, and Jodhpur Airport/Railway Station.
            </p>
            <p>
              Taking National Highway 25 via Beawar and Bilara, you enjoy total comfort in well-maintained AC vehicles driven by drivers who know the best road conditions, avoiding congestion and ensuring a safe, relaxing ride.
            </p>

            <h3 class="tier-heading">Vehicle Options</h3>
            <div class="pricing-cards-row">
              <SmoothMotion animation="fadeUp" class="p-card" delay={0}>
                <span class="p-type">Sedan</span>
                <h4 class="p-car">Maruti Swift Dzire</h4>
                <div class="p-fare">From ₹3,000 <small>one-way</small></div>
                <ul class="p-features">
                  <li>✓ 4 Passenger Seats</li>
                  <li>✓ 2 Large Bags</li>
                  <li>✓ Chilled AC</li>
                </ul>
                <a href={waSedan} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn-pressable btn--sm p-btn">
                  Book Sedan
                </a>
              </SmoothMotion>

              <SmoothMotion animation="fadeUp" class="p-card featured-p-card" delay={120}>
                <span class="p-type gold">Royal MUV</span>
                <h4 class="p-car">Innova Crysta</h4>
                <div class="p-fare">From ₹5,500 <small>one-way</small></div>
                <ul class="p-features">
                  <li>✓ 6-7 Seats</li>
                  <li>✓ 4+ Luggage Bags</li>
                  <li>✓ Plush Captain Seats</li>
                </ul>
                <a href={waCrysta} target="_blank" rel="noopener noreferrer" class="btn btn--gold btn-pressable btn--sm p-btn">
                  Book Crysta
                </a>
              </SmoothMotion>
            </div>
          </div>

          <aside class="route-sidebar">
            <div class="sidebar-box glass-panel">
              <h3 class="side-title">Route Summary</h3>
              <div class="side-list">
                <div class="side-item">
                  <span class="s-label">Distance:</span>
                  <span class="s-val">~205 km</span>
                </div>
                <div class="side-item">
                  <span class="s-label">Duration:</span>
                  <span class="s-val">4 - 4.5 Hours</span>
                </div>
                <div class="side-item">
                  <span class="s-label">Highway:</span>
                  <span class="s-val">NH 25</span>
                </div>
                <div class="side-item">
                  <span class="s-label">Starting Fare:</span>
                  <span class="s-val gold-text">₹3,000 (Sedan)</span>
                </div>
              </div>

              <div class="side-actions">
                <a href={waSedan} target="_blank" rel="noopener noreferrer" class="btn btn--gold btn-pressable btn--sm full-w">
                  WhatsApp Instant Quote
                </a>
                <a href={`tel:${business.phone}`} class="btn btn--outline-primary btn-pressable btn--sm full-w">
                  Call: {business.phoneFormatted}
                </a>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <FAQ items={jodhpurFaqs} title="Ajmer to Jodhpur Taxi FAQs" subtitle="Common Questions" />
  </main>

  <Footer />
  <WhatsAppBubble />
  <MobileBottomBar />
</Layout>

<style>
  .route-hero {
    position: relative;
    background: radial-gradient(circle at 50% 20%, rgba(197, 155, 39, 0.15) 0%, transparent 60%),
                linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
    color: #FFFFFF;
    padding: calc(var(--header-height, 74px) + 38px) 0 44px;
    border-bottom: 3px solid var(--color-accent);
    overflow: hidden;
  }

  .route-hero__backdrop {
    position: absolute;
    inset: 0;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    background: radial-gradient(circle at 80% 0%, rgba(212, 175, 55, 0.18) 0%, transparent 50%);
    pointer-events: none;
  }

  .route-hero__content {
    position: relative;
    z-index: 2;
  }

  .hero-badge-row {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .heritage-pill {
    display: inline-block;
    background: rgba(197, 155, 39, 0.22);
    border: 1px solid var(--color-accent);
    color: var(--color-accent-gold);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 5px 14px;
    border-radius: var(--radius-full);
  }

  .route-title {
    font-family: var(--font-heading);
    font-size: clamp(2.1rem, 4.5vw, 2.9rem);
    color: #FFFFFF;
    margin-bottom: 8px;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
  }

  .route-subtitle {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.92);
    max-width: 720px;
    margin: 0 auto;
    line-height: 1.55;
  }

  .route-hero__cta-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: 22px;
    flex-wrap: wrap;
  }

  .route-content-section {
    padding: var(--space-4xl) 0;
    background: #FFFFFF;
  }

  .route-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: var(--space-3xl);
  }

  .tier-heading {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    color: var(--color-primary);
    margin: var(--space-xl) 0 var(--space-md);
  }

  .pricing-cards-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
    margin-bottom: var(--space-2xl);
  }

  .p-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
  }

  .featured-p-card {
    border: 2px solid var(--color-accent);
    background: var(--color-cream);
  }

  .p-type {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-primary);
    text-transform: uppercase;
  }

  .p-type.gold {
    color: var(--color-accent-dark);
  }

  .p-car {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--color-text);
    margin: 4px 0;
  }

  .p-fare {
    font-family: var(--font-heading);
    font-size: 1.625rem;
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }

  .p-fare small {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .p-features {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-lg) 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.84375rem;
    color: var(--color-text);
    flex: 1;
  }

  .p-btn {
    width: 100%;
    justify-content: center;
    margin-top: auto;
  }

  .route-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .sidebar-box {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
  }

  .side-title {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    color: var(--color-primary);
    margin-bottom: var(--space-md);
    padding-bottom: 6px;
    border-bottom: 2px solid var(--color-accent);
  }

  .side-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: var(--space-lg);
  }

  .side-item {
    display: flex;
    justify-content: space-between;
    font-size: 0.84375rem;
    padding-bottom: 4px;
    border-bottom: 1px dashed var(--color-border);
  }

  .s-label {
    color: var(--color-text-muted);
  }

  .s-val {
    font-weight: 600;
  }

  .gold-text {
    color: var(--color-primary);
    font-weight: 700;
  }

  .side-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .full-w {
    width: 100%;
    justify-content: center;
  }

  @media (max-width: 992px) {
    .route-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .pricing-cards-row {
      grid-template-columns: 1fr;
    }
    .route-hero__cta-group {
      flex-direction: column;
      width: 100%;
    }
    .route-hero__cta-group .btn {
      width: 100%;
    }
  }
</style>
