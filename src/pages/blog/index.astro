---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header/Header.astro";
import Footer from "@/components/Footer/Footer.astro";
import WhatsAppBubble from "@/components/WhatsApp/WhatsAppBubble.astro";
import MobileBottomBar from "@/components/MobileBottomBar/MobileBottomBar.astro";
import { business } from "@/data/business";

const pageTitle = "Ajmer Taxi Blog | Travel Tips, Route Guides & Cab Fares (2026)";
const pageDescription = "Explore the official Taxi Services in Ajmer blog. In-depth 2026 travel guides, railway station cab tips, highway toll guides, Pushkar tour fares, and pilgrimage advice.";

const posts = [
  {
    slug: "/blog/ajmer-to-pushkar-taxi-fare-guide-2026/",
    title: "Ajmer to Pushkar Taxi Fare Guide 2026 — Cab Rates, Distance & Timing",
    date: "October 2, 2026",
    isoDate: "2026-10-02",
    category: "Pilgrimage & Tourism",
    excerpt: "Everything you need to know about traveling from Ajmer to Pushkar via the Nag Pahar mountain pass. Fixed fares from ₹700, temple timings, ropeway rides, and Camel Fair tips.",
    readTime: "6 min read",
    featured: true
  },
  {
    slug: "/blog/ajmer-railway-station-taxi-guide-2026/",
    title: "Ajmer Railway Station Taxi Guide 2026 — Pre-paid Cabs, Fares & Dargah Transfer",
    date: "October 1, 2026",
    isoDate: "2026-10-01",
    category: "Transit & Railway",
    excerpt: "Arriving on the Vande Bharat or Shatabdi Express at Ajmer Junction (AII)? Guide to Exit Gate 1, pre-paid cab stands, luggage tips, and night transfers to Dargah Sharif.",
    readTime: "7 min read",
    featured: true
  },
  {
    slug: "/blog/jaipur-to-ajmer-taxi-guide-highway-nh48/",
    title: "Jaipur to Ajmer Taxi Guide 2026 — Highway NH 48 Tolls, Distance & Cab Fares",
    date: "September 28, 2026",
    isoDate: "2026-09-28",
    category: "Highway & Routes",
    excerpt: "A comprehensive highway guide for the 135 km 6-lane NH 48 expressway. Fixed drops from ₹1,800, Thikariya toll rates, best family dhabas, and Jaipur Airport pickups.",
    readTime: "8 min read",
    featured: false
  },
  {
    slug: "/blog/kishangarh-airport-to-ajmer-pushkar-taxi-fare/",
    title: "Kishangarh Airport (KQH) to Ajmer & Pushkar Taxi Guide 2026 — Fares & Booking",
    date: "September 25, 2026",
    isoDate: "2026-09-25",
    category: "Airport Transfer",
    excerpt: "Flying into Kishangarh Airport? Avoid terminal taxi shortages with fixed rates to Ajmer (₹900) & Pushkar (₹1,400), plus an optional stop at the Marble Dumping Yard.",
    readTime: "6 min read",
    featured: false
  },
  {
    slug: "/blog/best-taxi-service-ajmer-2026/",
    title: "Best Taxi Service in Ajmer 2026 — Complete Honest Guide",
    date: "September 20, 2026",
    isoDate: "2026-09-20",
    category: "Operator Comparison",
    excerpt: "Looking for the best cab service in Ajmer? We compare local family-owned fleets vs national aggregators and explain why verified local drivers offer superior safety.",
    readTime: "8 min read",
    featured: false
  },
  {
    slug: "/blog/ajmer-sharif-dargah-visit-taxi-parking-guide/",
    title: "Ajmer Sharif Dargah Visit Guide 2026 — Cab Drop Locations, Parking & Timings",
    date: "September 18, 2026",
    isoDate: "2026-09-18",
    category: "Pilgrimage",
    excerpt: "Visiting the holy shrine of Khwaja Gharib Nawaz? Guide to nearest taxi drop points at Nizam Gate and Delhi Gate, authorized car parking, and Urs travel.",
    readTime: "7 min read",
    featured: false
  },
  {
    slug: "/ajmer-to-jaipur-taxi/",
    title: "Ajmer to Jaipur Taxi: Route & Fare Blueprint 2026",
    date: "September 15, 2026",
    isoDate: "2026-09-15",
    category: "Highway & Routes",
    excerpt: "The complete 2026 guide to booking a cab from Ajmer to Jaipur. Fares, highway details, best departure times, and what to do in the Pink City.",
    readTime: "6 min read",
    featured: false
  },
  {
    slug: "/dargah-taxi-ajmer/",
    title: "Ajmer Sharif Dargah Taxi Guide — Timings, Drop Points & Tips",
    date: "September 10, 2026",
    isoDate: "2026-09-10",
    category: "Pilgrimage",
    excerpt: "Essential guide for pilgrims visiting the holy shrine of Khwaja Gharib Nawaz. Vehicular drop points at Nizam Gate and Delhi Gate, luggage handling, and Urs festival travel.",
    readTime: "5 min read",
    featured: false
  },
  {
    slug: "/fare-calculator/",
    title: "How Much Does a Taxi Cost in Ajmer? (2026 Live Fare Engine)",
    date: "September 5, 2026",
    isoDate: "2026-09-05",
    category: "Pricing & Rates",
    excerpt: "A complete 2026 fare chart for all major routes from Ajmer — Jaipur, Jodhpur, Udaipur, Delhi, and Pushkar. Use our interactive calculator for instant price checks.",
    readTime: "4 min read",
    featured: false
  }
];

const categories = ["All", "Pilgrimage & Tourism", "Transit & Railway", "Highway & Routes", "Airport Transfer", "Operator Comparison", "Pricing & Rates"];
---

<Layout title={pageTitle} description={pageDescription} canonicalPath="/blog/">
  <Header />
  <main id="main-content">
    <!-- Hero Banner -->
    <section class="blog-hero">
      <div class="container text-center">
        <span class="blog-pill">Ajmer Travel Knowledge · Updated 2026</span>
        <h1 class="blog-title">Ajmer Taxi Travel &amp; Route Blog</h1>
        <p class="blog-sub">Highway route guides, cab fare charts, railway station pickup tips, and pilgrimage advice from 18+ years of local taxi expertise.</p>
      </div>
    </section>

    <!-- Breadcrumb -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <div class="container">
        <ol class="breadcrumb-list">
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">&rsaquo;</li>
          <li aria-current="page">Blog</li>
        </ol>
      </div>
    </nav>

    <!-- Main Content -->
    <section class="blog-section">
      <div class="container">
        <div class="blog-layout">
          
          <!-- Post List -->
          <div class="posts-area">
            <div class="posts-grid">
              {posts.map((post) => (
                <article class={`post-card ${post.featured ? "post-card--featured" : ""}`}>
                  <div class="post-meta">
                    <span class="post-cat">{post.category}</span>
                    <time datetime={post.isoDate} class="post-date">📅 {post.date}</time>
                    <span class="post-read">⏱️ {post.readTime}</span>
                  </div>
                  <h2 class="post-title">
                    <a href={post.slug}>{post.title}</a>
                  </h2>
                  <p class="post-excerpt">{post.excerpt}</p>
                  <a href={post.slug} class="post-read-btn">
                    <span>Read Complete Guide</span>
                    <span class="arr">&rarr;</span>
                  </a>
                </article>
              ))}
            </div>
          </div>

          <!-- Sidebar -->
          <aside class="blog-sidebar">
            <div class="sidebar-widget">
              <h3 class="widget-title">Browse Topics</h3>
              <div class="cat-list">
                {categories.map(cat => (
                  <span class="cat-tag">{cat}</span>
                ))}
              </div>
            </div>

            <div class="sidebar-widget cta-widget">
              <span class="widget-badge">Direct Fleet Booking</span>
              <h3 class="widget-title">Need a Reliable Cab in Ajmer?</h3>
              <p>Talk directly with our 24/7 dispatch team for instant cab bookings, fixed rates, and zero advance payment.</p>
              <a href="https://wa.me/917737314538?text=Hello%2C%20I%20read%20your%20blog%20and%20want%20to%20book%20a%20cab%20in%20Ajmer." target="_blank" rel="noopener noreferrer" class="side-action-btn side-action-btn--wa">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.288.043.088.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.2.662.589 1.221.77 1.394.856.173.086.275.073.376-.044.101-.116.433-.506.549-.68.116-.174.231-.145.39-.087s1.011.477 1.184.564.289.13.332.203c.043.072.043.419-.101.824z"/></svg>
                <span>Book on WhatsApp</span>
              </a>
              <a href={`tel:${business.phone}`} class="side-action-btn side-action-btn--call">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
                <span>Call {business.phoneFormatted}</span>
              </a>
            </div>

            <div class="sidebar-widget popular-routes">
              <h3 class="widget-title">Popular Routes</h3>
              <div class="route-links">
                <a href="/ajmer-to-pushkar-taxi/">Ajmer &rarr; Pushkar (₹700)</a>
                <a href="/ajmer-to-jaipur-taxi/">Ajmer &rarr; Jaipur (₹1,800)</a>
                <a href="/ajmer-to-jodhpur-taxi/">Ajmer &rarr; Jodhpur (₹2,800)</a>
                <a href="/ajmer-to-udaipur-taxi/">Ajmer &rarr; Udaipur (₹3,500)</a>
                <a href="/ajmer-to-delhi-taxi/">Ajmer &rarr; Delhi (₹5,500)</a>
                <a href="/fare-calculator/">Live Fare Calculator</a>
              </div>
            </div>
          </aside>

        </div>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppBubble />
  <MobileBottomBar />
</Layout>

<style>
  .blog-hero {
    background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
    color: #FFFFFF;
    padding: calc(var(--header-height, 72px) + 24px) 0 32px;
    border-bottom: 3px solid var(--color-accent);
  }

  .blog-pill {
    display: inline-block;
    background: rgba(197, 155, 39, 0.2);
    border: 1px solid var(--color-accent);
    color: var(--color-accent-light);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 3px 12px;
    border-radius: var(--radius-full);
    margin-bottom: 10px;
  }

  .blog-title {
    font-family: var(--font-heading);
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    color: #FFFFFF;
    margin-bottom: 8px;
    line-height: 1.2;
  }

  .blog-sub {
    font-size: clamp(0.9375rem, 2vw, 1.0625rem);
    color: rgba(255, 255, 255, 0.9);
    max-width: 650px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .breadcrumb-nav {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: 10px 0;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    flex-wrap: wrap;
  }

  .breadcrumb-list a {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
  }

  .breadcrumb-list a:hover {
    color: var(--color-accent-dark);
  }

  .blog-section {
    padding: var(--space-xl) 0 var(--space-3xl);
    background: var(--color-surface);
  }

  .blog-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  @media (min-width: 992px) {
    .blog-layout {
      grid-template-columns: 1fr 320px;
      gap: var(--space-3xl);
    }
  }

  .posts-grid {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .post-card {
    background: #FFFFFF;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 18px 20px;
    box-shadow: 0 4px 16px rgba(34, 24, 28, 0.04);
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }

  .post-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(34, 24, 28, 0.08);
    border-color: var(--color-accent);
  }

  .post-card--featured {
    border-left: 4px solid var(--color-accent);
    background: linear-gradient(180deg, #FFFFFF 0%, #FFFDF8 100%);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }

  .post-cat {
    background: var(--color-primary);
    color: #FFFFFF;
    font-size: 0.6875rem;
    font-weight: 800;
    padding: 3px 9px;
    border-radius: var(--radius-full);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .post-date, .post-read {
    font-size: 0.775rem;
    color: var(--color-text-muted);
  }

  .post-title {
    font-family: var(--font-heading);
    font-size: clamp(1.15rem, 2.2vw, 1.35rem);
    color: var(--color-primary);
    margin-bottom: 8px;
    line-height: 1.3;
  }

  .post-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s;
  }

  .post-title a:hover {
    color: var(--color-accent-dark);
  }

  .post-excerpt {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin-bottom: 12px;
  }

  .post-read-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.84rem;
    text-decoration: none;
    transition: color 0.15s;
  }

  .post-read-btn:hover {
    color: var(--color-accent-dark);
  }

  .post-read-btn .arr {
    transition: transform 0.15s ease;
  }

  .post-read-btn:hover .arr {
    transform: translateX(4px);
  }

  /* Sidebar */
  .blog-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .sidebar-widget {
    background: #FFFFFF;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 20px;
  }

  .cta-widget {
    border-color: var(--color-accent);
    background: #FFFFFF;
    box-shadow: 0 4px 16px rgba(90, 12, 26, 0.06);
  }

  .widget-badge {
    display: inline-block;
    background: rgba(90, 12, 26, 0.08);
    color: var(--color-primary);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    margin-bottom: 8px;
  }

  .widget-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    color: var(--color-primary);
    margin-bottom: 10px;
    padding-bottom: 6px;
    border-bottom: 2px solid var(--color-accent);
  }

  .cat-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .cat-tag {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    transition: all 0.2s;
  }

  .cat-tag:hover {
    background: var(--color-primary);
    color: #FFFFFF;
    border-color: var(--color-primary);
  }

  .cta-widget p {
    font-size: 0.84rem;
    color: var(--color-text-muted);
    line-height: 1.45;
    margin-bottom: 14px;
  }

  .side-action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 11px 14px;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    min-height: 44px;
    margin-bottom: 8px;
  }

  .side-action-btn--wa {
    background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
    color: #FFFFFF !important;
  }

  .side-action-btn--call {
    background: var(--color-primary);
    color: #FFFFFF !important;
  }

  .route-links {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .route-links a {
    display: block;
    font-size: 0.84rem;
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
    padding: 6px 0;
    border-bottom: 1px dashed var(--color-border);
    transition: color 0.15s;
  }

  .route-links a:hover {
    color: var(--color-accent-dark);
  }
</style>
