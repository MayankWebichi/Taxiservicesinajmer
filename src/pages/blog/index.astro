---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header/Header.astro";
import Footer from "@/components/Footer/Footer.astro";
import WhatsAppBubble from "@/components/WhatsApp/WhatsAppBubble.astro";
import MobileBottomBar from "@/components/MobileBottomBar/MobileBottomBar.astro";

const pageTitle = "Ajmer Taxi Blog | Travel Tips, Routes & Fare Guides — Taxi Services in Ajmer";
const pageDescription = "Travel tips, taxi fare guides, route information, and Rajasthan travel advice from Taxi Services in Ajmer. 18+ years of local expertise.";

const posts = [
  {
    slug: "/blog/best-taxi-service-ajmer-2026",
    title: "Best Taxi Service in Ajmer 2026 — Complete Guide",
    date: "September 2026",
    category: "Guides",
    excerpt: "Looking for the best cab service in Ajmer? We compare all major taxi operators and explain why local, verified services beat national aggregators for quality and pricing.",
    readTime: "8 min read"
  },
  {
    slug: "/ajmer-to-jaipur-taxi",
    title: "Ajmer to Jaipur Taxi: Everything You Need to Know",
    date: "September 2026",
    category: "Routes",
    excerpt: "The complete 2026 guide to booking a cab from Ajmer to Jaipur. Fares, highway details, best departure times, and what to do in the Pink City.",
    readTime: "6 min read"
  },
  {
    slug: "/dargah-taxi-ajmer",
    title: "Ajmer Sharif Dargah Taxi Guide — Timings, Fare & Tips",
    date: "September 2026",
    category: "Pilgrimage",
    excerpt: "Everything a pilgrim needs to know before visiting Ajmer Sharif — from taxi fares from the railway station to Dargah darshan timings and Urs festival travel tips.",
    readTime: "5 min read"
  },
  {
    slug: "/fare-calculator",
    title: "How Much Does a Taxi Cost from Ajmer? (2026 Fare Guide)",
    date: "September 2026",
    category: "Pricing",
    excerpt: "A complete 2026 fare chart for all major routes from Ajmer — Jaipur, Jodhpur, Udaipur, Delhi, Jaisalmer and more. Use our free fare calculator for instant estimates.",
    readTime: "4 min read"
  },
  {
    slug: "/pushkar-tour-from-ajmer",
    title: "Ajmer to Pushkar: The Complete Travel Guide 2026",
    date: "September 2026",
    category: "Tourism",
    excerpt: "Everything you need for a perfect Ajmer–Pushkar day trip: Brahma Temple, Pushkar Lake ghats, Savitri Temple, the camel fair, and how to get there cheaply.",
    readTime: "7 min read"
  },
  {
    slug: "/ajmer-to-kishangarh-airport-taxi",
    title: "Kishangarh Airport to Ajmer Taxi Guide",
    date: "September 2026",
    category: "Airport",
    excerpt: "Flying into Kishangarh (VIKG)? Here's everything you need — taxi rates to Ajmer, Pushkar and Jaipur, flight schedule, and how to book in advance.",
    readTime: "5 min read"
  }
];

const categories = ["All", "Guides", "Routes", "Pilgrimage", "Pricing", "Tourism", "Airport"];
---

<Layout title={pageTitle} description={pageDescription} canonicalPath="/blog/">
  <Header />
  <main id="main-content">
    <section class="blog-hero">
      <div class="container text-center">
        <span class="blog-pill">Travel Knowledge · Updated 2026</span>
        <h1 class="blog-title">Ajmer Taxi Travel Blog</h1>
        <p class="blog-sub">Route guides, fare comparisons, pilgrimage tips, and local insights from 18+ years of Ajmer taxi expertise.</p>
      </div>
    </section>

    <!-- Breadcrumb -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <div class="container">
        <ol class="breadcrumb-list">
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">›</li>
          <li aria-current="page">Blog</li>
        </ol>
      </div>
    </nav>

    <section class="blog-section">
      <div class="container">
        <div class="blog-layout">
          <div class="posts-area">
            <div class="posts-grid">
              {posts.map((post, i) => (
                <article class={`post-card ${i === 0 ? "post-card--featured" : ""}`}>
                  <div class="post-meta">
                    <span class="post-cat">{post.category}</span>
                    <span class="post-date">{post.date}</span>
                    <span class="post-read">{post.readTime}</span>
                  </div>
                  <h2 class="post-title">
                    <a href={post.slug}>{post.title}</a>
                  </h2>
                  <p class="post-excerpt">{post.excerpt}</p>
                  <a href={post.slug} class="post-read-btn">Read Article →</a>
                </article>
              ))}
            </div>
          </div>

          <aside class="blog-sidebar">
            <div class="sidebar-widget">
              <h3 class="widget-title">Categories</h3>
              <div class="cat-list">
                {categories.map(cat => (
                  <span class="cat-tag">{cat}</span>
                ))}
              </div>
            </div>
            <div class="sidebar-widget">
              <h3 class="widget-title">Quick Booking</h3>
              <p>Ready to book? Call or WhatsApp us for instant cab booking in Ajmer.</p>
              <a href="https://wa.me/917737314538?text=Hello%2C%20I%20want%20to%20book%20a%20cab%20in%20Ajmer." target="_blank" rel="noopener noreferrer" class="btn btn--gold btn--sm full-w">WhatsApp Us</a>
              <a href="tel:+917737314538" class="btn btn--outline-primary btn--sm full-w" style="margin-top:8px">Call +91 77373 14538</a>
            </div>
            <div class="sidebar-widget popular-routes">
              <h3 class="widget-title">Popular Routes</h3>
              <div class="route-links">
                <a href="/ajmer-to-jaipur-taxi">Ajmer → Jaipur ₹1,800</a>
                <a href="/ajmer-to-jodhpur-taxi">Ajmer → Jodhpur ₹2,800</a>
                <a href="/ajmer-to-udaipur-taxi">Ajmer → Udaipur ₹3,500</a>
                <a href="/ajmer-to-delhi-taxi">Ajmer → Delhi ₹5,500</a>
                <a href="/ajmer-to-jaisalmer-taxi">Ajmer → Jaisalmer ₹7,500</a>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppBubble />
  <MobileBottomBar />
</Layout>

<style>
  .blog-hero { background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%); color: #FFF; padding: calc(var(--header-height, 72px) + 38px) 0 36px; border-bottom: 3px solid var(--color-accent); }
  .blog-pill { display: inline-block; background: rgba(197,155,39,0.2); border: 1px solid var(--color-accent); color: var(--color-accent-light); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; padding: 3px 14px; border-radius: var(--radius-full); margin-bottom: var(--space-sm); }
  .blog-title { font-family: var(--font-heading); font-size: clamp(2rem, 4vw, 2.75rem); color: #FFF; margin-bottom: 8px; }
  .blog-sub { font-size: 1.0625rem; color: rgba(255,255,255,0.88); max-width: 560px; margin: 0 auto; }
  .blog-section { padding: var(--space-4xl) 0; background: var(--color-surface); }
  .blog-layout { display: grid; grid-template-columns: 1fr 300px; gap: var(--space-3xl); align-items: start; }
  .posts-grid { display: flex; flex-direction: column; gap: var(--space-lg); }

  .post-card {
    background: #FFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    box-shadow: 0 4px 16px rgba(34,24,28,0.05);
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .post-card:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(34,24,28,0.1); border-color: var(--color-accent); }
  .post-card--featured { border-left: 4px solid var(--color-accent); }
  .post-meta { display: flex; align-items: center; gap: var(--space-sm); margin-bottom: var(--space-sm); flex-wrap: wrap; }
  .post-cat { background: var(--color-primary); color: #FFF; font-size: 0.7rem; font-weight: 800; padding: 2px 10px; border-radius: var(--radius-full); text-transform: uppercase; letter-spacing: 0.06em; }
  .post-date, .post-read { font-size: 0.8rem; color: var(--color-text-muted); }
  .post-title { font-family: var(--font-heading); font-size: 1.25rem; color: var(--color-primary); margin-bottom: var(--space-sm); line-height: 1.3; }
  .post-title a { color: inherit; text-decoration: none; }
  .post-title a:hover { color: var(--color-accent-dark); }
  .post-excerpt { font-size: 0.9375rem; color: var(--color-text-muted); line-height: 1.6; margin-bottom: var(--space-md); }
  .post-read-btn { color: var(--color-primary); font-weight: 700; font-size: 0.875rem; text-decoration: none; }
  .post-read-btn:hover { color: var(--color-accent-dark); }

  /* Sidebar */
  .blog-sidebar { display: flex; flex-direction: column; gap: var(--space-lg); }
  .sidebar-widget { background: #FFF; border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-lg); }
  .widget-title { font-family: var(--font-heading); font-size: 1rem; color: var(--color-primary); margin-bottom: var(--space-md); padding-bottom: 6px; border-bottom: 2px solid var(--color-accent); }
  .cat-list { display: flex; flex-wrap: wrap; gap: 8px; }
  .cat-tag { background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text); font-size: 0.8rem; padding: 4px 12px; border-radius: var(--radius-full); cursor: pointer; transition: all 0.2s; }
  .cat-tag:hover { background: var(--color-primary); color: #FFF; border-color: var(--color-primary); }
  .sidebar-widget p { font-size: 0.8125rem; color: var(--color-text-muted); margin-bottom: var(--space-sm); }
  .full-w { width: 100%; justify-content: center; }
  .route-links { display: flex; flex-direction: column; gap: 8px; }
  .route-links a { display: block; font-size: 0.875rem; color: var(--color-primary); font-weight: 600; text-decoration: none; padding: 6px 0; border-bottom: 1px dashed var(--color-border); transition: color 0.2s; }
  .route-links a:hover { color: var(--color-accent-dark); }

  @media (max-width: 992px) { .blog-layout { grid-template-columns: 1fr; } }
</style>

<style>
  /* Breadcrumb */
  .breadcrumb-nav { background: var(--color-surface); border-bottom: 1px solid var(--color-border); padding: 8px 0; }
  .breadcrumb-list { display: flex; align-items: center; gap: 6px; list-style: none; padding: 0; margin: 0; font-size: 0.8125rem; color: var(--color-text-muted); flex-wrap: wrap; }
  .breadcrumb-list a { color: var(--color-primary); font-weight: 600; text-decoration: none; }
  .breadcrumb-list a:hover { color: var(--color-accent-dark); }
  .breadcrumb-list [aria-current="page"] { color: var(--color-text-muted); }

  /* Mobile flex-scroll posts */
  @media (max-width: 768px) {
    .posts-grid {
      display: flex;
      flex-direction: row;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 16px;
      padding-bottom: 12px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
    }
    .post-card {
      min-width: 80vw;
      flex-shrink: 0;
      scroll-snap-align: start;
    }
    .blog-layout { gap: 24px; }
  }
</style>
