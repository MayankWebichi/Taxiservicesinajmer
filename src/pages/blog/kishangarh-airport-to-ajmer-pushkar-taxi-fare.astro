---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header/Header.astro";
import Footer from "@/components/Footer/Footer.astro";
import WhatsAppBubble from "@/components/WhatsApp/WhatsAppBubble.astro";
import MobileBottomBar from "@/components/MobileBottomBar/MobileBottomBar.astro";
import { business } from "@/data/business";
import { createWhatsAppBookingUrl } from "@/utils/whatsapp";

const pageTitle = "Kishangarh Airport (KQH) to Ajmer & Pushkar Taxi Guide 2026 — Fares & Booking | Taxi Services in Ajmer";
const pageDescription = "Landing at Kishangarh Airport (KQH / VIKG)? 2026 taxi guide: fixed cab rates to Ajmer (₹900) & Pushkar (₹1,400), flight tracking, meet-and-greet & Marble Dumping Yard tours.";

const waAirport = createWhatsAppBookingUrl({ 
  pickup: "Kishangarh Airport (KQH)", 
  tripType: "One Way",
  customMessage: "Hello, I will be landing at Kishangarh Airport and need to book an airport taxi pickup. Please share vehicle availability." 
});

const publishDate = "2026-09-25";
const formattedDate = "September 25, 2026";

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Kishangarh Airport (KQH) to Ajmer & Pushkar Taxi Guide 2026 — Fares & Booking",
  "description": "Essential airport taxi guide for fliers landing at Kishangarh Airport (KQH). Detailed transfer fares to Ajmer Dargah, Pushkar hotels, and visiting the Marble Dumping Yard.",
  "datePublished": publishDate,
  "dateModified": publishDate,
  "author": {
    "@type": "Organization",
    "name": business.name,
    "url": business.website
  },
  "publisher": {
    "@type": "Organization",
    "name": business.name,
    "url": business.website
  }
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/blog/kishangarh-airport-to-ajmer-pushkar-taxi-fare/"
  schemaMarkup={articleSchema}
>
  <Header />
  <main id="main-content">
    <section class="article-hero">
      <div class="container">
        <div class="article-meta">
          <span class="art-cat">Airport Transfer</span>
          <time datetime={publishDate} class="art-date">📅 {formattedDate}</time>
          <span class="art-read">⏱️ 6 min read</span>
        </div>
        <h1 class="article-title">Kishangarh Airport (KQH) to Ajmer &amp; Pushkar Taxi Guide 2026 — Fares &amp; Booking</h1>
        <p class="article-lead">Kishangarh Airport (IATA: KQH, ICAO: VIKG) is the closest commercial airport serving both Ajmer (28 km) and Pushkar (42 km). Here is everything incoming passengers need to know about flight terminal pickups, on-spot taxi shortages, transparent cab rates, and adding a visit to the famous Marble Dumping Yard.</p>
        <div class="art-author">
          <div class="author-avatar">TS</div>
          <div>
            <strong>Taxi Services in Ajmer</strong>
            <span>Official Airport Transfer Operators · Serving Pilgrims &amp; Fliers Since 2008</span>
          </div>
        </div>
